<% const { navItems, brandHref, brandTitle, isActive, isChildActive } = buildProductNavigation(locals); %>


<div id="nav-container">
  <nav class="top-nav" aria-label="Primary">
    <div class="nav-left">
      <a href="<%= brandHref %>" class="nav-brand" title="<%= brandTitle %>" aria-label="<%= brandTitle %>">
        <i class="fas fa-bolt" aria-hidden="true"></i> AgentX
      </a>
      <% if (typeof service === 'string' && service !== 'core') { %>
        <span class="nav-service-tag"><%= service %></span>
      <% } %>
    </div>

    <div class="nav-right">
      <% navItems.forEach(function(item) { %>
        <% if (item.children) { %>
          <%
            var groupActive = isChildActive(item.children);
            var gaCls = groupActive ? ' active' : '';
          %>
          <div class="nav-item">
            <button type="button" class="nav-link<%= gaCls %>" id="nav-trigger-<%= item.id %>" aria-controls="nav-menu-<%= item.id %>" aria-expanded="false">
              <i class="fas <%= item.icon %>" aria-hidden="true"></i> <%= item.label %>
              <i class="fas fa-angle-down" aria-hidden="true" style="font-size:10px;margin-left:4px;opacity:0.5;"></i>
            </button>
            <div class="nav-dropdown" id="nav-menu-<%= item.id %>" aria-labelledby="nav-trigger-<%= item.id %>">
              <% item.children.forEach(function(child) { %>
                <% if (child.section) { %>
                  <div class="nav-dropdown-section"><%= child.section %></div>
                <% } else if (child.action) { %>
                  <button type="button"
                          class="dropdown-item<%= isActive(child.id) ? ' active' : '' %>"
                          data-nav-action="<%= child.action %>">
                    <i class="fas <%= child.icon %>" aria-hidden="true"></i> <%= child.label %>
                  </button>
                <% } else { %>
                  <a href="<%= child.href %>"
                     class="dropdown-item<%= isActive(child.id) ? ' active' : '' %>"
                     <% if (isActive(child.id)) { %>aria-current="page"<% } %>
                     <% if (child.external) { %>target="_blank" rel="noopener"<% } %>
                     <% if (child.owner) { %>data-nav-owner="<%= child.owner %>"<% } %>
                     <% if (child.description) { %>title="<%= child.description %>"<% } %>>
                    <i class="fas <%= child.icon %>" aria-hidden="true"></i> <%= child.label %>
                    <% if (child.owner) { %>
                      <span class="nav-owner-tag"><%= child.owner %></span>
                    <% } %>
                    <% if (child.external) { %>
                      <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;opacity:0.4;margin-left:2px;"></i>
                    <% } %>
                  </a>
                <% } %>
              <% }); %>
            </div>
          </div>
        <% } else { %>
          <%
            var linkCls = 'nav-link'
              + (item.primary ? ' primary' : '')
              + (isActive(item.id) ? ' active' : '');
          %>
          <div class="nav-item">
            <a href="<%= item.href %>" class="<%= linkCls %>" <% if (isActive(item.id)) { %>aria-current="page"<% } %>>
              <i class="fas <%= item.icon %>" aria-hidden="true"></i> <%= item.label %>
            </a>
          </div>
        <% } %>
      <% }); %>
    </div>
  </nav>
</div>

<%- include('shortcuts-modal') %>

<script>
(function() {
  var container = document.getElementById('nav-container');
  var navItems = document.querySelectorAll('#nav-container .nav-item');

  function controls(item) {
    return {
      button: item.querySelector('button.nav-link'),
      menu: item.querySelector('.nav-dropdown')
    };
  }

  function syncContainerState() {
    if (!container) return;
    container.classList.toggle('has-open-menu', !!container.querySelector('.nav-item.open'));
  }

  function setOpen(item, open, focusFirst) {
    var pair = controls(item);
    if (!pair.button || !pair.menu) return;
    item.classList.toggle('open', open);
    pair.button.setAttribute('aria-expanded', open ? 'true' : 'false');
    syncContainerState();
    if (open && focusFirst) {
      var first = pair.menu.querySelector('.dropdown-item:not([disabled])');
      if (first) first.focus();
    }
  }

  function closeAll(except) {
    navItems.forEach(function(item) {
      if (item !== except) setOpen(item, false, false);
    });
    syncContainerState();
  }

  navItems.forEach(function(item) {
    var pair = controls(item);
    var btn = pair.button;
    var menu = pair.menu;
    if (!btn || !menu) return;

    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var willOpen = !item.classList.contains('open');
      closeAll(item);
      setOpen(item, willOpen, false);
    });

    btn.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        closeAll(item);
        setOpen(item, true, true);
      } else if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(item, false, false);
      }
    });

    menu.addEventListener('keydown', function(e) {
      var entries = Array.prototype.slice.call(menu.querySelectorAll('.dropdown-item:not([disabled])'));
      var index = entries.indexOf(document.activeElement);
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(item, false, false);
        btn.focus();
      } else if (e.key === 'ArrowDown' && entries.length) {
        e.preventDefault();
        entries[(index + 1 + entries.length) % entries.length].focus();
      } else if (e.key === 'ArrowUp' && entries.length) {
        e.preventDefault();
        entries[(index - 1 + entries.length) % entries.length].focus();
      } else if (e.key === 'Home' && entries.length) {
        e.preventDefault();
        entries[0].focus();
      } else if (e.key === 'End' && entries.length) {
        e.preventDefault();
        entries[entries.length - 1].focus();
      }
    });

    item.addEventListener('focusout', function() {
      window.setTimeout(function() {
        if (!item.contains(document.activeElement)) setOpen(item, false, false);
      }, 0);
    });
  });

  /* Close dropdowns on outside click */
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.nav-item')) {
      closeAll(null);
    }
  });

  /* ── Action handlers (keyboard shortcuts, etc.) ────────── */
  document.querySelectorAll('#nav-container [data-nav-action]').forEach(function(el) {
    el.addEventListener('click', function() {
      var action = el.dataset.navAction;
      if (action === 'show-shortcuts' && typeof ShortcutsHelpModal !== 'undefined') {
        closeAll(null);
        ShortcutsHelpModal.show();
      }
    });
  });

  /* ── Ctrl+/ opens shortcuts modal ──────────────────────── */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var openItem = container && container.querySelector('.nav-item.open');
      if (openItem) {
        var openButton = openItem.querySelector('button.nav-link');
        setOpen(openItem, false, false);
        if (openButton) openButton.focus();
      }
    }
    if ((e.ctrlKey || e.metaKey) && e.key === '/') {
      e.preventDefault();
      if (typeof ShortcutsHelpModal !== 'undefined') {
        ShortcutsHelpModal.show();
      }
    }
  });
})();
</script>
