                                    <th style="padding: 7px 8px; text-align: right; border-bottom: 1px solid var(--panel-border);">Productive</th>
                                    <th style="padding: 7px 8px; text-align: right; border-bottom: 1px solid var(--panel-border);">Attributed</th>
                                    <th style="padding: 7px 8px; text-align: right; border-bottom: 1px solid var(--panel-border);">Tokens</th>
                                    <th style="padding: 7px 8px; text-align: right; border-bottom: 1px solid var(--panel-border);">Cost</th>
                                    <th style="padding: 7px 8px; text-align: right; border-bottom: 1px solid var(--panel-border);">Rework</th>
                                </tr>
