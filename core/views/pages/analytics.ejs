                        </div>

                        <!-- Providers bucket -->
                        <div style="border: 1px solid var(--panel-border); border-radius: 8px; padding: 14px; background: rgba(238, 176, 255, 0.04);">
                            <h3 style="margin: 0 0 10px 0; font-size: 14px; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 8px;">
                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #eeb0ff;"></span>
                                Cloud inference (routed by AgentX)
                                <span style="font-size: 11px; color: var(--muted); font-weight: 400;">source: <code>agentx-cloud</code></span>
                            </h3>
                            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 12px;">
                                <div><div style="font-size: 11px; color: var(--muted);">Calls</div><div id="fedMcSessions" style="font-size: 18px; font-weight: 600; color: var(--text);">—</div></div>
                                <div><div style="font-size: 11px; color: var(--muted);">Total Tokens</div><div id="fedMcTokens" style="font-size: 18px; font-weight: 600; color: var(--text);">—</div></div>
                                <div><div style="font-size: 11px; color: var(--muted);">Spend (est.)</div><div id="fedMcSpend" style="font-size: 18px; font-weight: 600; color: var(--text);">—</div></div>
                                <div><div style="font-size: 11px; color: var(--muted);">As of</div><div id="fedMcAsOf" style="font-size: 12px; color: var(--muted);">—</div></div>
                            </div>
                            <div style="overflow-x: auto;">
                                <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                                    <thead style="background: rgba(0,0,0,0.2);">
                                        <tr>
                                            <th style="padding: 6px 8px; text-align: left; border-bottom: 1px solid var(--panel-border);">Model</th>
                                            <th style="padding: 6px 8px; text-align: left; border-bottom: 1px solid var(--panel-border);">Provider</th>
                                            <th style="padding: 6px 8px; text-align: right; border-bottom: 1px solid var(--panel-border);">Sessions</th>
                                            <th style="padding: 6px 8px; text-align: right; border-bottom: 1px solid var(--panel-border);">Tokens</th>
                                            <th style="padding: 6px 8px; text-align: right; border-bottom: 1px solid var(--panel-border);">Cost</th>
                                        </tr>
                                    </thead>
                                    <tbody id="fedMcTableBody">
                                        <tr><td colspan="5" style="padding: 12px; text-align: center; color: var(--muted);">Loading…</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div style="margin-top: 10px; font-size: 11px; color: var(--muted);">
                        <i class="fas fa-info-circle"></i>
                        Agent X records only calls routed through its own inference path. Use the provider's billing console for plans, balances, and complete upstream usage.
                    </div>
                </div>
            </div>
        </div>

        <script>
        // Federated view loader (task 0166).
        // Inline to avoid touching the esbuild pipeline; the rest of the
        // page loads a module bundle, but this section is self-contained.
        (function(){
            if (document.body.dataset.agentxProfile === 'demo') {
                const section = document.getElementById('federatedSection');
                if (section) {
                    section.hidden = true;
                    section.inert = true;
                    section.setAttribute('aria-hidden', 'true');
                }
                return;
            }
            function fmtNum(n){ if(n==null) return '—'; return Number(n).toLocaleString(); }
            function fmtUsdOrUnpriced(v){ return Number.isFinite(v) ? fmtUsd(v) : 'unpriced'; }
                function fmtUsd(n){ if(n==null) return '—'; return '$' + Number(n).toFixed(4); }
            async function loadFederated(){
                const win = document.getElementById('federatedWindowSelect').value;
                let payload;
                try {
                    const r = await fetch('/api/analytics/federated?window=' + encodeURIComponent(win));
                    payload = await r.json();
                } catch(err){
                    console.error('Federated fetch failed', err);
                    return;
                }
                const banner = document.getElementById('federatedMcBanner');
                if (payload.provider_status !== 'ok') { banner.style.display = 'block'; }
                else { banner.style.display = 'none'; }

                // Local
                const local = payload.local || { totals: {}, byModel: [] };
                const lt = local.totals || {};
                document.getElementById('fedLocalConvs').textContent = fmtNum(lt.calls);
                document.getElementById('fedLocalMsgs').textContent = fmtNum(lt.models);
                document.getElementById('fedLocalTokens').textContent = fmtNum(lt.totalTokens);
                // Local compute, not currency - owned hardware has no per-token price.
                document.getElementById('fedLocalCost').textContent = (lt.inferenceHours || 0).toFixed(1) + 'h';
                const lbody = document.getElementById('fedLocalTableBody');
                if (Array.isArray(local.byModel) && local.byModel.length){
                    lbody.innerHTML = local.byModel.slice(0, 20).map(function(r){
                        return '<tr>' +
                            '<td style="padding:6px 8px;border-bottom:1px solid var(--panel-border);">' + (r.model||'—') + '</td>' +
                            '<td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--panel-border);">' + fmtNum(r.calls) + '</td>' +
                            '<td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--panel-border);">' + fmtNum(r.totalTokens) + '</td>' +
                            '<td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--panel-border);">' + ((r.inferenceSeconds || 0) / 3600).toFixed(2) + 'h</td>' +
                            '</tr>';
                    }).join('');
                } else {
                    lbody.innerHTML = '<tr><td colspan="4" style="padding:12px;text-align:center;color:var(--muted);">No local inference in this window.</td></tr>';
                }

                // Providers routed through AgentX
                const provider = payload.providers;
                const mbody = document.getElementById('fedMcTableBody');
                if (provider && provider.totals){
                    document.getElementById('fedMcSessions').textContent = fmtNum(provider.totals.sessions);
                    document.getElementById('fedMcTokens').textContent = fmtNum(provider.totals.totalTokens);
                    document.getElementById('fedMcSpend').textContent = fmtUsdOrUnpriced(provider.estimatedSpendUsd);
                    document.getElementById('fedMcAsOf').textContent = provider.asOfMs ? new Date(provider.asOfMs).toLocaleString() : '—';
                    if (Array.isArray(provider.byModel) && provider.byModel.length){
                        mbody.innerHTML = provider.byModel.slice(0, 20).map(function(r){
                            return '<tr>' +
                                '<td style="padding:6px 8px;border-bottom:1px solid var(--panel-border);">' + (r.model||'—') + '</td>' +
                                '<td style="padding:6px 8px;border-bottom:1px solid var(--panel-border);">' + (r.provider||'—') + '</td>' +
                                '<td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--panel-border);">' + fmtNum(r.sessions) + '</td>' +
                                '<td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--panel-border);">' + fmtNum(r.totalTokens) + '</td>' +
                                '<td style="padding:6px 8px;text-align:right;border-bottom:1px solid var(--panel-border);">' + fmtUsdOrUnpriced(r.estimatedSpendUsd) + '</td>' +
                                '</tr>';
                        }).join('');
                    } else {
                        mbody.innerHTML = '<tr><td colspan="5" style="padding:12px;text-align:center;color:var(--muted);">No provider rows in this window.</td></tr>';
                    }
                } else {
                    document.getElementById('fedMcSessions').textContent = '—';
                    document.getElementById('fedMcTokens').textContent = '—';
                    document.getElementById('fedMcSpend').textContent = '—';
                    document.getElementById('fedMcAsOf').textContent = '—';
                    mbody.innerHTML = '<tr><td colspan="5" style="padding:12px;text-align:center;color:var(--muted);">Provider telemetry unavailable.</td></tr>';
                }
            }
            document.getElementById('federatedRefreshBtn').addEventListener('click', loadFederated);
            document.getElementById('federatedWindowSelect').addEventListener('change', loadFederated);
            // Kick off on load.
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', loadFederated);
            } else {
                loadFederated();
            }
        })();
        </script>

        <!-- System Metrics Section moved to top -->
          </div>
        </details>
    </div>
