  <div class="bg-grid"></div>
  <main class="page history-hidden" id="main-content">
    <aside class="sidebar">
      <div class="sidebar-head">
        <h2>History</h2>
        <div class="sidebar-actions">
          <button id="newChatBtn" class="icon-btn" title="New Chat" aria-label="Start new chat">+</button>
          <button id="closeHistoryBtn" class="icon-btn" title="Hide history" aria-label="Hide conversation history">&times;</button>
        </div>
      </div>

      <!-- Search Bar -->
      <div class="search-bar-container">
        <div class="search-input-wrapper">
          <i class="fas fa-search search-icon"></i>
          <input type="text" id="conversationSearchInput" class="search-input" placeholder="Search conversations..." autocomplete="off" aria-label="Search conversations">
          <button id="clearSearchBtn" class="clear-search-btn" title="Clear search" aria-label="Clear search" style="display: none;">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <button id="toggleFiltersBtn" class="icon-btn filter-btn" title="Show filters" aria-label="Toggle history filters">
          <i class="fas fa-filter"></i>
        </button>
      </div>

      <!-- Filter Panel (collapsible) -->
      <div id="filterPanel" class="filter-panel" style="display: none;">
        <div class="filter-section">
          <label class="filter-label">Date Range</label>
          <input type="date" id="filterDateFrom" class="filter-input" placeholder="From">
          <input type="date" id="filterDateTo" class="filter-input" placeholder="To">
        </div>

        <details class="filter-advanced">
          <summary style="cursor:pointer;font-size:0.8rem;color:var(--muted);margin-bottom:8px;">More filters</summary>
          <div class="filter-section">
            <label class="filter-label">Model</label>
            <select id="filterModel" class="filter-select" multiple size="3">
              <option value="">All Models</option>
            </select>
          </div>

          <div class="filter-section">
            <label class="filter-label">
              <input type="checkbox" id="filterRagOnly" class="filter-checkbox">
              <span>RAG Only</span>
            </label>
          </div>

          <div class="filter-section">
            <label class="filter-label">Feedback</label>
            <select id="filterFeedback" class="filter-select">
              <option value="">All Feedback</option>
              <option value="1">Positive</option>
              <option value="-1">Negative</option>
              <option value="0">Neutral</option>
            </select>
          </div>

          <div class="filter-section">
            <label class="filter-label">Tags</label>
            <div class="tags-input-container">
              <input type="text" id="filterTagsInput" class="filter-input" placeholder="Add tag and press Enter">
              <div id="filterTagsChips" class="tags-chips"></div>
            </div>
            <div id="tagsSuggestions" class="tags-suggestions" style="display: none;"></div>
          </div>

          <div class="filter-section">
            <label class="filter-label">Sort By</label>
            <select id="filterSortBy" class="filter-select">
              <option value="relevance">Relevance</option>
              <option value="date_desc">Newest First</option>
              <option value="date_asc">Oldest First</option>
              <option value="model">Model</option>
              <option value="feedback">Feedback</option>
              <option value="messages">Message Count</option>
            </select>
          </div>
        </details>

        <div class="filter-actions">
          <button id="applyFiltersBtn" class="primary small full">Apply</button>
          <button id="clearFiltersBtn" class="ghost small full">Clear All</button>
        </div>
      </div>

      <!-- History List -->
      <div id="historyList" class="history-list"></div>

      <!-- Pagination Controls -->
      <div id="paginationControls" class="pagination-controls" style="display: none;">
        <button id="prevPageBtn" class="pagination-btn" disabled>
          <i class="fas fa-chevron-left"></i>
        </button>
        <span id="paginationInfo" class="pagination-info">Page 1 of 1</span>
        <button id="nextPageBtn" class="pagination-btn" disabled>
          <i class="fas fa-chevron-right"></i>
        </button>
      </div>
    </aside>

    <div class="main-content chat-page-content" style="padding: 0;">
      <% const fullPlayground = locals.agentxProfile !== 'demo'; %>
      <details class="chat-routing-lab" <%= fullPlayground ? 'open' : '' %>>
        <summary>
          <span><i class="fas fa-route" aria-hidden="true"></i> Routing cockpit</span>
          <small>Intent, host fleet, route evidence, and manual controls</small>
        </summary>
        <div class="chat-routing-lab__surface">
      <section class="playground-cockpit" id="playgroundCockpit" data-state="loading" aria-labelledby="playgroundCockpitTitle">
        <div class="pg-cockpit-ambient" aria-hidden="true"></div>
        <header class="pg-cockpit-hero">
          <div class="pg-cockpit-copy">
            <div class="pg-cockpit-eyebrow">
              <span class="pg-live-dot" id="pgLiveDot"></span>
              Conversational control plane
            </div>
            <div class="pg-cockpit-title-row">
              <div>
                <h2 id="playgroundCockpitTitle">Talk with your models</h2>
                <p>Choose the intent, see the route, inspect the fleet, then keep the conversation in one place.</p>
              </div>
              <button class="pg-icon-button" id="pgToggleCockpit" type="button" aria-expanded="true" title="Collapse cockpit">
                <i class="fas fa-chevron-up"></i><span class="sr-only">Collapse cockpit</span>
              </button>
            </div>
            <div class="pg-cockpit-actions">
              <button class="pg-action primary" id="pgFocusComposer" type="button"><i class="fas fa-message"></i> Start talking</button>
              <button class="pg-action" id="pgOpenConfiguration" type="button" data-cockpit-tip-title="Advanced route controls" data-cockpit-tip="Choose the system prompt, RAG, streaming, thinking, and web-search behavior. Routing authority stays in Core."><i class="fas fa-sliders"></i> Route controls</button>
              <button class="pg-action subtle" id="pgRefreshCockpit" type="button" data-cockpit-tip-title="Refresh evidence" data-cockpit-tip="Re-read product health, routing posture, and fleet inventory without sending a model request."><i class="fas fa-rotate"></i> Refresh evidence</button>
              <button class="cockpit-help-button" type="button" data-cockpit-guide-open="playgroundGuide"><i class="fas fa-circle-question"></i><span>Page guide</span></button>
            </div>
          </div>
          <aside class="pg-cockpit-posture" aria-label="Product posture">
            <div class="pg-posture-label"><i class="fas fa-satellite-dish"></i> Product posture</div>
            <strong id="pgServiceSummary">Checking the ecosystem…</strong>
            <span id="pgFleetSummary">Core · Benchmark · RAG</span>
            <time id="pgCockpitUpdated"></time>
          </aside>
        </header>

        <div class="pg-cockpit-body" id="pgCockpitBody">
          <section class="pg-cockpit-panel pg-route-panel" aria-labelledby="pgRouteTitle">
            <div class="pg-panel-head">
              <div><span class="pg-kicker">Live workflow</span><h2 id="pgRouteTitle">How this answer will run <button class="cockpit-help-dot" type="button" data-cockpit-tip-title="Planned route" data-cockpit-tip="This flow shows the current routing intent. After a reply, the compact receipt below the cockpit records the host, model, and route that actually ran." aria-label="Explain the planned route"><i class="fas fa-question"></i></button></h2></div>
              <span class="pg-state-pill" id="pgRouteState" data-tone="loading">Resolving</span>
            </div>
            <div class="pg-mode-switch" aria-label="Conversation routing mode">
              <button type="button" data-playground-mode="quick" data-cockpit-tip-title="Quick" data-cockpit-tip="Prefer the fastest eligible route for short, lightweight work."><i class="fas fa-bolt"></i><span>Quick</span></button>
              <button type="button" data-playground-mode="standard" data-cockpit-tip-title="Standard" data-cockpit-tip="Use the normal server-owned route for everyday conversation."><i class="fas fa-route"></i><span>Standard</span></button>
              <button type="button" data-playground-mode="deep" data-cockpit-tip-title="Deep" data-cockpit-tip="Prefer the deep-reasoning lane for harder analysis; the server still selects the eligible host and model."><i class="fas fa-brain"></i><span>Deep</span></button>
              <button type="button" data-playground-mode="manual" data-cockpit-tip-title="Manual" data-cockpit-tip="Unlock explicit host and exact-model selection for inspection or controlled experiments."><i class="fas fa-crosshairs"></i><span>Manual</span></button>
            </div>
            <div class="pg-route-flow" aria-label="Current inference workflow">
              <div class="pg-route-node" tabindex="0" data-cockpit-tip-title="Request intent" data-cockpit-tip="The selected conversation mode translated into a routing intent."><i class="fas fa-message"></i><span>Request</span><strong id="pgRouteIntent">Standard chat</strong></div>
              <i class="fas fa-arrow-right pg-route-arrow" aria-hidden="true"></i>
              <div class="pg-route-node router" tabindex="0" data-cockpit-tip-title="Core decision" data-cockpit-tip="Core applies the active routing policy. Playground displays that decision; it does not maintain a second router."><i class="fas fa-code-branch"></i><span>Decision</span><strong id="pgRouteDecision">Core router</strong></div>
              <i class="fas fa-arrow-right pg-route-arrow" aria-hidden="true"></i>
              <div class="pg-route-node" tabindex="0" data-cockpit-tip-title="Inference host" data-cockpit-tip="Routed modes resolve the host on the server. Manual mode uses the explicit host selected in the fleet panel."><i class="fas fa-server"></i><span>Host</span><strong id="pgRouteHost">Server-routed</strong></div>
              <i class="fas fa-arrow-right pg-route-arrow" aria-hidden="true"></i>
              <div class="pg-route-node model" tabindex="0" data-cockpit-tip-title="Effective model" data-cockpit-tip="Routed modes reveal the exact model after the first reply. Manual mode shows the model currently selected in configuration."><i class="fas fa-microchip"></i><span>Model</span><strong id="pgRouteModel">On first reply</strong></div>
            </div>
          </section>

          <section class="pg-cockpit-panel pg-fleet-panel" aria-labelledby="pgFleetTitle">
            <div class="pg-panel-head">
              <div><span class="pg-kicker">Ollama fleet</span><h2 id="pgFleetTitle">Pick a host when Manual is active <button class="cockpit-help-dot" type="button" data-cockpit-tip-title="Fleet cards" data-cockpit-tip="Cards are live inventory evidence. They become selectable only in Manual mode; routed modes remain server-owned." aria-label="Explain fleet cards"><i class="fas fa-question"></i></button></h2></div>
              <% if (fullPlayground) { %>
                <a href="/nerve-center">Full topology <i class="fas fa-arrow-right"></i></a>
              <% } else { %>
                <a href="/models">Model details <i class="fas fa-arrow-right"></i></a>
              <% } %>
            </div>
            <div class="pg-host-deck" id="pgHostDeck" aria-live="polite">
              <div class="pg-loading"><i class="fas fa-spinner fa-spin"></i> Reading configured hosts…</div>
            </div>
          </section>

        </div>
      </section>
        </div>
      </details>

      <%- include('../partials/cockpit-guide', {
        cockpitGuide: {
          id: 'playgroundGuide',
          title: 'Talk, route, and verify without leaving the conversation',
          summary: 'Playground is the conversational cockpit. It selects intent through existing chat controls, displays the planned path, and then preserves the actual route receipt below.',
          sections: [
            { title: 'Choose the intent', body: 'Quick, Standard, and Deep ask Core to route. Manual unlocks an explicit host and exact model for controlled work.' },
            { title: 'Read the workflow', body: 'Request → Decision → Host → Model separates your intent from the server decision and the effective runtime.' },
            { title: 'Configure only when needed', body: 'Route controls hold prompt, RAG, streaming, thinking, and web-search settings. The cockpit reuses them instead of owning duplicates.' },
            { title: 'Verify the receipt', body: 'After the answer, the compact bar and message badge record the model, host, route, timing, tokens, and feedback evidence.' }
          ],
          note: { title: 'One routing authority', body: 'Playground reads bounded product APIs and drives the canonical chat controls. It never invents a fallback host, model, health store, or parallel router.' },
          links: (fullPlayground ? [
            { href: '/nerve-center', icon: 'fa-brain', label: 'Nerve Center', detail: 'Hosts, models, and routing' },
            { href: '/models', icon: 'fa-cubes', label: 'Models', detail: 'Registry and exact pins' },
            { href: '/agent-ops', icon: 'fa-users-gear', label: 'Agent Ops', detail: 'People, cadence, and work' },
            { href: '/pipeline', icon: 'fa-list-check', label: 'Pipeline', detail: 'Coding delivery queue' }
          ] : [
            { href: '/models', icon: 'fa-cubes', label: 'Models', detail: 'Registry and exact pins' }
          ])
        }
      }) %>

      <header class="chat-command-bar" aria-label="Conversation status and controls">
        <div class="chat-command-status">
          <span class="chat-command-status__icon" aria-hidden="true"><i class="fas fa-circle-notch"></i></span>
          <span class="chat-command-status__copy">
            <strong class="status-chip" id="statusChip" data-tone="muted" aria-live="polite">Getting ready</strong>
            <small id="chatStatusHelp">Agent X is checking the configured route.</small>
          </span>
        </div>

        <div class="chat-command-mode" aria-label="Current response strategy">
          <span>Response</span>
          <strong id="simpleModeLabel">Balanced</strong>
          <small id="simpleModeAutomation">Automatic</small>
        </div>

        <div class="chat-command-actions">
          <button id="toggleHistoryBtn" class="chat-command-secondary" type="button" title="Show conversation history" aria-label="Show conversation history">
            <i class="fas fa-clock-rotate-left" aria-hidden="true"></i><span>Conversations</span>
          </button>
          <button id="toggleConfigBtn" class="take-controls-button" type="button" aria-label="Open precision controls" aria-expanded="false" aria-controls="configDrawer">
            <i class="fas fa-sliders" aria-hidden="true"></i><span>Take the controls</span>
          </button>
        </div>

        <div class="chat-expert-strip" id="chatExpertStrip" aria-hidden="true" inert>
          <span class="chat-expert-strip__label"><i class="fas fa-compass" aria-hidden="true"></i> Instruments</span>
          <span class="header-model-badge" id="headerModelBadge"></span>
          <span class="header-agent-name" id="headerAgentName" style="display:none;"></span>
          <span class="header-agent-avatar" id="headerAgentAvatar" style="display:none;"></span>
          <span class="ci-inline-field"><span class="ci-health-dot"></span><span class="ci-status-label">Host</span><strong class="ci-status-value" data-ci-field="host">Not observed</strong></span>
          <span class="ci-inline-field"><span class="ci-status-label">Route</span><strong class="ci-status-value" data-ci-field="route">Not observed</strong></span>
          <span class="ci-inline-field"><span class="ci-status-label">VRAM</span><strong class="ci-status-value" data-ci-field="vram">Not observed</strong></span>
          <select id="headerPersonaSelect" class="header-persona-dropdown" style="display: none;">
            <option value="default_chat">Default</option>
          </select>
          <button class="icon-btn" id="headerDevToggle" title="Show precision controls" aria-label="Show precision controls"><i class="fas fa-flask" aria-hidden="true"></i></button>
          <button class="ghost small" id="headerChangeBtn" title="Change agent" style="display:none;">Change</button>
          <span class="chat-expert-strip__spacer"></span>
          <div class="header-pill" id="conversationTokens" style="display: none;">
            <span class="label">Context</span><strong id="tokenCount">0</strong><span aria-hidden="true">/</span><span id="tokenLimit" title="Context window set by the session model on the server.">Auto</span>
          </div>
          <div class="header-pill" id="conversationCost" style="display: none;">
            <span class="label">Cost</span><strong id="costAmount">$0.00</strong>
          </div>
          <button id="headerThinkingBtn" class="icon-btn header-toggle-btn" title="Force thinking mode; unchecked uses automatic policy" aria-pressed="false">
            <i class="fas fa-lightbulb" aria-hidden="true"></i><span class="header-toggle-label">Thinking</span>
          </button>
          <button id="headerWebSearchBtn" class="icon-btn header-toggle-btn" title="Enable web search before responding" aria-pressed="false">
            <i class="fas fa-globe" aria-hidden="true"></i><span class="header-toggle-label">Web</span>
          </button>
          <span class="header-pill"><span class="label">Messages</span><strong id="statMessages">0</strong></span>
          <button id="ciToggleBtn" class="icon-btn" title="Open routing intelligence" aria-label="Open routing intelligence"><i class="fas fa-brain" aria-hidden="true"></i></button>
          <button id="showChatTutorialBtn" class="icon-btn" title="Open page guide" aria-label="Open page guide"><i class="fas fa-circle-question" aria-hidden="true"></i></button>
        </div>
      </header>

      <section class="chat-layout">

        <!-- Agent Selector (collapsible panel) -->
        <div class="agent-selector" id="agentSelector">
          <!-- Collapsed bar -->
          <button class="agent-selector-bar" id="agentSelectorBar" type="button" aria-expanded="false" aria-controls="agentSelectorPanel">
            <span class="agent-selector-bar-left">
              <i class="fas fa-layer-group" style="color: var(--accent, #7c3aed); margin-right: 8px;"></i>
              <span class="agent-selector-label" id="selectorLabel">Quick Chat</span>
            </span>
            <span class="agent-selector-bar-right">
              <span class="agent-selector-count" id="selectorCount"></span>
              <i class="fas fa-chevron-down agent-selector-chevron" id="selectorChevron"></i>
            </span>
          </button>

          <!-- Expanded panel (slides open) -->
          <div class="agent-selector-panel" id="agentSelectorPanel" inert>

            <!-- Chat Agents -->
            <div class="launcher-section" id="launcherChat">
              <div class="launcher-section-label">
                <i class="fas fa-comments"></i> Chat
              </div>
              <div class="agentx-launcher-grid" id="chatLauncherGrid">
                <button class="agentx-card launcher-default-card selected" id="startChatCard" type="button" aria-pressed="true">
                  <span class="agentx-card-avatar" style="--avatar-color: #7c3aed">
                    <i class="fas fa-comments"></i>
                  </span>
                  <span class="agentx-card-content">
                    <span class="agentx-card-header">
                      <span class="agentx-card-name">Quick Chat</span>
                    </span>
                    <span class="agentx-card-description">Start with the configured route; manual recovery stays explicit.</span>
                  </span>
                  <span class="agentx-card-actions">
                    <span class="agentx-select-btn selected" aria-hidden="true"><i class="fas fa-check"></i></span>
                  </span>
                </button>
              </div>
            </div>

            <!-- Tools -->
            <div class="launcher-section" id="launcherTools">
              <div class="launcher-section-label">
                <i class="fas fa-toolbox"></i> Tools
              </div>
              <div class="agentx-launcher-grid" id="toolsLauncherGrid"></div>
            </div>
          </div>
        </div>

        <!-- Chat Window (fills remaining height) -->
        <div class="chat-window" id="chatWindow" role="region" aria-label="Conversation transcript" tabindex="0">
          <section class="chat-welcome" aria-labelledby="chat-welcome-title">
            <span class="chat-welcome__icon" aria-hidden="true"><i class="fas fa-message"></i></span>
            <p class="chat-welcome__eyebrow">Quick chat</p>
            <h1 id="chat-welcome-title">Ask Agent X anything.</h1>
            <p>Start typing when the configured route is ready. If it needs attention, Agent X will name an installed model you can choose.</p>
            <div class="chat-welcome__starters" aria-label="Conversation starters">
              <button type="button" data-chat-starter="Summarize this topic for me: ">Summarize a topic</button>
              <button type="button" data-chat-starter="Help me brainstorm: ">Brainstorm</button>
              <button type="button" data-chat-starter="Explain this clearly: ">Explain something</button>
            </div>
            <small><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i> Balanced uses the configured Standard route. You can take control at any time.</small>
          </section>
        </div>
        <p class="chat-announcements" id="chatAnnouncements" role="status" aria-live="polite" aria-atomic="true"></p>

        <section class="chat-route-recovery" id="chatRouteRecovery" aria-labelledby="chatRouteRecoveryTitle" hidden>
          <span class="chat-route-recovery__icon" aria-hidden="true"><i class="fas fa-route"></i></span>
          <div class="chat-route-recovery__copy">
            <strong id="chatRouteRecoveryTitle">Configured route unavailable</strong>
            <p id="chatRouteRecoveryStatus" role="status" aria-live="polite" aria-atomic="true">Checking installed models.</p>
          </div>
          <button class="chat-route-recovery__action" id="chatRouteRecoveryAction" type="button" aria-describedby="chatRouteRecoveryStatus">Review manual controls</button>
        </section>

        <!-- Composer -->
        <div class="composer">
          <label class="chat-announcements" for="messageInput">Message Agent X</label>
          <textarea id="messageInput" rows="1" placeholder="Ask Agent X anything…" aria-describedby="chatStatusHelp"></textarea>
          <div class="composer-actions">
            <select class="quick-select" id="quickActionSelect" title="Quick prompts" aria-label="Choose a conversation starter">
              <option value="" disabled selected>Try a prompt...</option>
              <option value="What can you help me with?">Help</option>
              <option value="Summarize recent events.">Summary</option>
              <option value="List available tools.">Tools</option>
              <option value="Brainstorm next steps for my project.">Brainstorm</option>
            </select>
            <button class="icon-btn" id="roundtableBtn" title="Ask Council (multi-model deliberation)" aria-label="Ask Council"><i class="fas fa-users"></i></button>
            <span class="char-count" id="charCount"></span>
            <div class="flex-spacer"></div>
            <button class="ghost small" id="clearBtn">Clear</button>
            <button class="primary" id="sendBtn" disabled title="Checking chat readiness">Send</button>
          </div>
        </div>

        <!-- Thread ID (hidden, used by JS) -->
        <span id="threadId" style="display:none;"></span>
      </section>
    </div>
  </main>

  <!-- Config Drawer (slides from right) -->
  <div class="config-drawer-backdrop" id="configDrawerBackdrop" aria-hidden="true"></div>
  <div class="config-drawer" id="configDrawer" role="dialog" aria-hidden="true" aria-labelledby="configDrawerTitle" tabindex="-1" inert>
    <div class="config-drawer-header">
      <div>
        <span class="config-drawer-eyebrow"><i class="fas fa-sliders" aria-hidden="true"></i> Expert depth</span>
        <h2 id="configDrawerTitle">Take the controls</h2>
        <p>Shape this conversation without leaving it.</p>
      </div>
      <button class="icon-btn" id="configDrawerClose" type="button" title="Close controls" aria-label="Close controls">&times;</button>
    </div>
    <div class="config-drawer-body">

      <!-- Quick Access -->
      <div style="display:flex;gap:8px;margin-bottom:14px;">
        <button class="ghost small" id="profileBtn" type="button" aria-haspopup="dialog" aria-controls="profileModal" aria-expanded="false" style="flex:1;">
          <i class="fas fa-user" aria-hidden="true" style="margin-right:5px;"></i>Profile
        </button>
        <button class="ghost small" id="showShortcutsBtn" type="button" aria-haspopup="dialog" aria-controls="keyboardShortcutsDialog" aria-expanded="false" style="flex:1;" title="Keyboard Shortcuts (Ctrl+/)">
          <i class="fas fa-keyboard" aria-hidden="true" style="margin-right:5px;"></i>Shortcuts
        </button>
      </div>

      <!-- Config Summary -->
      <div class="config-summary" id="configSummary" style="margin-bottom:16px;">
        <div class="summary-items" id="defaultConfigSummary">
          <span class="summary-item"><strong>Model:</strong> <span id="summaryModel">&mdash;</span></span>
          <span class="summary-item"><strong>RAG:</strong> <span id="summaryRag">Off</span></span>
          <span class="summary-item"><strong>Stream:</strong> <span id="summaryStream">On</span></span>
          <span class="summary-item"><strong>Web:</strong> <span id="summaryWeb">Off</span></span>
          <span class="summary-item"><strong>Think:</strong> <span id="summaryThink">Auto</span></span>
          <span class="summary-item"><strong>Temp:</strong> <span id="summaryTemp">0.7</span></span>
        </div>
        <div class="summary-items" id="agentConfigSummary" style="display: none;">
          <span class="summary-item"><i class="fas fa-robot"></i> <strong id="summaryAgentName">Agent</strong></span>
          <span class="summary-item"><i class="fas fa-tools"></i> <span id="summaryAgentTools">0</span> Tools</span>
        </div>
      </div>

      <!-- Active Prompt Pill -->
      <div style="margin-bottom:12px;display:flex;align-items:center;gap:8px;">
        <span class="header-pill"><span class="label">Prompt</span> <strong id="activePromptName" style="font-size:11px;">&mdash;</strong></span>
        <span class="header-pill"><span class="label">Config</span> <strong id="chatConfigSummary" style="font-size:11px;">&mdash;</strong></span>
      </div>

      <!-- Agent Active Panel -->
      <div class="agent-active-panel" id="agentActivePanel" style="display: none;">
        <div class="agent-card-mini">
          <div class="agent-avatar-mini" id="activeAgentAvatar"><i class="fas fa-robot"></i></div>
          <div class="agent-info-mini">
            <h3 id="activeAgentName">Agent Name</h3>
            <p id="activeAgentRole">General Assistant</p>
          </div>
          <button class="icon-btn small" id="changeAgentBtn" title="Change Agent" aria-label="Change active agent"><i class="fas fa-exchange-alt"></i></button>
        </div>
        <div class="agent-capabilities-list">
           <div class="capability-tag" id="activeAgentModel"><i class="fas fa-microchip"></i> <span>Model</span></div>
           <div class="capability-tag" id="activeAgentTools"><i class="fas fa-wrench"></i> <span>0 Tools</span></div>
        </div>
        <hr class="panel-divider">
      </div>

      <div class="field">
        <label for="routingModeSelect">Response strategy</label>
        <select id="routingModeSelect" aria-describedby="routingModeHint">
          <option value="quick">Fast — prioritize speed</option>
          <option value="standard">Balanced — recommended</option>
          <option value="deep">Deep reasoning — prioritize depth</option>
          <option value="manual">Manual control — choose host and model</option>
        </select>
        <div class="hint" id="routingModeHint">Standard classifies each turn; Quick and Deep use fixed lanes.</div>
      </div>

      <div class="field">
        <label for="hostInput">Ollama host</label>
        <div class="input-row">
          <select id="hostInput" style="flex: 1;" aria-describedby="hostInputHint">
            <option value="">Loading hosts&hellip;</option>
          </select>
        </div>
        <div class="hint" id="hostInputHint">Hosts are loaded from server configuration.</div>
      </div>

      <div class="field">
        <label for="modelSelect">Model</label>
        <div class="input-row">
          <select id="modelSelect" style="flex: 1;" aria-describedby="modelSelectHint">
            <option value="">Load available models&hellip;</option>
          </select>
          <button class="icon-btn" id="refreshModels" title="Refresh models from Ollama" aria-label="Refresh available models">&orarr;</button>
        </div>
        <div class="hint" id="modelSelectHint">Models are loaded from the selected host and sorted by benchmark readiness.</div>
      </div>

      <div class="field">
        <label for="promptSelect">System prompt</label>
        <div class="input-row">
          <select id="promptSelect" style="flex: 1;" aria-describedby="promptSelectHint">
            <option value="default_chat">Loading prompts&hellip;</option>
          </select>
          <button class="icon-btn" id="promptInfoBtn" title="View prompt details" aria-label="View prompt details">&oplus;</button>
        </div>
        <div class="hint" id="promptSelectHint">Choose which system prompt to use for AI behavior.</div>
      </div>

      <div class="note" id="feedback">Waiting for configuration.</div>

      <div class="field inline-toggle">
        <span id="streamToggleLabel">Streaming</span>
        <label class="switch">
          <input type="checkbox" id="streamToggle" checked aria-labelledby="streamToggleLabel" aria-describedby="streamToggleHint">
          <span class="slider" aria-hidden="true"></span>
        </label>
        <div class="hint" id="streamToggleHint">Stream responses in real-time.</div>
      </div>

      <div class="field inline-toggle">
        <span id="ragToggleLabel">Enable RAG</span>
        <label class="switch">
          <input type="checkbox" id="ragToggle" checked aria-labelledby="ragToggleLabel" aria-describedby="ragToggleHint">
          <span class="slider" aria-hidden="true"></span>
        </label>
        <div class="hint" id="ragToggleHint">Retrieve context from vector store.</div>
      </div>

      <div class="field inline-toggle">
        <span id="thinkingToggleLabel">Thinking mode</span>
        <label class="switch">
          <input type="checkbox" id="thinkingToggle" aria-labelledby="thinkingToggleLabel" aria-describedby="thinkingToggleHint">
          <span class="slider" aria-hidden="true"></span>
        </label>
        <div class="hint" id="thinkingToggleHint">Unchecked uses automatic lane policy; checked forces think: true.</div>
      </div>

      <div class="field inline-toggle">
        <span id="webSearchToggleLabel">Web search</span>
        <label class="switch">
          <input type="checkbox" id="webSearchToggle" aria-labelledby="webSearchToggleLabel" aria-describedby="webSearchToggleHint">
          <span class="slider" aria-hidden="true"></span>
        </label>
        <div class="hint" id="webSearchToggleHint">Search the web via SearXNG before responding.</div>
      </div>

      <!-- RAG Advanced Options Panel -->
      <div class="rag-options-panel" id="ragOptionsPanel" style="display: none;">
        <button class="rag-panel-header" id="ragPanelHeader" type="button" aria-expanded="false" aria-controls="ragOptionsContent">
          <span><i class="fas fa-sliders-h" style="margin-right: 8px;"></i>RAG Advanced Options</span>
          <i class="fas fa-chevron-down" id="ragChevron"></i>
        </button>
        <div class="rag-panel-content" id="ragOptionsContent" style="display: none;" hidden inert>
          <div class="rag-option-row">
            <label class="rag-toggle-label">
              <input type="checkbox" id="ragExpandQuery">
              <span><i class="fas fa-expand-arrows-alt" style="margin-right: 6px; font-size: 11px;"></i>Query Expansion</span>
            </label>
            <p class="rag-option-help">Generates related search queries via LLM <span style="color: var(--accent);">+300ms</span></p>
          </div>
          <div class="rag-option-row">
            <label class="rag-toggle-label">
              <input type="checkbox" id="ragHybridSearch">
              <span><i class="fas fa-layer-group" style="margin-right: 6px; font-size: 11px;"></i>Hybrid Search</span>
            </label>
            <p class="rag-option-help">Semantic + keyword matching <span style="color: var(--accent);">+75ms</span></p>
          </div>
          <div class="rag-option-row">
            <label class="rag-toggle-label">
              <input type="checkbox" id="ragRerankResults">
              <span><i class="fas fa-sort-amount-down" style="margin-right: 6px; font-size: 11px;"></i>Re-ranking</span>
            </label>
            <p class="rag-option-help">LLM judges relevance <span style="color: var(--accent-2);">+1000ms</span></p>
          </div>
          <div class="rag-option-row">
            <label class="rag-toggle-label">
              <input type="checkbox" id="ragCompress">
              <span><i class="fas fa-compress-alt" style="margin-right: 6px; font-size: 11px;"></i>Contextual Compression</span>
            </label>
            <p class="rag-option-help">Extracts relevant sentences <span style="color: var(--accent);">+500ms</span></p>
          </div>
          <div class="rag-option-row">
            <label class="rag-slider-label">
              <span><i class="fas fa-list-ol" style="margin-right: 6px; font-size: 11px;"></i>Top K Results: <span id="ragTopKValue">5</span></span>
              <input type="range" id="ragTopK" min="1" max="20" value="5">
            </label>
            <p class="rag-option-help">Number of document chunks (1-20)</p>
          </div>
        </div>
      </div>

      <div class="field inline-toggle">
        <span id="statsToggleLabel">Show message stats</span>
        <label class="switch">
          <input type="checkbox" id="statsToggle" checked aria-labelledby="statsToggleLabel" aria-describedby="statsToggleHint">
          <span class="slider" aria-hidden="true"></span>
        </label>
        <div class="hint" id="statsToggleHint">Display token usage and timing for each message.</div>
      </div>

      <div class="field">
        <label for="systemPrompt">System prompt override</label>
        <textarea id="systemPrompt" rows="3">You are AgentX, a concise and capable local assistant. Keep answers brief and actionable.</textarea>
      </div>

      <div class="collapsible-section">
        <button class="section-header" id="tuningHeader" type="button" aria-expanded="false" aria-controls="tuningContent">
          <span class="tuning-section-title">Model Tuning Parameters <span class="panel-toggle-icon">&#x25bc;</span></span>
        </button>
        <div class="section-content hidden" id="tuningContent" hidden inert>
          <div class="options-grid">
            <div class="field">
              <label for="temperature">Temperature</label>
              <input type="range" id="temperature" min="0" max="2" step="0.05" value="0.7">
              <div class="value" data-for="temperature">0.7</div>
            </div>
            <div class="field">
              <label for="topP">Top P</label>
              <input type="range" id="topP" min="0" max="1" step="0.01" value="0.9">
              <div class="value" data-for="topP">0.9</div>
            </div>
            <div class="field">
              <label for="topK">Top K</label>
              <input type="number" id="topK" value="64" min="1" max="32000">
            </div>
            <div class="field">
              <label for="numCtx">Context (tokens)</label>
              <input type="number" id="numCtx" value="" min="256" max="32000" step="256" placeholder="Modelfile default">
              <div class="hint">Blank uses the model's Modelfile or registry context. Set a value only for an explicit override.</div>
            </div>
            <div class="field">
              <label for="repeatPenalty">Repeat penalty</label>
              <input type="number" id="repeatPenalty" value="1.05" min="0" max="2" step="0.01">
            </div>
            <div class="field">
              <label for="presencePenalty">Presence penalty</label>
              <input type="number" id="presencePenalty" value="0" min="-2" max="2" step="0.01">
            </div>
            <div class="field">
              <label for="frequencyPenalty">Frequency penalty</label>
              <input type="number" id="frequencyPenalty" value="0" min="-2" max="2" step="0.01">
            </div>
            <div class="field">
              <label for="numPredict">Num predict</label>
              <input type="number" id="numPredict" value="" min="-1" max="8192" step="16" placeholder="Blank or -1 = unlimited">
              <div class="hint">Leave blank for uncapped responses. Use a number only if you want to limit output.</div>
            </div>
            <div class="field">
              <label for="seed">Seed</label>
              <input type="number" id="seed" value="" placeholder="random">
            </div>
            <div class="field">
              <label for="stopSequences">Stop sequences</label>
              <input type="text" id="stopSequences" placeholder="e.g. ###,END">
            </div>
            <div class="field">
              <label for="keepAlive">Keep alive</label>
              <input type="text" id="keepAlive" placeholder="e.g. 30s or -1">
              <div class="hint">Keep the model warm between calls.</div>
            </div>
          </div>
          <div class="action-row">
            <button class="primary full" id="saveDefaults">Save defaults</button>
          </div>
        </div>
      </div>

    </div><!-- End config-drawer-body -->
  </div><!-- End config-drawer -->

  <!-- Context progress (hidden elements for JS references) -->
  <div style="display:none;">
    <span id="contextPercentage">0%</span>
    <div id="contextProgressFill" style="width: 0%"></div>
  </div>

  <!-- Profile Modal -->
  <div id="profileModal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="profileModalTitle" aria-describedby="profileModalDescription profilePersistenceNote" aria-hidden="true" tabindex="-1" inert>
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="profileModalTitle">User Profile &amp; Memory</h2>
        <button id="closeProfileBtn" class="close-btn" type="button" aria-label="Close user profile">&times;</button>
      </div>
      <div class="modal-body">
        <p class="hint" id="profileModalDescription">Personalize what Agent X remembers and how it should respond.</p>
        <div class="field">
          <label for="userAbout">About You (Memory)</label>
          <div class="hint" id="userAboutHint">Facts the agent should remember about you (e.g., job, interests, background).</div>
          <textarea id="userAbout" rows="5" aria-describedby="userAboutHint" placeholder="I am a software engineer interested in AI..."></textarea>
        </div>
        <div class="field">
          <label for="memoryLanguage">Preferred Language</label>
          <input type="text" id="memoryLanguage" placeholder="English">
        </div>
        <div class="field">
          <label for="memoryRole">Role / Context</label>
          <input type="text" id="memoryRole" placeholder="e.g. Product manager focusing on UX">
        </div>
        <div class="field">
          <label for="memoryStyle">Response Style</label>
          <textarea id="memoryStyle" rows="2" placeholder="Concise, decisive, include next steps."></textarea>
        </div>
        <div class="field">
          <label for="userInstructions">Custom Instructions</label>
          <div class="hint" id="userInstructionsHint">How the agent should behave (e.g., always be concise).</div>
          <textarea id="userInstructions" rows="3" aria-describedby="userInstructionsHint" placeholder="Be brief and professional."></textarea>
        </div>
        <div class="hint" id="profilePersistenceNote">All profile data is saved to your AgentX database and persisted across conversations.</div>
        <div class="action-row">
          <button class="ghost" id="resetProfileBtn" type="button">Reset</button>
          <button class="primary" id="saveProfileBtn" type="button">Save Profile</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Wire the chat-header shortcuts button (also available via nav icon + Ctrl+/)
      const shortcutsBtn = document.getElementById('showShortcutsBtn');
      if (shortcutsBtn) {
        shortcutsBtn.addEventListener('click', () => {
          if (typeof ShortcutsHelpModal !== 'undefined') ShortcutsHelpModal.show();
        });
      }

      const tutorialBtn = document.getElementById('showChatTutorialBtn');
      if (tutorialBtn) tutorialBtn.style.display = 'none';
    });
  </script>
