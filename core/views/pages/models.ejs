    <main class="container-fluid">
        <!-- Stats Strip -->
        <div class="stats-row">
            <div class="stat-card clickable" id="statTotalCard">
                <div class="icon-box blue"><i class="fas fa-cubes"></i></div>
                <div class="stat-info">
                    <h3>Total Models</h3>
                    <div class="number" id="statTotal">--</div>
                    <div class="sub-text" id="statTotalSub"></div>
                </div>
            </div>
            <div class="stat-card clickable" id="statStorageCard">
                <div class="icon-box purple"><i class="fas fa-hdd"></i></div>
                <div class="stat-info">
                    <h3>Storage</h3>
                    <div class="number" id="statStorage">--</div>
                    <div class="sub-text" id="statStorageSub"></div>
                </div>
            </div>
            <div class="stat-card clickable" id="statHostsCard">
                <div class="icon-box orange"><i class="fas fa-server"></i></div>
                <div class="stat-info">
                    <h3>Hosts</h3>
                    <div class="number" id="statHosts">--</div>
                    <div class="sub-text" id="statHostsSub"></div>
                </div>
            </div>
            <div class="stat-card clickable" id="statBenchmarkedCard">
                <div class="icon-box cyan"><i class="fas fa-flask-vial"></i></div>
                <div class="stat-info">
                    <h3>Benchmarked</h3>
                    <div class="number" id="statBenchmarked">--</div>
                    <div class="sub-text" id="statAvgScore">--</div>
                </div>
            </div>
        </div>

        <!-- Category Pill Strip -->
        <div class="category-strip" id="categoryStrip">
            <button class="cat-pill active" data-cat="all"><i class="fas fa-border-all"></i> All</button>
            <button class="cat-pill" data-cat="coding"><i class="fas fa-code"></i> Coding</button>
            <button class="cat-pill" data-cat="reasoning"><i class="fas fa-brain"></i> Reasoning</button>
            <button class="cat-pill" data-cat="generalist"><i class="fas fa-cubes"></i> Generalist</button>
            <button class="cat-pill" data-cat="specialist"><i class="fas fa-star"></i> Specialist</button>
            <button class="cat-pill" data-cat="ops"><i class="fas fa-bolt"></i> Ops</button>
            <button class="cat-pill" data-cat="embedding"><i class="fas fa-vector-square"></i> Embedding</button>
            <button class="cat-pill" data-cat="judge"><i class="fas fa-gavel"></i> Judge</button>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar glass-panel">
            <div class="filter-search-row">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Search models, tags, vendors...">
                </div>
                <div class="filter-actions">
                    <button id="syncRegistryBtn" class="btn-secondary" title="Sync models from all Ollama hosts">
                        <i class="fas fa-sync-alt"></i> Sync
                    </button>
                    <button id="openAddSourceBtn" class="btn-primary" title="Add model source">
                        <i class="fas fa-plus"></i> Add Source
                    </button>
                </div>
            </div>
            <div class="filters">
                <select id="providerSelect" class="select-input">
                    <option value="all">All Providers</option>
                    <option value="ollama">Ollama</option>
                    <option value="custom">Custom</option>
                </select>
                <select id="hostSelect" class="select-input">
                    <option value="all">All Hosts</option>
                </select>
                <select id="statusSelect" class="select-input">
                    <option value="available">Available</option>
                    <option value="all">All (incl. gone)</option>
                    <option value="gone">Gone only</option>
                </select>
                <select id="sortSelect" class="select-input">
                    <option value="name">Name (A-Z)</option>
                    <option value="score">Benchmark Score</option>
                    <option value="size">Size (Largest)</option>
                    <option value="speed">Speed (tok/s)</option>
                    <option value="newest">Newest</option>
                </select>
            </div>
        </div>

        <!-- Tag Cloud -->
        <div class="tag-cloud" id="tagCloud"></div>

        <!-- Selection Workspace -->
        <section id="compareDrawer" class="comparison-workspace glass-panel" hidden>
            <div class="drawer-header">
                <div>
                    <h3>Selected Models <span class="badge" id="compareCount">0</span></h3>
                    <p class="drawer-subtitle" id="compareSubtitle">Select one model for details or 2-4 to compare automatically.</p>
                </div>
                <button class="btn-text text-sm" id="clearCompare">Clear All</button>
            </div>
            <div class="drawer-body">
                <div class="compare-chip-list" id="compareList"></div>
            </div>
            <div id="compareContent" class="compare-content"></div>
        </section>

        <!-- Models Table -->
        <div class="models-table-container glass-panel">
            <table class="models-table" id="modelsTable">
                <thead>
                    <tr>
                        <th width="28%" class="sortable" data-sort="name">Model <i class="fas fa-sort sort-icon"></i></th>
                        <th class="sortable" data-sort="host">Host <i class="fas fa-sort sort-icon"></i></th>
                        <th class="sortable" data-sort="params">Params <i class="fas fa-sort sort-icon"></i></th>
                        <th class="sortable" data-sort="context">Context <i class="fas fa-sort sort-icon"></i></th>
                        <th>Categories</th>
                        <th class="sortable" data-sort="score">Score <i class="fas fa-sort sort-icon"></i></th>
                        <th class="sortable" data-sort="speed">Speed <i class="fas fa-sort sort-icon"></i></th>
                        <th>Capabilities</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="modelsTableBody"></tbody>
            </table>
            <div id="loadingIndicator" class="loading-spinner">Loading models...</div>
        </div>
    </main>

    <!-- Detail Drawer Backdrop -->
    <div id="detailDrawerBackdrop" class="detail-drawer-backdrop"></div>

    <!-- Model Detail Drawer -->
    <div id="modelDetailDrawer" class="detail-drawer">
        <div class="detail-drawer-content">
            <div class="detail-drawer-header">
                <h2 id="detailModelName">Model</h2>
                <button id="closeDetailDrawer" class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <div id="detailDrawerBody" class="detail-drawer-body"></div>
        </div>
    </div>

    <!-- Stat Popout Drawer (reused for all stat cards) -->
    <div id="statPopoutBackdrop" class="detail-drawer-backdrop"></div>
    <div id="statPopoutDrawer" class="detail-drawer stat-popout-drawer">
        <div class="detail-drawer-content">
            <div class="detail-drawer-header">
                <h2 id="statPopoutTitle">Details</h2>
                <button id="closeStatPopout" class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <div id="statPopoutBody" class="detail-drawer-body"></div>
        </div>
    </div>

    <!-- Add Source Modal -->
    <div id="addSourceModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Add Model Source</h2>
                <button class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <div class="tab-nav">
                <button class="tab-btn active" data-tab="tab-pull">Pull from Ollama</button>
                <button class="tab-btn" data-tab="tab-custom">Custom Model</button>
            </div>
            <div class="modal-body">
                <div id="tab-pull" class="tab-pane active">
                    <div class="form-group">
                        <label>Target Host</label>
                        <select id="pullModelHost" class="form-input">
                            <option value="">Loading configured hosts...</option>
                        </select>
                        <p class="helper-text">Pulls are always sent to the selected configured Ollama host.</p>
                    </div>
                    <div class="form-group">
                        <label>Model Name (e.g. llama3:8b)</label>
                        <div class="input-row">
                            <input type="text" id="pullModelName" class="form-input" placeholder="library/model:tag">
                            <button id="btnPull" class="btn-primary">Pull</button>
                        </div>
                        <p class="helper-text">Check <a href="https://ollama.com/library" target="_blank" class="text-accent">ollama.com/library</a> for available models.</p>
                    </div>
                    <div id="pullProgress" class="hidden">
                        <div class="progress-bar"><div class="progress-fill" style="width: 0%"></div></div>
                        <p class="status-text">Starting...</p>
                    </div>
                </div>
                <div id="tab-custom" class="tab-pane">
                    <p>Register a custom model definition or remote API.</p>
                    <form id="customForm">
                        <div class="form-group">
                            <label>Display Name</label>
                            <input type="text" name="displayName" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label>Base Model ID</label>
                            <input type="text" name="baseModel" class="form-input" required placeholder="gpt-4-turbo">
                        </div>
                        <button type="submit" class="btn-primary">Register</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Comparison Modal -->
    <div id="comparisonModal" class="modal-overlay">
        <div class="modal-content full-screen-modal">
            <div class="modal-header">
                <h2>Model Comparison</h2>
                <div class="actions">
                    <button class="btn-secondary-sm"><i class="fas fa-file-pdf"></i> Export PDF</button>
                    <button class="close-modal"><i class="fas fa-times"></i></button>
                </div>
            </div>
            <div class="modal-body p-0">
                <div id="comparisonContainer" class="comparison-grid"></div>
            </div>
        </div>
    </div>

    <!-- Execution Config Modal -->
    <div id="execConfigModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 500px;">
            <div class="modal-header">
                <h2 id="execConfigTitle">Execution Config</h2>
                <button id="closeExecConfigModal" class="close-modal"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body" id="execConfigBody">
                <div class="form-group">
                    <label>Context Window (num_ctx)</label>
                    <div id="execConfigCtxDefault" class="text-sm" style="color:var(--muted); margin-bottom:4px;"></div>
                    <input type="number" id="execConfigNumCtx" class="form-input" min="512" step="1024" placeholder="e.g. 262144">
                </div>
                <div class="form-group">
                    <label>Temperature</label>
                    <div id="execConfigTempDefault" class="text-sm" style="color:var(--muted); margin-bottom:4px;"></div>
                    <input type="number" id="execConfigTemperature" class="form-input" min="0" max="2" step="0.1" placeholder="e.g. 0.7">
                </div>
                <div id="execConfigContextTest" style="display:none;"></div>
                <div id="execConfigReason" class="text-sm" style="color:var(--muted); margin-top:8px; padding:8px; background:rgba(255,255,255,0.03); border-radius:6px;"></div>
                <div style="display:flex; gap:8px; margin-top:16px;">
                    <button id="execConfigSave" class="btn-primary" style="flex:1;">Save Override</button>
                    <button id="execConfigReset" class="btn-secondary" style="flex:1;">Reset to Auto</button>
                </div>
            </div>
        </div>
    </div>
