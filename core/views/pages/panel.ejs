<main class="panel-shell" id="housePanelRoot" data-device-id="surface-pro-3-main-house">
  <section class="panel-topbar" aria-label="Panel status">
    <div class="panel-clock">
      <div class="panel-time" id="panelTime">--:--</div>
      <div class="panel-date" id="panelDate">Loading date</div>
    </div>
    <div class="panel-status-strip" id="panelStatusStrip">
      <span class="panel-dot panel-dot-muted" id="panelSystemDot"></span>
      <span id="panelSystemSummary">Checking AgentX</span>
    </div>
    <div class="panel-actions">
      <details class="panel-diagnostics" id="panelDiagnostics">
        <summary class="panel-icon-btn" title="Diagnostics" aria-label="Ouvrir les diagnostics">
          <i class="fa-solid fa-sliders" aria-hidden="true"></i>
        </summary>
        <div class="panel-diagnostics-drawer">
          <div class="panel-diagnostics-head">
            <div>
              <span class="panel-kicker">Opérateur</span>
              <h2>Diagnostics</h2>
            </div>
            <span id="panelUpdated">--</span>
          </div>
          <div class="panel-diagnostics-grid">
            <section aria-label="Services">
              <div class="panel-section-head"><h3>Systèmes</h3></div>
              <div class="panel-service-grid" id="panelServices"></div>
            </section>
            <section aria-label="Maison">
              <div class="panel-section-head">
                <h3>Maison</h3>
                <span id="panelHomeStatus">--</span>
              </div>
              <div class="panel-home-grid" id="panelHomeEntities"></div>
            </section>
          </div>
          <div class="panel-detail-list" id="panelDetailList"></div>
          <nav class="panel-diagnostics-links" aria-label="Liens opérateur">
            <a href="/nerve-center"><i class="fa-solid fa-wave-square" aria-hidden="true"></i>Nerve Center</a>
            <a href="/voice"><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i>Voix</a>
            <a href="/data-toolbox#live-data"><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i>Données</a>
            <a href="/voice-personas"><i class="fa-solid fa-headset" aria-hidden="true"></i>Personas</a>
            <a href="/playground"><i class="fa-solid fa-comments" aria-hidden="true"></i>Chat</a>
          </nav>
        </div>
      </details>
      <button class="panel-icon-btn" id="panelRefreshBtn" type="button" title="Refresh" aria-label="Refresh panel">
        <i class="fa-solid fa-rotate" aria-hidden="true"></i>
      </button>
    </div>
  </section>

  <section class="panel-grid" aria-label="House panel">
    <section class="panel-voice-zone" aria-label="Nestor">
      <div class="panel-face-wrap" aria-hidden="true">
        <div class="panel-face">
          <div class="panel-face-eyes"><span></span><span></span></div>
          <div class="panel-face-mouth"></div>
        </div>
      </div>
      <div class="panel-voice-copy">
        <div class="panel-kicker">Majordome de la maison</div>
        <h1>Nestor</h1>
        <p id="panelVoiceLine">Prêt.</p>
      </div>
      <div class="panel-ptt-row">
        <button class="panel-talk-btn" id="panelTalkBtn" type="button" aria-pressed="false" disabled>
          <i class="fa-solid fa-microphone" aria-hidden="true"></i>
          <span id="panelTalkLabel">Parler</span>
        </button>
        <button class="panel-secondary-btn" id="panelMicToggle" type="button" aria-pressed="true">
          <i class="fa-solid fa-microphone" aria-hidden="true"></i>
          <span id="panelMicToggleLabel">Micro actif</span>
        </button>
        <button class="panel-secondary-btn" id="panelSpeakToggle" type="button" aria-pressed="true">
          <i class="fa-solid fa-volume-high" aria-hidden="true"></i>
          <span id="panelSpeakLabel">Son actif</span>
        </button>
      </div>
      <div class="panel-voice-readiness" id="panelVoiceReadiness" role="status" aria-live="polite">
        <span class="panel-dot panel-dot-muted" id="panelMicDot"></span>
        <span id="panelMicStatus">Vérification du micro…</span>
      </div>
      <div class="panel-transcript" id="panelTranscript" aria-live="polite">
        <div class="panel-message panel-message-system">Session Nestor prête.</div>
      </div>
      <audio id="panelAudio" preload="none" hidden></audio>
    </section>

    <aside class="panel-rail" aria-label="Raccourcis et alertes">
      <nav class="panel-primary-actions" aria-label="Raccourcis famille">
        <a href="/lecture" class="panel-primary-tile panel-primary-lecture">
          <i class="fa-solid fa-book-open-reader" aria-hidden="true"></i>
          <span>Lecture</span>
          <small>Demander un mot à Nestor</small>
        </a>
        <a href="/lecture/parents" class="panel-primary-tile panel-primary-journal">
          <i class="fa-solid fa-clipboard-list" aria-hidden="true"></i>
          <span>Journal</span>
          <small>Voir les demandes de lecture</small>
        </a>
      </nav>
      <section class="panel-personal" aria-label="Tâches personnelles">
        <div class="panel-section-head">
          <div>
            <span class="panel-kicker">Secrétaire</span>
            <h2>Ma liste</h2>
          </div>
          <span id="panelPersonalCount">--</span>
        </div>
        <div class="panel-personal-list" id="panelPersonalTasks" aria-live="polite">
          <div class="panel-personal-empty">Chargement de la liste.</div>
        </div>
        <p class="panel-personal-hint">Dis à Nestor « ajoute… à ma liste » pour noter quelque chose.</p>
      </section>
      <section class="panel-alerts" aria-label="Alertes actionnables">
        <div class="panel-section-head">
          <div>
            <span class="panel-kicker">Maintenant</span>
            <h2>À surveiller</h2>
          </div>
          <span id="panelDeviceStatus">--</span>
        </div>
        <div class="panel-alert-list" id="panelAlerts" aria-live="polite">
          <div class="panel-alert panel-alert-neutral">Vérification de l’état courant.</div>
        </div>
      </section>
    </aside>
  </section>
</main>
