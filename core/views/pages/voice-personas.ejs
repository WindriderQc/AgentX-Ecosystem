<main id="voicePersonaRoot" class="voice-personas-page" data-default-pack="personal_operator">
  <header class="vp-header">
    <div>
      <div class="eyebrow">CORE ASSISTANT</div>
      <h1><i class="fas fa-headset"></i> Voice Personas</h1>
    </div>
    <div class="vp-status-row" aria-live="polite">
      <span id="vpPackStatus" class="vp-pill">Loading packs</span>
      <span id="vpVoixStatus" class="vp-pill vp-pill-muted">VoiX unchecked</span>
      <span id="vpSessionStatus" class="vp-pill vp-pill-muted">No session</span>
    </div>
  </header>

  <section class="vp-toolbar" aria-label="Persona session controls">
    <label>
      <span>Persona</span>
      <select id="vpPackSelect"></select>
    </label>
    <label>
      <span>Mode</span>
      <select id="vpModeSelect"></select>
    </label>
    <label>
      <span>Scope</span>
      <input id="vpScopeInput" type="text" value="personal" autocomplete="off" spellcheck="false">
    </label>
    <button id="vpNewSessionBtn" class="vp-button vp-button-primary" type="button" title="Start session">
      <i class="fas fa-plus"></i>
      <span>Session</span>
    </button>
  </section>

  <div class="vp-shell">
    <section class="vp-panel vp-chat-panel" aria-label="Assistant transcript">
      <div id="vpTranscript" class="vp-transcript" aria-live="polite">
        <div class="vp-empty">Select a persona and start a session.</div>
      </div>

      <form id="vpTextForm" class="vp-composer">
        <textarea id="vpTextInput" rows="2" placeholder="Type a turn..." maxlength="4000"></textarea>
        <div class="vp-composer-actions">
          <button id="vpRecordBtn" class="vp-icon-button" type="button" title="Push to talk" aria-label="Push to talk">
            <i class="fas fa-microphone"></i>
          </button>
          <button id="vpSpeakToggle" class="vp-icon-button" type="button" title="Read replies" aria-pressed="false" aria-label="Read replies">
            <i class="fas fa-volume-high"></i>
          </button>
          <button class="vp-button vp-button-primary" type="submit">
            <i class="fas fa-paper-plane"></i>
            <span>Send</span>
          </button>
        </div>
      </form>
    </section>

    <aside class="vp-panel vp-side-panel" aria-label="Persona details">
      <section class="vp-side-section">
        <h2>Pack</h2>
        <div id="vpPackDetails" class="vp-detail-grid"></div>
      </section>

      <section class="vp-side-section">
        <h2>Memory</h2>
        <form id="vpMemoryForm" class="vp-memory-form">
          <textarea id="vpMemoryInput" rows="3" placeholder="Save scoped fact..." maxlength="4000"></textarea>
          <div class="vp-inline-actions">
            <input id="vpMemoryTopic" type="text" placeholder="topic" value="general" spellcheck="false">
            <button class="vp-button" type="submit">
              <i class="fas fa-brain"></i>
              <span>Save</span>
            </button>
          </div>
        </form>
        <form id="vpMemorySearchForm" class="vp-memory-form">
          <div class="vp-inline-actions">
            <input id="vpMemorySearchInput" type="text" placeholder="search memory" spellcheck="false">
            <button class="vp-button" type="submit">
              <i class="fas fa-search"></i>
              <span>Find</span>
            </button>
          </div>
        </form>
        <div id="vpMemoryStatus" class="vp-mini-status"></div>
        <div id="vpMemoryFacts" class="vp-memory-facts"></div>
      </section>

      <section class="vp-side-section">
        <h2>Audit</h2>
        <div id="vpAuditList" class="vp-audit-list"></div>
      </section>

      <section class="vp-side-section">
        <h2>Safety</h2>
        <div id="vpAlertList" class="vp-alert-list"></div>
      </section>

      <section class="vp-side-section">
        <h2>Trace</h2>
        <div id="vpTraceBox" class="vp-trace-box"></div>
      </section>
    </aside>
  </div>
</main>
