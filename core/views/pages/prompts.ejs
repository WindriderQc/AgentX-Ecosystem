  <div class="bg-grid" aria-hidden="true"></div>

  <main class="prompts-page" id="main-content">
    <header class="prompts-header">
      <div>
        <div class="eyebrow">AgentX • Configuration</div>
        <h1>
          <i class="fas fa-users" aria-hidden="true"></i>
          <span class="title-separator" aria-hidden="true"></span>
          Persona Library
        </h1>
        <p class="lede">Inspect and version the product prompts Agent X can use. Runtime configuration stays unchanged until you explicitly save a new version.</p>
        <p class="prompt-evidence" id="promptEvidenceStatus" aria-live="polite">Connecting to <code>/api/prompts</code>…</p>
      </div>
      <div class="header-controls">
        <button id="exportPromptsBtn" class="ghost btn-sm" type="button" disabled>
          <i class="fas fa-download" aria-hidden="true"></i> Export JSON
        </button>
        <button id="createPromptBtn" class="btn-primary" type="button" disabled aria-describedby="promptEvidenceStatus">
          <i class="fas fa-plus" aria-hidden="true"></i> Create Prompt
        </button>
      </div>
    </header>

    <section class="stats-row" aria-label="Prompt library summary">
      <div class="stat-card">
        <div class="label">Prompt Assets</div>
        <div class="value" id="totalPrompts">—</div>
        <div class="sub">Distinct prompt names</div>
      </div>
      <div class="stat-card">
        <div class="label">Active A/B Tests</div>
        <div class="value" id="activeTests">—</div>
        <div class="sub">Names with multiple active versions</div>
      </div>
      <div class="stat-card">
        <div class="label">Positive Feedback</div>
        <div class="value" id="avgPositiveRate">—</div>
        <div class="sub">Across recorded feedback only</div>
      </div>
      <div class="stat-card">
        <div class="label">Total Impressions</div>
        <div class="value" id="totalImpressions">—</div>
        <div class="sub">Across every stored version</div>
      </div>
    </section>

    <section class="toolbar" aria-label="Filter prompt library">
      <div class="search-box">
        <i class="fas fa-search" aria-hidden="true"></i>
        <label class="sr-only" for="searchInput">Search prompts</label>
        <input type="search" id="searchInput" placeholder="Search names, descriptions, and prompt text" autocomplete="off">
      </div>
      <div class="filter-controls">
        <label class="sr-only" for="statusFilter">Filter by status</label>
        <select id="statusFilter">
          <option value="all">All status</option>
          <option value="active">Active only</option>
          <option value="inactive">Inactive only</option>
        </select>
        <label class="sr-only" for="sortBy">Sort prompts</label>
        <select id="sortBy">
          <option value="name">Sort by name</option>
          <option value="version">Sort by newest version</option>
          <option value="impressions">Sort by usage</option>
          <option value="positiveRate">Sort by feedback</option>
        </select>
      </div>
    </section>

    <section id="promptListContainer" class="prompt-list-container" aria-live="polite" hidden></section>

    <section id="emptyState" class="empty-state" hidden>
      <i class="fas fa-code" aria-hidden="true"></i>
      <h2>No prompt assets yet</h2>
      <p>The prompt service is healthy, but its library is empty. Create the first version without changing any external adapter.</p>
      <button id="emptyCreateBtn" class="btn-primary" type="button" disabled>
        <i class="fas fa-plus" aria-hidden="true"></i> Create First Prompt
      </button>
    </section>

    <section id="loadingState" class="loading-state" role="status">
      <div class="spinner" aria-hidden="true"></div>
      <p>Loading prompt evidence…</p>
    </section>

    <section id="errorState" class="prompt-error-state" role="alert" hidden>
      <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
      <h2>Prompt library unavailable</h2>
      <p id="errorStateMessage">Agent X could not load prompt evidence.</p>
      <p class="field-note">No runtime configuration was changed.</p>
      <button id="retryPromptsBtn" class="btn-primary" type="button">
        <i class="fas fa-rotate-right" aria-hidden="true"></i> Retry
      </button>
    </section>
  </main>

  <div id="promptEditorModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="promptEditorTitle" aria-describedby="promptEditorContext" tabindex="-1" hidden>
    <div class="modal-container prompt-editor-modal">
      <form id="promptEditorForm" novalidate>
        <div class="modal-header">
          <div>
            <h2 id="promptEditorTitle"><i class="fas fa-pen" aria-hidden="true"></i> Create prompt</h2>
            <p id="promptEditorContext" class="modal-subtitle">Create version 1. It starts inactive unless you choose otherwise.</p>
          </div>
          <button id="promptEditorCloseBtn" class="modal-close" type="button" aria-label="Close prompt editor">×</button>
        </div>

        <div class="modal-body">
          <div id="promptEditorError" class="editor-error" role="alert" hidden></div>

          <div class="form-row">
            <div class="form-group">
              <label for="promptNameInput">Prompt name <span class="required" aria-hidden="true">*</span></label>
              <input id="promptNameInput" name="name" type="text" required maxlength="120" autocomplete="off" aria-describedby="promptNameHelp">
              <div class="field-note" id="promptNameHelp">Use a stable product identifier, for example <code>default_chat</code>.</div>
            </div>
            <div class="form-group">
              <label for="promptDescriptionInput">Description</label>
              <input id="promptDescriptionInput" name="description" type="text" maxlength="500" autocomplete="off">
            </div>
          </div>

          <div class="form-group">
            <label for="systemPromptInput">System prompt <span class="required" aria-hidden="true">*</span></label>
            <div class="editor-toolbar" aria-hidden="true">
              <span>Built-in text editor</span>
              <div class="editor-stats">
                <span id="editorCharacterCount">0 characters</span>
                <span id="editorLineCount">1 line</span>
              </div>
            </div>
            <textarea id="systemPromptInput" name="systemPrompt" class="prompt-textarea" rows="18" required spellcheck="true" aria-describedby="systemPromptHelp"></textarea>
            <div class="field-note" id="systemPromptHelp">This local textarea always works; the page does not require Monaco or a CDN.</div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="checkbox-label" for="promptActiveInput">
                <input id="promptActiveInput" name="isActive" type="checkbox">
                <span>Make this version active</span>
              </label>
              <div class="field-note">Leave off to review the new version without changing runtime selection.</div>
            </div>
            <div class="form-group">
              <label for="promptTrafficWeightInput">Traffic weight</label>
              <input id="promptTrafficWeightInput" name="trafficWeight" type="number" min="0" max="100" step="1" value="100">
              <div class="field-note">Used only when this version participates in active selection.</div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button id="promptEditorCancelBtn" class="btn-secondary" type="button">Cancel</button>
          <button id="promptEditorSaveBtn" class="btn-primary" type="submit">
            <i class="fas fa-code-branch" aria-hidden="true"></i>
            <span>Save new version</span>
          </button>
        </div>
      </form>
    </div>
  </div>
