  .ns-stat-value.success { color: #22c55e; }
  .ns-stat-value.danger { color: #ef4444; }
  .ns-stat-label { font-size: 12px; color: var(--muted); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
  .ns-table-wrap { background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; overflow: hidden; }
  .ns-table-header { padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--panel-border); }
  .ns-table-header h2 { font-size: 16px; font-weight: 600; color: #fff; margin: 0; display: flex; align-items: center; gap: 8px; }
  .ns-table-header h2 i { color: #7cf0ff; }
  .ns-filter-input {
    background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border);
    color: #fff; padding: 6px 12px; border-radius: 8px; font-size: 13px; width: 200px; outline: none;
  }
  .ns-filter-input:focus { border-color: rgba(124,240,255,0.4); }
  .ns-table { width: 100%; border-collapse: collapse; }
  .ns-table th {
    text-align: left; color: var(--muted); padding: 10px 16px; font-size: 12px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--panel-border);
  }
  .ns-table td { padding: 12px 16px; font-size: 13px; color: var(--text); border-bottom: 1px solid rgba(255,255,255,0.03); }
  .ns-table tbody tr:nth-child(even) { background: rgba(255,255,255,0.015); }
  .ns-table tbody tr:hover { background: rgba(124,240,255,0.04); }
  .ns-table .ns-mac { font-family: 'Courier New', Courier, monospace; font-size: 12px; color: var(--muted); letter-spacing: 0.5px; }
  .ns-status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
  .ns-status-dot.online { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.5); }
