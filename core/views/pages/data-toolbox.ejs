  .ns-action-btn:hover { color: #fff; border-color: rgba(124,240,255,0.3); background: rgba(124,240,255,0.08); }
  .ns-action-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .ns-action-btn.enriching i { animation: ns-spin 1s linear infinite; }
  .ns-modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
    z-index: 5000; display: flex; align-items: center; justify-content: center;
    opacity: 0; visibility: hidden; transition: all 0.25s ease;
  }
  .ns-modal-overlay.visible { opacity: 1; visibility: visible; }
  .ns-modal {
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 14px;
    padding: 28px; width: 100%; max-width: 460px; transform: scale(0.95) translateY(10px);
    transition: transform 0.25s ease; box-shadow: 0 20px 70px rgba(0,0,0,0.5);
  }
  .ns-modal-overlay.visible .ns-modal { transform: scale(1) translateY(0); }
  .ns-modal h3 { font-size: 18px; font-weight: 700; color: #fff; margin: 0 0 20px 0; display: flex; align-items: center; gap: 8px; }
  .ns-modal h3 i { color: #7cf0ff; }
  .ns-modal-field { margin-bottom: 16px; }
  .ns-modal-field label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
  .ns-modal-field input, .ns-modal-field textarea, .ns-modal-field select {
    width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border);
    color: #fff; padding: 8px 12px; border-radius: 8px; font-size: 14px;
    font-family: 'Space Grotesk', sans-serif; outline: none; transition: border-color 0.2s;
  }
  .ns-modal-field input:focus, .ns-modal-field textarea:focus, .ns-modal-field select:focus { border-color: rgba(124,240,255,0.4); }
  .ns-modal-field input[readonly] { opacity: 0.5; cursor: not-allowed; }
  .ns-modal-field textarea { resize: vertical; min-height: 70px; }
  .ns-modal-field select option { background: #1e293b; }
  .ns-modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }
  .ns-btn-cancel {
    background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border);
    color: var(--muted); padding: 8px 18px; border-radius: 8px; font-size: 14px; cursor: pointer; transition: all 0.2s;
  }
  .ns-btn-cancel:hover { color: #fff; border-color: rgba(255,255,255,0.15); }
  .ns-btn-save {
    background: linear-gradient(135deg, rgba(124,240,255,0.2), rgba(124,240,255,0.08));
    border: 1px solid rgba(124,240,255,0.3); color: #7cf0ff; padding: 8px 22px;
    border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s;
  }
  .ns-btn-save:hover { background: linear-gradient(135deg, rgba(124,240,255,0.3), rgba(124,240,255,0.15)); }
  .ns-btn-save:disabled { opacity: 0.5; cursor: not-allowed; }
  .ns-drawer-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 4000;
    opacity: 0; visibility: hidden; transition: all 0.3s ease;
  }
  .ns-drawer-overlay.visible { opacity: 1; visibility: visible; }
  .ns-drawer {
    position: fixed; top: 0; right: -420px; bottom: 0; width: 400px;
    background: var(--panel-bg); border-left: 1px solid var(--panel-border);
    z-index: 4001; transition: right 0.3s ease; overflow-y: auto; padding: 24px;
    box-shadow: -10px 0 40px rgba(0,0,0,0.3);
  }
  .ns-drawer.visible { right: 0; }
  .ns-drawer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .ns-drawer-header h3 { font-size: 18px; font-weight: 700; color: #fff; margin: 0; display: flex; align-items: center; gap: 8px; }
  .ns-drawer-header h3 i { color: #7cf0ff; }
  .ns-drawer-close { background: none; border: none; color: var(--muted); cursor: pointer; font-size: 18px; padding: 4px 8px; }
  .ns-drawer-close:hover { color: #fff; }
  .ns-drawer-section { margin-bottom: 20px; }
  .ns-drawer-section h4 { font-size: 13px; font-weight: 600; color: #7cf0ff; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 0.5px; }
  .ns-drawer-info { font-size: 14px; color: var(--text); background: rgba(255,255,255,0.03); border-radius: 8px; padding: 12px 14px; }
  .ns-drawer-info .label { color: var(--muted); font-size: 12px; }
  .ns-drawer-info .value { color: #fff; font-weight: 500; }
  .ns-ports-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .ns-ports-table th { text-align: left; color: var(--muted); padding: 6px 10px; font-size: 11px; font-weight: 600; text-transform: uppercase; border-bottom: 1px solid var(--panel-border); }
  .ns-ports-table td { padding: 6px 10px; color: var(--text); border-bottom: 1px solid rgba(255,255,255,0.03); }
  .ns-port-open { color: #22c55e; font-weight: 600; }
  .ns-port-closed { color: #ef4444; }
  .ns-port-filtered { color: #fbbf24; }
  .ns-drawer-loading { text-align: center; padding: 40px 0; color: var(--muted); }
  .ns-drawer-loading i { font-size: 24px; color: #7cf0ff; animation: ns-spin 1s linear infinite; margin-bottom: 12px; display: block; }
  .ns-empty { text-align: center; padding: 60px 24px; color: var(--muted); }
  .ns-empty i { font-size: 40px; color: rgba(124,240,255,0.3); margin-bottom: 16px; }
  .ns-empty p { font-size: 14px; }
  .ns-loading { text-align: center; padding: 40px; color: var(--muted); }
  .ns-loading i { font-size: 20px; color: #7cf0ff; animation: ns-spin 1s linear infinite; margin-right: 8px; }
  @media (max-width: 768px) {
    .ns-table-wrap { overflow-x: auto; }
    .ns-scan-card { flex-direction: column; align-items: stretch; }
    .ns-scan-status { margin-left: 0; }
    .ns-drawer { width: 100%; right: -100%; }
  }

  /* ============================================ */
  /* Database Browser — db- prefix                */
  /* ============================================ */
  .db-container {
    max-width: 1500px; margin: 0 auto;
    padding-left: 24px; padding-right: 24px; padding-bottom: 40px;
  }
  .db-header { margin-bottom: 24px; }
  .db-header h1 { font-size: 28px; font-weight: 700; margin: 0 0 6px 0; display: flex; align-items: center; gap: 12px; color: #fff; }
  .db-header h1 i { color: var(--accent); }
  .db-header p { color: var(--muted); margin: 0; font-size: 14px; }
  .db-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px; }
  .db-stat-card { background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; padding: 20px; text-align: center; }
  .db-stat-value { font-size: 28px; font-weight: 700; color: #fff; }
  .db-stat-label { font-size: 12px; color: var(--muted); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
  .db-panels { display: grid; grid-template-columns: 300px 1fr; gap: 20px; }
  .db-sidebar {
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px;
    padding: 16px; display: flex; flex-direction: column;
  }
  .db-sidebar-title { font-size: 14px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; }
  .db-search {
    width: 100%; padding: 10px 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border);
    border-radius: 8px; color: #fff; font-size: 13px; font-family: inherit; margin-bottom: 12px; outline: none; transition: border-color 0.2s;
  }
  .db-search:focus { border-color: var(--accent); }
  .db-search::placeholder { color: var(--muted); }
  .db-collection-list {
    max-height: calc(100vh - 250px); overflow-y: auto; display: flex; flex-direction: column; gap: 6px;
  }
  .db-collection-list::-webkit-scrollbar { width: 4px; }
  .db-collection-list::-webkit-scrollbar-track { background: transparent; }
  .db-collection-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }
  .db-coll-card {
    background: rgba(255,255,255,0.03); border: 1px solid transparent; border-radius: 8px;
    padding: 12px; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; gap: 6px;
  }
  .db-coll-card:hover { background: rgba(255,255,255,0.06); border-color: rgba(124, 240, 255, 0.15); }
  .db-coll-card.selected { border-color: var(--accent); background: rgba(124, 240, 255, 0.06); box-shadow: 0 0 12px rgba(124, 240, 255, 0.08); }
  .db-coll-top { display: flex; justify-content: space-between; align-items: center; }
  .db-coll-name { font-size: 13px; font-weight: 600; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; margin-right: 8px; }
  .db-coll-badges { display: flex; gap: 4px; align-items: center; flex-shrink: 0; }
  .db-badge { font-size: 10px; padding: 2px 6px; border-radius: 4px; font-weight: 600; white-space: nowrap; }
  .db-badge-count { background: rgba(255,255,255,0.08); color: var(--muted); }
  .db-badge-size { background: rgba(255,255,255,0.05); color: var(--muted); font-size: 9px; }
  .db-badge-owner { font-size: 9px; padding: 1px 5px; border-radius: 3px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; }
  .db-detail { background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; padding: 24px; min-height: 400px; }
  .db-detail-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; min-height: 400px; color: var(--muted); gap: 12px; }
  .db-detail-empty i { font-size: 48px; opacity: 0.3; }
  .db-detail-empty span { font-size: 14px; }
  .db-detail-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
  .db-detail-title { font-size: 20px; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 10px; }
  .db-detail-meta { display: flex; gap: 16px; font-size: 13px; color: var(--muted); }
  .db-detail-meta span { display: flex; align-items: center; gap: 4px; }
  .db-query-bar { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; align-items: flex-end; }
  .db-query-group { display: flex; flex-direction: column; gap: 4px; }
  .db-query-group label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.3px; }
  .db-query-group.filter-group { flex: 1; min-width: 200px; }
  .db-query-input {
    padding: 8px 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border);
    border-radius: 8px; color: #fff; font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px;
    outline: none; transition: border-color 0.2s;
  }
  .db-query-input:focus { border-color: var(--accent); }
  .db-query-input.error { border-color: var(--danger); }
  .db-query-input.small { width: 80px; }
  .db-query-input.sort-input { width: 120px; }
  .db-fetch-btn {
    padding: 8px 20px; background: var(--accent); color: #0c0f1a; border: none; border-radius: 8px;
    font-weight: 600; font-size: 13px; font-family: inherit; cursor: pointer; transition: opacity 0.2s; white-space: nowrap;
  }
  .db-fetch-btn:hover { opacity: 0.85; }
  .db-fetch-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .db-results-info { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-size: 13px; color: var(--muted); }
  .db-pagination { display: flex; gap: 6px; align-items: center; }
  .db-page-btn {
    padding: 4px 10px; background: rgba(255,255,255,0.06); border: 1px solid var(--panel-border);
    border-radius: 6px; color: var(--text); cursor: pointer; font-size: 12px; font-family: inherit; transition: all 0.2s;
  }
  .db-page-btn:hover { border-color: var(--accent); color: #fff; }
  .db-page-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .db-page-btn:disabled:hover { border-color: var(--panel-border); color: var(--text); }
  .db-doc-list { display: flex; flex-direction: column; gap: 8px; }
  .db-doc-card { background: rgba(0,0,0,0.2); border: 1px solid var(--panel-border); border-radius: 10px; overflow: hidden; transition: border-color 0.2s; }
  .db-doc-card:hover { border-color: rgba(124, 240, 255, 0.15); }
  .db-doc-header { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; cursor: pointer; user-select: none; }
  .db-doc-header-left { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); min-width: 0; }
  .db-doc-chevron { transition: transform 0.2s; font-size: 10px; color: var(--muted); }
  .db-doc-chevron.open { transform: rotate(90deg); }
  .db-doc-id { font-family: 'SF Mono', 'Fira Code', monospace; color: var(--accent); font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .db-doc-actions { display: flex; gap: 6px; }
  .db-doc-action-btn {
    padding: 3px 8px; background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border);
    border-radius: 4px; color: var(--muted); cursor: pointer; font-size: 11px; transition: all 0.2s;
  }
  .db-doc-action-btn:hover { color: var(--accent); border-color: var(--accent); }
  .db-doc-body { display: none; padding: 0 16px 16px; }
  .db-doc-body.open { display: block; }
  .db-json-container {
    font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px; background: rgba(0,0,0,0.3);
    padding: 16px; border-radius: 8px; overflow-x: auto; line-height: 1.6; white-space: pre-wrap; word-break: break-all;
  }
  .db-json-key { color: #7cf0ff; }
  .db-json-string { color: #22c55e; }
  .db-json-number { color: #f59e0b; }
  .db-json-boolean { color: #a78bfa; }
  .db-json-null { color: var(--muted); }
  .db-modal-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);
    z-index: 2000; align-items: center; justify-content: center;
  }
  .db-modal-overlay.open { display: flex; }
  .db-modal {
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 16px;
    width: 90vw; max-width: 900px; max-height: 85vh; display: flex; flex-direction: column;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  .db-modal-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid var(--panel-border); }
  .db-modal-title { font-size: 16px; font-weight: 600; color: #fff; display: flex; align-items: center; gap: 8px; }
  .db-modal-title i { color: var(--accent); }
  .db-modal-actions { display: flex; gap: 8px; }
  .db-modal-btn {
    padding: 6px 14px; background: rgba(255,255,255,0.06); border: 1px solid var(--panel-border);
    border-radius: 6px; color: var(--text); cursor: pointer; font-size: 12px; font-family: inherit;
    display: flex; align-items: center; gap: 6px; transition: all 0.2s;
  }
  .db-modal-btn:hover { border-color: var(--accent); color: var(--accent); }
  .db-modal-close { background: none; border: none; color: var(--muted); font-size: 18px; cursor: pointer; padding: 4px 8px; }
  .db-modal-close:hover { color: #fff; }
  .db-modal-body { padding: 24px; overflow-y: auto; flex: 1; }
  .db-loading { display: flex; align-items: center; justify-content: center; padding: 40px; color: var(--muted); gap: 8px; }
  .db-loading i { animation: db-spin 1s linear infinite; }
  @keyframes db-spin { to { transform: rotate(360deg); } }
  @media (max-width: 900px) {
    .db-panels { grid-template-columns: 1fr; }
    .db-collection-list { max-height: 300px; }
    .db-stats { grid-template-columns: 1fr; }
  }

  /* ============================================ */
  /* Live Data Dashboard — ld- prefix             */
  /* ============================================ */
  .ld-container {
    max-width: 1500px; margin: 0 auto;
    padding-left: 24px; padding-right: 24px; padding-bottom: 40px;
  }
  .ld-header {
    background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px);
    padding: 2rem; margin-bottom: 1.5rem; border-radius: 16px; border: 1px solid var(--panel-border);
  }
  .ld-header h1 { font-size: 28px; font-weight: 700; margin: 0 0 6px 0; display: flex; align-items: center; gap: 12px; color: #fff; }
  .ld-header h1 i { color: var(--accent); }
  .ld-header p { color: var(--muted); margin: 0; font-size: 14px; }
  .ld-master {
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 16px;
    padding: 24px 32px; margin-bottom: 1.5rem; display: flex; align-items: center;
    justify-content: space-between; transition: all 0.5s ease;
  }
  .ld-master.active { background: linear-gradient(135deg, rgba(34,197,94,0.2), rgba(124,240,255,0.2)); border-color: rgba(124,240,255,0.25); }
  .ld-master-left { display: flex; align-items: center; gap: 16px; }
  .ld-master-icon {
    width: 48px; height: 48px; border-radius: 12px; background: rgba(124,240,255,0.1);
    display: flex; align-items: center; justify-content: center; font-size: 22px; color: var(--accent); transition: all 0.3s;
  }
  .ld-master.active .ld-master-icon { background: rgba(34,197,94,0.2); color: #22c55e; }
  .ld-master-label { font-size: 18px; font-weight: 600; color: #fff; }
  .ld-master-status { font-size: 13px; color: var(--muted); margin-top: 2px; }
  .ld-master.active .ld-master-status { color: #22c55e; }
  .ld-switch { position: relative; display: inline-block; width: 52px; height: 28px; flex-shrink: 0; }
  .ld-switch input { opacity: 0; width: 0; height: 0; }
  .ld-switch .ld-slider {
    position: absolute; cursor: pointer; inset: 0; background: rgba(255,255,255,0.1);
    border-radius: 28px; transition: all 0.3s ease;
  }
  .ld-switch .ld-slider::before {
    content: ''; position: absolute; width: 22px; height: 22px; left: 3px; bottom: 3px;
    background: #fff; border-radius: 50%; transition: transform 0.3s ease;
  }
  .ld-switch input:checked + .ld-slider { background: #22c55e; box-shadow: 0 0 12px rgba(34,197,94,0.4); }
  .ld-switch input:checked + .ld-slider::before { transform: translateX(24px); }
  .ld-switch-lg { width: 64px; height: 34px; }
  .ld-switch-lg .ld-slider::before { width: 28px; height: 28px; }
  .ld-switch-lg input:checked + .ld-slider::before { transform: translateX(30px); }
  .ld-services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 1.5rem; }
  @media (max-width: 900px) { .ld-services-grid { grid-template-columns: 1fr; } }
  .ld-service-card { background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 16px; padding: 20px; transition: all 0.3s ease; }
  .ld-service-card:hover { border-color: rgba(124,240,255,0.15); }
  .ld-service-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .ld-service-card-title { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; color: #fff; }
  .ld-service-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; }
  .ld-service-icon.iss { background: rgba(124,240,255,0.12); color: #7cf0ff; }
  .ld-service-icon.quakes { background: rgba(245,158,11,0.12); color: #f59e0b; }
  .ld-service-icon.weather { background: rgba(139,92,246,0.12); color: #8b5cf6; }
  .ld-status-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.2); display: inline-block; transition: all 0.3s; }
  .ld-status-dot.active { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.6); }
  .ld-service-latest { font-size: 13px; color: var(--muted); margin-top: 8px; min-height: 20px; }
  .ld-section { background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 16px; margin-bottom: 1.5rem; overflow: hidden; }
  .ld-section-header { padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; transition: background 0.2s; }
  .ld-section-header:hover { background: rgba(255,255,255,0.02); }
  .ld-section-title { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 16px; color: #fff; }
  .ld-section-title i { color: var(--accent); font-size: 18px; }
  .ld-section-chevron { color: var(--muted); transition: transform 0.3s; }
  .ld-section.collapsed .ld-section-chevron { transform: rotate(-90deg); }
  .ld-section-body { padding: 0 24px 24px; transition: all 0.3s ease; }
  .ld-section.collapsed .ld-section-body { display: none; }
  .ld-stats-row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
  .ld-stat-badge {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px;
    background: rgba(255,255,255,0.04); border: 1px solid var(--panel-border); border-radius: 10px;
    font-size: 14px; color: var(--text);
  }
  .ld-stat-badge i { color: var(--accent); font-size: 13px; }
  .ld-stat-badge .ld-stat-value { color: #fff; font-weight: 600; }
  .ld-table-wrap { overflow-x: auto; }
  .ld-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .ld-table th {
    text-align: left; padding: 10px 14px; color: var(--muted); font-weight: 500;
    font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--panel-border); white-space: nowrap;
  }
  .ld-table td { padding: 10px 14px; color: var(--text); border-bottom: 1px solid rgba(255,255,255,0.03); }
  .ld-table tr:hover td { background: rgba(255,255,255,0.02); }
  .ld-mag { font-weight: 700; padding: 2px 8px; border-radius: 6px; font-size: 13px; }
  .ld-mag-gray { background: rgba(255,255,255,0.08); color: #93a0b5; }
  .ld-mag-green { background: rgba(34,197,94,0.15); color: #22c55e; }
  .ld-mag-yellow { background: rgba(245,158,11,0.15); color: #f59e0b; }
  .ld-mag-red { background: rgba(239,68,68,0.15); color: #ef4444; }
  .ld-weather-main { display: flex; align-items: center; gap: 40px; flex-wrap: wrap; }
  .ld-weather-pressure { text-align: center; }
  .ld-weather-pressure .ld-big-number { font-size: 56px; font-weight: 700; color: #fff; line-height: 1; }
  .ld-weather-pressure .ld-big-unit { font-size: 16px; color: var(--muted); margin-top: 4px; }
  .ld-weather-details { display: flex; flex-direction: column; gap: 12px; }
  .ld-weather-detail { display: flex; align-items: center; gap: 10px; font-size: 15px; color: var(--text); }
  .ld-weather-detail i { width: 24px; text-align: center; color: var(--accent); }
  .ld-empty { text-align: center; padding: 32px; color: var(--muted); font-size: 14px; }
  .ld-empty i { font-size: 28px; margin-bottom: 8px; display: block; opacity: 0.4; }
  .ld-refresh-info { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
