            <div class="db-loading"><i class="fas fa-spinner"></i> Loading...</div>
          </div>
        </div>

        <!-- Right detail panel -->
        <div class="db-detail" id="db-detail">
          <div class="db-detail-empty" id="db-detail-empty">
            <i class="fas fa-table"></i>
            <span>Select a collection to browse documents</span>
          </div>
          <div id="db-detail-content" style="display:none;">
            <!-- Header -->
            <div class="db-detail-header">
              <div>
                <div class="db-detail-title">
                  <span id="db-detail-name"></span>
                  <span class="db-badge db-badge-owner" id="db-detail-owner"></span>
                </div>
                <div class="db-detail-meta" id="db-detail-meta"></div>
              </div>
            </div>

            <!-- Query bar -->
            <div class="db-query-bar">
              <div class="db-query-group filter-group">
                <label>Filter (JSON)</label>
                <input type="text" class="db-query-input" id="db-filter" value="{}" placeholder='{"field": "value"}'>
              </div>
              <div class="db-query-group">
                <label>Skip</label>
                <input type="number" class="db-query-input small" id="db-skip" value="0" min="0">
              </div>
              <div class="db-query-group">
                <label>Limit</label>
                <input type="number" class="db-query-input small" id="db-limit" value="20" min="1" max="100">
              </div>
              <div class="db-query-group">
                <label>Sort</label>
                <select class="db-query-input sort-input" id="db-sort">
                  <option value="desc" selected>Newest First</option>
                  <option value="asc">Oldest First</option>
                </select>
              </div>
              <button class="db-fetch-btn" id="db-fetch-btn">
                <i class="fas fa-search"></i> Fetch
              </button>
            </div>

            <!-- Results info + pagination -->
            <div class="db-results-info" id="db-results-info" style="display:none;">
              <span id="db-results-count"></span>
              <div class="db-pagination" id="db-pagination"></div>
            </div>

            <!-- Document list -->
            <div class="db-doc-list" id="db-doc-list"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Document detail modal -->
    <div class="db-modal-overlay" id="db-modal">
      <div class="db-modal">
        <div class="db-modal-header">
          <div class="db-modal-title">
            <i class="fas fa-file-code"></i>
            <span id="db-modal-doc-id">Document</span>
          </div>
          <div class="db-modal-actions">
            <button class="db-modal-btn" id="db-modal-copy">
              <i class="fas fa-copy"></i> Copy
            </button>
            <button class="db-modal-close" id="db-modal-close-btn">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
        <div class="db-modal-body">
          <div class="db-json-container" id="db-modal-json"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- TAB: Live Data                               -->
  <!-- ============================================ -->
  <div id="tab-live-data" class="tab-panel" role="tabpanel" aria-labelledby="data-tab-live-data" hidden>
    <div class="ld-container">
      <!-- Header -->
      <div class="ld-header">
        <h1><i class="fas fa-satellite-dish"></i> Live Data Dashboard</h1>
        <p>Real-time data feeds from ISS, seismic, and atmospheric sources</p>
      </div>

      <!-- Master Power Switch -->
      <div class="ld-master" id="ld-master">
        <div class="ld-master-left">
          <div class="ld-master-icon"><i class="fas fa-power-off"></i></div>
          <div>
            <div class="ld-master-label">Live Data Engine</div>
            <div class="ld-master-status" id="ld-master-status">Offline</div>
          </div>
        </div>
        <label class="ld-switch ld-switch-lg">
          <input type="checkbox" id="ld-master-toggle">
          <span class="ld-slider"></span>
        </label>
      </div>

      <!-- Feed-health strip (registry-driven from /api/data/livedata/feeds) -->
      <div class="ld-health-strip" id="ld-health-strip">
        <div class="ld-empty" style="grid-column:1/-1"><span class="ld-spinner"></span> Loading feeds…</div>
      </div>

      <!-- World map: ISS track + satellites + quakes (self-hosted base, no external tiles) -->
      <div class="ld-section" id="ld-section-map">
        <div class="ld-section-header" data-toggle-section="map">
          <div class="ld-section-title"><i class="fas fa-globe"></i> World Map</div>
          <div class="ld-map-legend">
            <span><i class="fas fa-circle" style="color:#7cf0ff"></i> ISS</span>
            <span><i class="fas fa-circle" style="color:#a78bfa"></i> Satellites</span>
            <span><i class="fas fa-circle" style="color:#f59e0b"></i> Quakes</span>
            <i class="fas fa-chevron-down ld-section-chevron"></i>
          </div>
        </div>
        <div class="ld-section-body">
          <div id="ld-map" class="ld-map"></div>
          <div class="ld-map-note" id="ld-map-note"></div>
        </div>
      </div>

      <!-- Time-series charts (Chart.js over /:feed/history) -->
      <div class="ld-charts-grid">
        <div class="ld-chart-card">
          <div class="ld-chart-head"><i class="fas fa-gauge-high"></i> Barometric Pressure <span id="ld-weather-latest" class="ld-chart-latest"></span></div>
          <canvas id="ld-chart-weather" height="120"></canvas>
          <div class="ld-empty ld-chart-empty" id="ld-chart-weather-empty">Enable Weather to chart pressure</div>
        </div>
        <div class="ld-chart-card">
          <div class="ld-chart-head"><i class="fas fa-wind"></i> Air Quality (PM2.5) <span id="ld-aqi-latest" class="ld-chart-latest"></span></div>
          <canvas id="ld-chart-aqi" height="120"></canvas>
          <div class="ld-empty ld-chart-empty" id="ld-chart-aqi-empty">Enable Air Quality to chart PM2.5</div>
        </div>
      </div>

      <!-- Earthquakes Section -->
      <div class="ld-section" id="ld-section-quakes">
        <div class="ld-section-header" data-toggle-section="quakes">
          <div class="ld-section-title">
            <i class="fas fa-mountain"></i> Earthquake Activity
          </div>
          <div style="display:flex;align-items:center;gap:16px;">
            <div class="ld-refresh-info" id="ld-refresh-quakes">
              <i class="fas fa-sync-alt"></i> Auto-refresh: off
            </div>
            <i class="fas fa-chevron-down ld-section-chevron"></i>
          </div>
        </div>
        <div class="ld-section-body">
          <div class="ld-stats-row" id="ld-quakes-stats">
            <div class="ld-stat-badge"><i class="fas fa-list-ol"></i> Today: <span class="ld-stat-value" id="ld-quakes-count">--</span></div>
            <div class="ld-stat-badge"><i class="fas fa-bolt"></i> Largest: <span class="ld-stat-value" id="ld-quakes-max">--</span></div>
          </div>
          <div class="ld-table-wrap">
            <table class="ld-table">
              <thead>
                <tr>
                  <th>Time</th>
                  <th>Magnitude</th>
                  <th>Location</th>
                  <th>Depth (km)</th>
                </tr>
              </thead>
              <tbody id="ld-quakes-tbody">
                <tr><td colspan="4" class="ld-empty"><i class="fas fa-mountain"></i>Enable earthquakes to see seismic data</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Data Toolbox page layout ── */
  .data-toolbox { max-width: 1400px; margin: 0 auto; padding: 20px 30px; }
  .page-header { margin-bottom: 24px; }
  .page-header h1 { font-size: 1.8em; color: var(--text-primary); margin: 0 0 6px; }
  .page-header .subtitle { color: var(--text-secondary); margin: 0; font-size: 0.95em; }
  .tab-bar {
    display: flex; gap: 4px; margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0;
    overflow-x: auto;
  }
  .tab-btn {
    padding: 10px 18px; background: none; border: none; border-bottom: 2px solid transparent;
    color: var(--text-secondary); cursor: pointer; font-size: 14px; font-family: var(--font-body);
    white-space: nowrap; transition: all 0.2s; display: flex; align-items: center; gap: 8px;
  }
  .tab-btn:hover { color: var(--text-primary); background: var(--bg-hover); }
  .tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); }

  /* ── Operating-state strip — live Data-domain health ── */
  .data-ops-strip {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px;
  }
  .data-ops-item {
    background: var(--panel-bg); border: 1px solid var(--panel-border);
    border-left: 3px solid var(--border); border-radius: 12px;
    padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; min-width: 0;
    transition: border-color 0.25s ease;
  }
  .data-ops-label {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted);
    display: flex; align-items: center; gap: 6px;
  }
  .data-ops-label i { font-size: 11px; opacity: 0.85; }
  .data-ops-value {
    font-size: 18px; font-weight: 700; color: #fff;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .data-ops-detail {
    font-size: 12px; color: var(--text-secondary);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .data-ops-item.is-loading { border-left-color: var(--accent); }
  .data-ops-item.is-loading .data-ops-value { color: var(--muted); font-weight: 600; }
  .data-ops-item.is-ok { border-left-color: #3fb950; }
  .data-ops-item.is-warning { border-left-color: #d29922; }
  .data-ops-item.is-error { border-left-color: #f85149; }
  @media (max-width: 860px) { .data-ops-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .data-ops-strip { grid-template-columns: 1fr; } }

  /* ── Remove inner container padding-top since layout handles it ── */
  .tab-panel .st-container,
  .tab-panel .fb-page,
  .tab-panel .jn-container,
  .tab-panel .ns-container,
  .tab-panel .db-container,
  .tab-panel .ld-container {
    padding-top: 0;
    min-height: auto;
  }

  /* ============================================ */
  /* Storage Scanner — st- prefix                 */
  /* ============================================ */
  .st-container {
    max-width: 1500px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 40px;
  }
  .st-header {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    padding: 2rem;
    margin-bottom: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--panel-border);
  }
  .st-header h1 {
    font-size: 28px; font-weight: 700; margin: 0 0 6px 0;
    display: flex; align-items: center; gap: 12px; color: #fff;
  }
  .st-header h1 i { color: var(--accent); }
  .st-header p { color: var(--muted); margin: 0; font-size: 14px; }
  .st-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 1.5rem; }
  .st-stat-card {
    background: var(--panel-bg); border: 1px solid var(--panel-border);
    border-radius: 12px; padding: 20px; text-align: center;
  }
  .st-stat-card .st-stat-value { font-size: 28px; font-weight: 700; color: #fff; margin-bottom: 4px; }
  .st-stat-card .st-stat-label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
  .st-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 1.5rem; }
  .st-panel { background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; padding: 20px; }
  .st-panel-title { font-size: 16px; font-weight: 600; color: #fff; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px; }
  .st-panel-title i { color: var(--accent); font-size: 14px; }
  .st-form-group { margin-bottom: 14px; }
  .st-form-group label { display: block; font-size: 13px; font-weight: 500; color: var(--muted); margin-bottom: 6px; }
  .st-input, .st-textarea {
    width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border);
    color: #fff; padding: 8px 12px; border-radius: 8px; font-family: inherit; font-size: 13px; transition: border-color 0.2s;
  }
  .st-input:focus, .st-textarea:focus { outline: none; border-color: rgba(124, 240, 255, 0.4); }
  .st-textarea { resize: vertical; min-height: 90px; }
  .st-input-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .st-btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 8px;
    font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
    border: 1px solid transparent; transition: all 0.2s;
  }
  .st-btn:hover { filter: brightness(1.2); }
  .st-btn:disabled { opacity: 0.5; cursor: not-allowed; filter: none; }
  .st-btn-success { background: rgba(34, 197, 94, 0.15); color: #22c55e; border-color: rgba(34, 197, 94, 0.3); }
  .st-btn-danger { background: rgba(239, 68, 68, 0.15); color: #ef4444; border-color: rgba(239, 68, 68, 0.3); }
  .st-btn-primary { background: rgba(124, 240, 255, 0.15); color: #7cf0ff; border-color: rgba(124, 240, 255, 0.3); }
  .st-btn-lg { width: 100%; justify-content: center; padding: 14px 20px; font-size: 16px; margin-top: 8px; }
  .st-status-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .st-status-detail { font-size: 13px; color: var(--muted); margin-bottom: 8px; }
  .st-status-detail span { color: #fff; font-weight: 500; }
  .st-badge {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px;
    font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px;
  }
  .st-badge-idle { background: rgba(255,255,255,0.08); color: var(--muted); }
  .st-badge-scanning { background: rgba(59, 130, 246, 0.15); color: #60a5fa; animation: st-pulse 1.5s ease-in-out infinite; }
  .st-badge-complete { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
  .st-badge-error { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
  .st-badge-stopped { background: rgba(234, 179, 8, 0.15); color: #eab308; }
  @keyframes st-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  .st-progress-track { width: 100%; height: 8px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; margin-bottom: 16px; }
  .st-progress-fill { height: 100%; background: linear-gradient(90deg, #7cf0ff, #60a5fa); border-radius: 4px; transition: width 0.4s ease; width: 0%; }
  .st-counters { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }
  .st-counter { text-align: center; padding: 12px; background: rgba(255,255,255,0.03); border-radius: 8px; }
  .st-counter-val { font-size: 22px; font-weight: 700; color: #fff; }
  .st-counter-lbl { font-size: 11px; text-transform: uppercase; color: var(--muted); margin-top: 2px; }
  .st-counter-val.st-counter-error { color: #ef4444; }
  .st-table-wrap { overflow-x: auto; margin-bottom: 1.5rem; }
  .st-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .st-table th {
    text-align: left; padding: 10px 12px; color: var(--muted); font-weight: 500;
    font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px; border-bottom: 1px solid var(--panel-border);
  }
  .st-table td { padding: 10px 12px; border-bottom: 1px solid rgba(255,255,255,0.03); color: var(--text); }
  .st-table tr:hover td { background: rgba(255,255,255,0.02); }
  .st-table .st-mono { font-family: 'Fira Code', monospace; font-size: 12px; color: var(--accent); }
  .st-resources { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .st-resource-item { text-align: center; padding: 14px 10px; background: rgba(255,255,255,0.03); border-radius: 8px; }
  .st-resource-val { font-size: 20px; font-weight: 700; color: #fff; }
  .st-resource-lbl { font-size: 11px; text-transform: uppercase; color: var(--muted); margin-top: 4px; }
  .st-empty { text-align: center; padding: 30px; color: var(--muted); font-size: 14px; }
  @media (max-width: 900px) {
    .st-columns { grid-template-columns: 1fr; }
    .st-stats { grid-template-columns: repeat(2, 1fr); }
    .st-resources { grid-template-columns: repeat(2, 1fr); }
    .st-counters { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .st-stats { grid-template-columns: 1fr; }
    .st-input-row { grid-template-columns: 1fr; }
  }

  /* ============================================ */
  /* File Browser — fb- prefix                    */
  /* ============================================ */
  .fb-page {
    max-width: 1500px; margin: 0 auto;
    padding-left: 24px; padding-right: 24px; padding-bottom: 48px;
  }
  .fb-header {
    background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px);
    padding: 24px 28px; margin-bottom: 24px; border-radius: 16px; border: 1px solid var(--panel-border);
  }
  .fb-header h1 { font-size: 28px; font-weight: 700; color: #fff; margin: 0 0 6px; display: flex; align-items: center; gap: 12px; }
  .fb-header h1 i { color: #7cf0ff; }
  .fb-header p { color: var(--muted); margin: 0; font-size: 14px; }
  .fb-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px; }
  .fb-stat {
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 10px;
    padding: 18px 16px; text-align: center; transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .fb-stat:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
  .fb-stat-icon { font-size: 18px; color: #7cf0ff; margin-bottom: 8px; }
  .fb-stat-value { font-size: 28px; font-weight: 700; color: #fff; line-height: 1.2; }
  .fb-stat-label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px; }
  .fb-toolbar {
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px;
    padding: 16px 20px; margin-bottom: 20px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
  }
  .fb-search-wrap { position: relative; flex: 1; min-width: 200px; }
  .fb-search-wrap i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 13px; pointer-events: none; }
  .fb-input {
    background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border); color: #fff;
    padding: 8px 12px 8px 34px; border-radius: 8px; font-family: 'Space Grotesk', sans-serif;
    font-size: 14px; width: 100%; transition: border-color 0.2s ease;
  }
  .fb-input:focus { outline: none; border-color: rgba(124, 240, 255, 0.4); }
  .fb-input::placeholder { color: rgba(255,255,255,0.3); }
  .fb-select {
    background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border); color: #fff;
    padding: 8px 12px; border-radius: 8px; font-family: 'Space Grotesk', sans-serif; font-size: 14px;
    cursor: pointer; transition: border-color 0.2s ease;
  }
  .fb-select:focus { outline: none; border-color: rgba(124, 240, 255, 0.4); }
  .fb-select option { background: #1a1f2e; color: #fff; }
  .fb-btn {
    background: rgba(255,255,255,0.06); border: 1px solid var(--panel-border); color: var(--muted);
    padding: 8px 14px; border-radius: 8px; font-family: 'Space Grotesk', sans-serif;
    font-size: 13px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
    transition: all 0.2s ease; white-space: nowrap;
  }
  .fb-btn:hover { background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.15); }
  .fb-btn.active { background: rgba(124, 240, 255, 0.15); color: #7cf0ff; border-color: rgba(124, 240, 255, 0.3); }
  .fb-btn-accent { background: rgba(124, 240, 255, 0.12); color: #7cf0ff; border-color: rgba(124, 240, 255, 0.25); }
  .fb-btn-accent:hover { background: rgba(124, 240, 255, 0.2); color: #7cf0ff; }
  .fb-toolbar-separator { width: 1px; height: 28px; background: var(--panel-border); flex-shrink: 0; }
  .fb-table-wrap {
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px;
    overflow: hidden; margin-bottom: 20px;
  }
  .fb-table { width: 100%; border-collapse: collapse; }
  .fb-table thead th {
    text-transform: uppercase; font-size: 11px; font-weight: 600; color: var(--muted); letter-spacing: 0.5px;
    padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--panel-border);
    background: rgba(255,255,255,0.02); white-space: nowrap;
  }
  .fb-table tbody tr { border-bottom: 1px solid rgba(255,255,255,0.03); transition: background 0.15s ease; }
  .fb-table tbody tr:hover { background: rgba(255,255,255,0.03); }
  .fb-table tbody tr:last-child { border-bottom: none; }
  .fb-table td { padding: 12px 16px; font-size: 13px; color: var(--text); vertical-align: middle; }
  .fb-file-icon { color: var(--muted); font-size: 15px; width: 20px; text-align: center; }
  .fb-file-icon.image { color: #a78bfa; }
  .fb-file-icon.code { color: #34d399; }
  .fb-file-icon.pdf { color: #f87171; }
  .fb-file-icon.archive { color: #fbbf24; }
  .fb-file-icon.video { color: #60a5fa; }
  .fb-file-icon.audio { color: #f472b6; }
  .fb-file-name { font-weight: 500; color: #fff; max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fb-file-path { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px; color: var(--muted); max-width: 350px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fb-file-size { white-space: nowrap; color: var(--muted); font-size: 13px; }
