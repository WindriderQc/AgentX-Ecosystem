<script>
  // Tab switching
  function switchToTab(tabName) {
    const btn = document.querySelector(`.tab-btn[data-tab="${tabName}"]`);
    if (!btn) return;
    document.querySelectorAll('.tab-btn').forEach(b => {
      const active = b === btn;
      b.classList.toggle('active', active);
      b.setAttribute('aria-selected', active ? 'true' : 'false');
      b.tabIndex = active ? 0 : -1;
    });
    document.querySelectorAll('.tab-panel').forEach(p => {
      p.hidden = p.id !== 'tab-' + tabName;
    });
    btn.classList.add('active');
    window.location.hash = tabName;
  }

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => switchToTab(btn.dataset.tab));
    btn.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const tabs = Array.from(document.querySelectorAll('.tab-btn'));
      const current = tabs.indexOf(btn);
      const target = event.key === 'Home' ? tabs[0]
        : event.key === 'End' ? tabs[tabs.length - 1]
          : tabs[(current + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
      switchToTab(target.dataset.tab);
      target.focus();
    });
  });
  document.querySelectorAll('[data-switch-tab]').forEach(button => {
    button.addEventListener('click', () => switchToTab(button.dataset.switchTab));
  });

  // Deep-link via URL hash (#files, #janitor, etc.)
  if (window.location.hash) {
    const tab = window.location.hash.slice(1);
    if (document.querySelector(`.tab-btn[data-tab="${tab}"]`)) switchToTab(tab);
  }

  // Network "Scan Now" gating + live scanner status is owned by
  // NetworkPage.loadScannerStatus() (network.js), which probes /agents (is a
  // native scanner reporting?) and /capability (in-container nmap?) and flips
  // between live / in-container fallback / disabled (the 0258 state).

  // Initialize all data page modules once DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof StoragePage !== 'undefined') StoragePage.init();
    if (typeof FileBrowser !== 'undefined') FileBrowser.init();
    if (typeof JanitorPage !== 'undefined') JanitorPage.init();
    if (typeof NetworkPage !== 'undefined') NetworkPage.init();
    if (typeof DatabaseBrowser !== 'undefined') DatabaseBrowser.init();
    if (typeof LiveDataPage !== 'undefined') LiveDataPage.init();
  });
</script>
