  }
  .ns-type-badge.server { background: rgba(238,176,255,0.12); color: #eeb0ff; }
  .ns-type-badge.workstation { background: rgba(34,197,94,0.12); color: #4ade80; }
  .ns-type-badge.mobile { background: rgba(251,191,36,0.12); color: #fbbf24; }
  .ns-type-badge.iot { background: rgba(248,113,113,0.12); color: #f87171; }
  .ns-type-badge.network { background: rgba(96,165,250,0.12); color: #60a5fa; }
  .ns-actions { display: flex; gap: 6px; }
  .ns-action-btn {
