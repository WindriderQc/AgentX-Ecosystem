    .jn-stats { grid-template-columns: repeat(3, 1fr); }
    .jn-triage-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .jn-stats { grid-template-columns: repeat(2, 1fr); }
    .jn-header { flex-direction: column; gap: 12px; align-items: flex-start; }
  }

  /* ============================================ */
  /* Network Scanner — ns- prefix                 */
  /* ============================================ */
  .ns-container { max-width: 1500px; margin: 0 auto; padding: 0 24px 24px; }
  .ns-header { margin-bottom: 28px; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; }
  .ns-header h1 { font-size: 28px; font-weight: 700; color: #fff; margin: 8px 0; }
  .ns-header h1 i { color: #7cf0ff; margin-right: 10px; }
  .ns-header p { color: var(--muted); font-size: 14px; }
  .ns-scan-card {
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px;
    padding: 20px; margin-bottom: 20px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
  }
  .ns-scan-card label { font-size: 13px; color: var(--muted); font-weight: 500; }
  .ns-scan-input {
    background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border);
    color: #fff; padding: 8px 14px; border-radius: 8px; font-size: 14px;
    font-family: 'Space Grotesk', monospace; width: 220px; outline: none; transition: border-color 0.2s;
  }
  .ns-scan-input:focus { border-color: rgba(124,240,255,0.4); }
  .ns-scan-btn {
    background: linear-gradient(135deg, rgba(124,240,255,0.2), rgba(124,240,255,0.08));
    border: 1px solid rgba(124,240,255,0.3); color: #7cf0ff; padding: 8px 20px;
    border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; gap: 8px; transition: all 0.2s;
  }
  .ns-scan-btn:hover { background: linear-gradient(135deg, rgba(124,240,255,0.3), rgba(124,240,255,0.15)); transform: translateY(-1px); }
  .ns-scan-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
  .ns-scan-btn .fa-radar { animation: none; }
  .ns-scan-btn.scanning .fa-satellite-dish { animation: ns-spin 1.2s linear infinite; }
  @keyframes ns-spin { to { transform: rotate(360deg); } }
  .ns-scan-status { font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 6px; margin-left: auto; }
  .ns-scan-status .ns-status-dot { display: inline-block; }
  .ns-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 24px; }
  .ns-stat { background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 10px; padding: 16px; text-align: center; }
  .ns-stat-value { font-size: 28px; font-weight: 700; color: #fff; }
