<div class="data-toolbox">
  <div class="page-header">
    <h1><i class="fas fa-toolbox"></i> Data Toolbox</h1>
    <p class="subtitle">Storage scanning, file browser, cleanup, network discovery, database inspection, and live data feeds</p>
  </div>

  <!-- Operating-state strip — live Data-domain health (data-toolbox-ops.js) -->
  <section id="data-ops-strip" class="data-ops-strip" aria-label="Data toolbox operating state" aria-live="polite">
    <div class="data-ops-item is-loading" id="dops-service">
      <span class="data-ops-label"><i class="fas fa-server"></i> Service</span>
      <strong class="data-ops-value">Checking…</strong>
      <span class="data-ops-detail">Contacting agentx-data</span>
    </div>
    <div class="data-ops-item is-loading" id="dops-storage">
      <span class="data-ops-label"><i class="fas fa-hard-drive"></i> Storage</span>
      <strong class="data-ops-value">Checking…</strong>
      <span class="data-ops-detail">Reading indexed-file summary</span>
    </div>
    <div class="data-ops-item is-loading" id="dops-network">
      <span class="data-ops-label"><i class="fas fa-network-wired"></i> Network</span>
      <strong class="data-ops-value">Checking…</strong>
      <span class="data-ops-detail">Counting discovered devices</span>
    </div>
    <div class="data-ops-item is-loading" id="dops-feeds">
      <span class="data-ops-label"><i class="fas fa-satellite-dish"></i> Live Feeds</span>
      <strong class="data-ops-value">Checking…</strong>
      <span class="data-ops-detail">Resolving configured feeds</span>
    </div>
  </section>

  <div class="tab-bar" role="tablist" aria-label="Data toolbox areas">
    <button class="tab-btn active" id="data-tab-storage" data-tab="storage" role="tab" aria-selected="true" aria-controls="tab-storage"><i class="fas fa-hard-drive"></i> Storage</button>
    <button class="tab-btn" id="data-tab-files" data-tab="files" role="tab" aria-selected="false" aria-controls="tab-files" tabindex="-1"><i class="fas fa-folder-open"></i> Files</button>
    <button class="tab-btn" id="data-tab-janitor" data-tab="janitor" role="tab" aria-selected="false" aria-controls="tab-janitor" tabindex="-1"><i class="fas fa-broom"></i> Janitor</button>
    <button class="tab-btn" id="data-tab-network" data-tab="network" role="tab" aria-selected="false" aria-controls="tab-network" tabindex="-1"><i class="fas fa-network-wired"></i> Network</button>
    <button class="tab-btn" id="data-tab-databases" data-tab="databases" role="tab" aria-selected="false" aria-controls="tab-databases" tabindex="-1"><i class="fas fa-database"></i> Databases</button>
    <button class="tab-btn" id="data-tab-live-data" data-tab="live-data" role="tab" aria-selected="false" aria-controls="tab-live-data" tabindex="-1"><i class="fas fa-satellite-dish"></i> Live Data</button>
  </div>

  <!-- ============================================ -->
  <!-- TAB: Storage                                 -->
  <!-- ============================================ -->
  <div id="tab-storage" class="tab-panel active" role="tabpanel" aria-labelledby="data-tab-storage">
    <div class="st-container">

      <!-- Header -->
      <div class="st-header">
        <h1><i class="fas fa-database"></i> Storage Scanner</h1>
        <p>Scan NAS and local filesystems, track file metadata, and detect duplicates.</p>
        <div style="margin-top: 10px;">
          <button class="st-btn st-btn-primary" type="button" data-switch-tab="files" style="font-size: 12px; padding: 6px 14px;">
            <i class="fas fa-folder-open"></i> Browse Files
          </button>
          <button class="st-btn st-btn-primary" type="button" data-switch-tab="janitor" style="font-size: 12px; padding: 6px 14px; margin-left: 8px;">
            <i class="fas fa-broom"></i> Cleanup
          </button>
        </div>
      </div>

      <!-- Summary stat cards -->
      <div class="st-stats">
        <div class="st-stat-card">
          <div class="st-stat-value" id="st-total-files">--</div>
          <div class="st-stat-label">Total Files</div>
        </div>
        <div class="st-stat-card">
          <div class="st-stat-value" id="st-total-size">--</div>
          <div class="st-stat-label">Total Size</div>
        </div>
        <div class="st-stat-card">
          <div class="st-stat-value" id="st-duplicates">--</div>
          <div class="st-stat-label">Verified Duplicate Groups</div>
        </div>
        <div class="st-stat-card">
          <div class="st-stat-value" id="st-last-scan">--</div>
          <div class="st-stat-label">Last Scan</div>
        </div>
      </div>
      <div id="st-evidence-note" class="st-panel" style="margin-bottom:1.5rem; padding:12px 16px; color:var(--muted); font-size:12px;">
        Verified SHA256 results are a lower bound. Same-size candidates and files beyond the scan's hashing budget remain unverified.
      </div>

      <!-- Two-column: config + status -->
      <div class="st-columns">

        <!-- Scan configuration -->
        <div class="st-panel">
          <h3 class="st-panel-title"><i class="fas fa-cog"></i> Scan Configuration</h3>
          <div class="st-form-group">
            <label for="st-roots">Root Directories (one per line)</label>
            <textarea class="st-textarea" id="st-roots" placeholder="/mnt/nas&#10;/home/user/data"></textarea>
          </div>
          <div class="st-input-row">
            <div class="st-form-group">
              <label for="st-extensions">Extensions Filter</label>
              <input class="st-input" id="st-extensions" placeholder=".jpg,.png,.mp4" />
            </div>
            <div class="st-form-group">
              <label for="st-batch-size">Batch Size</label>
              <input class="st-input" id="st-batch-size" type="number" value="100" min="10" max="5000" />
            </div>
          </div>
          <button class="st-btn st-btn-success st-btn-lg" id="st-start-btn">
            <i class="fas fa-play"></i> Start Scan
          </button>
        </div>

        <!-- Live scan status -->
        <div class="st-panel">
          <h3 class="st-panel-title"><i class="fas fa-satellite-dish"></i> Live Scan Status</h3>

          <div class="st-status-row">
            <div>
              <div class="st-status-detail">Scan ID: <span id="st-scan-id">--</span></div>
            </div>
            <span class="st-badge st-badge-idle" id="st-status-badge">Idle</span>
          </div>

          <div class="st-progress-track">
            <div class="st-progress-fill" id="st-progress-fill"></div>
          </div>

          <div class="st-counters">
            <div class="st-counter">
              <div class="st-counter-val" id="st-files-seen">0</div>
              <div class="st-counter-lbl">Files Seen</div>
            </div>
            <div class="st-counter">
              <div class="st-counter-val" id="st-files-upserted">0</div>
              <div class="st-counter-lbl">Upserted</div>
            </div>
            <div class="st-counter">
              <div class="st-counter-val st-counter-error" id="st-files-errors">0</div>
              <div class="st-counter-lbl">Errors</div>
            </div>
          </div>

          <div class="st-status-detail">Start: <span id="st-start-time">--</span></div>
          <div class="st-status-detail">Elapsed: <span id="st-elapsed">--</span></div>

          <button class="st-btn st-btn-danger" id="st-stop-btn" style="display:none; margin-top: 12px;">
            <i class="fas fa-stop"></i> Stop Scan
          </button>
        </div>
      </div>

      <!-- Recent scans table -->
      <div class="st-panel" style="margin-bottom: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
          <h3 class="st-panel-title" style="margin-bottom: 0;"><i class="fas fa-history"></i> Recent Scans</h3>
          <button class="st-btn st-btn-primary" id="st-refresh-scans-btn" style="padding: 6px 14px; font-size: 12px;">
            <i class="fas fa-sync-alt"></i> Refresh
          </button>
        </div>
        <div class="st-table-wrap">
          <table class="st-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Files</th>
                <th>Upserted</th>
                <th>Errors</th>
                <th>Duration</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody id="st-scans-tbody">
              <tr><td colspan="7" class="st-empty">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- System resources -->
      <div class="st-panel">
        <h3 class="st-panel-title"><i class="fas fa-microchip"></i> System Resources</h3>
        <div class="st-resources">
          <div class="st-resource-item">
            <div class="st-resource-val" id="st-res-cpu">--</div>
            <div class="st-resource-lbl">CPU %</div>
          </div>
          <div class="st-resource-item">
            <div class="st-resource-val" id="st-res-memory">--</div>
            <div class="st-resource-lbl">Memory %</div>
          </div>
          <div class="st-resource-item">
            <div class="st-resource-val" id="st-res-load">--</div>
            <div class="st-resource-lbl">Load Avg</div>
          </div>
          <div class="st-resource-item">
            <div class="st-resource-val" id="st-res-uptime">--</div>
            <div class="st-resource-lbl">Uptime</div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ============================================ -->
  <!-- TAB: Files                                   -->
  <!-- ============================================ -->
  <div id="tab-files" class="tab-panel" role="tabpanel" aria-labelledby="data-tab-files" hidden>
    <div class="fb-page">
      <!-- Header -->
      <div class="fb-header">
        <h1><i class="fas fa-file-alt"></i> File Browser</h1>
        <p>Browse and search indexed NAS files</p>
        <div style="margin-top: 10px;">
          <button class="st-btn st-btn-primary" type="button" data-switch-tab="janitor" style="font-size: 12px; padding: 6px 14px;">
            <i class="fas fa-broom"></i> Clean Duplicates
          </button>
          <button class="st-btn st-btn-primary" type="button" data-switch-tab="storage" style="font-size: 12px; padding: 6px 14px; margin-left: 8px;">
            <i class="fas fa-hard-drive"></i> Run Scan
          </button>
        </div>
      </div>

      <!-- Stat cards -->
      <div class="fb-stats">
        <div class="fb-stat">
          <div class="fb-stat-icon"><i class="fas fa-copy"></i></div>
          <div class="fb-stat-value" id="statTotalFiles">--</div>
          <div class="fb-stat-label">Total Files</div>
        </div>
        <div class="fb-stat">
          <div class="fb-stat-icon"><i class="fas fa-database"></i></div>
          <div class="fb-stat-value" id="statTotalSize">--</div>
          <div class="fb-stat-label">Total Size</div>
        </div>
        <div class="fb-stat">
          <div class="fb-stat-icon"><i class="fas fa-puzzle-piece"></i></div>
          <div class="fb-stat-value" id="statExtensions">--</div>
          <div class="fb-stat-label">File Types</div>
        </div>
        <div class="fb-stat">
          <div class="fb-stat-icon"><i class="fas fa-folder-open"></i></div>
          <div class="fb-stat-value" id="statDirectories">--</div>
          <div class="fb-stat-label">Directories</div>
        </div>
      </div>

      <!-- Toolbar -->
      <div class="fb-toolbar">
        <div class="fb-search-wrap">
          <i class="fas fa-search"></i>
          <input type="text" class="fb-input" id="fbSearch" placeholder="Search files...">
        </div>
        <select class="fb-select" id="fbExtFilter">
          <option value="">All Extensions</option>
        </select>
        <select class="fb-select" id="fbSort">
          <option value="filename">Sort: Name</option>
          <option value="size">Sort: Size</option>
          <option value="mtime">Sort: Modified</option>
        </select>
        <button class="fb-btn" id="fbDirToggle" title="Toggle sort direction">
          <i class="fas fa-arrow-up-short-wide"></i> Asc
        </button>
        <select class="fb-select" id="fbLimit">
          <option value="25">25 / page</option>
          <option value="50">50 / page</option>
          <option value="100">100 / page</option>
          <option value="200">200 / page</option>
        </select>
        <div class="fb-toolbar-separator"></div>
        <button class="fb-btn fb-btn-accent" id="fbRefresh" title="Refresh">
          <i class="fas fa-sync-alt"></i> Refresh
        </button>
        <button class="fb-btn" id="fbClear" title="Clear filters">
          <i class="fas fa-times"></i> Clear
        </button>
        <div class="fb-toolbar-separator"></div>
        <button class="fb-btn" id="fbDupesToggle" title="Toggle duplicate files view">
          <i class="fas fa-clone"></i> Duplicates
        </button>
      </div>

      <!-- Browse section (normal view) -->
      <div class="fb-browse-section" id="fbBrowseSection">
        <div class="fb-table-wrap">
          <table class="fb-table">
            <thead>
              <tr>
                <th style="width:36px"></th>
                <th>Name</th>
                <th>Path</th>
                <th>Size</th>
                <th>Modified</th>
                <th style="width:80px"></th>
              </tr>
            </thead>
            <tbody id="fbTableBody">
              <tr class="fb-loading-row">
                <td colspan="6"><div class="fb-spinner"></div></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="fb-pagination">
          <div class="fb-page-info" id="fbPageInfo">Loading...</div>
          <div class="fb-page-btns" id="fbPageBtns"></div>
        </div>
      </div>

      <!-- Duplicates section -->
      <div class="fb-dupes-section" id="fbDupesSection">
        <div id="fbDupesContent">
          <div class="fb-dupes-empty"><div class="fb-spinner"></div><br>Loading duplicates...</div>
        </div>
      </div>
    </div>

    <!-- Detail modal -->
    <div class="fb-modal-overlay" id="fbModal">
      <div class="fb-modal">
        <button class="fb-modal-close" id="fbModalClose"><i class="fas fa-times"></i></button>
        <h2><i class="fas fa-file-circle-info"></i> File Details</h2>
        <div class="fb-modal-grid" id="fbModalBody"></div>
      </div>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- TAB: Janitor                                 -->
  <!-- ============================================ -->
  <div id="tab-janitor" class="tab-panel" role="tabpanel" aria-labelledby="data-tab-janitor" hidden>
    <!-- Sub-tab navigation -->
    <div class="jn-subtabs" style="display:flex; gap:6px; padding:8px 16px; border-bottom:1px solid var(--border);">
      <button class="jn-subtab-btn jn-subtab-active" data-jn-subtab="tools"><i class="fas fa-broom"></i> Tools</button>
      <button class="jn-subtab-btn" data-jn-subtab="shared-drives"><i class="fas fa-hard-drive"></i> Shared Drives</button>
      <button class="jn-subtab-btn" data-jn-subtab="profiles"><i class="fas fa-folder-tree"></i> Profiles</button>
      <button class="jn-subtab-btn" data-jn-subtab="runs"><i class="fas fa-history"></i> Runs</button>
      <button class="jn-subtab-btn" data-jn-subtab="docs"><i class="fas fa-file-alt"></i> Docs</button>
    </div>

    <div id="jn-subtab-tools" class="jn-subtab-panel">
    <div class="jn-container">
      <div class="jn-main">

        <!-- 1. Header -->
        <div class="jn-header">
          <div>
            <h1><i class="fas fa-broom"></i> Disk Janitor</h1>
            <p>AI-powered storage analysis, deduplication &amp; cleanup</p>
          </div>
          <div class="jn-header-actions">
            <span id="jn-last-scan" style="font-size:11px; color:var(--muted);"></span>
            <button class="jn-btn jn-btn-primary" id="jn-analyze-btn"><i class="fas fa-search"></i> Analyze Directory</button>
            <button class="jn-btn jn-btn-success" id="jn-dedup-btn"><i class="fas fa-play"></i> Run Dedup Scan</button>
          </div>
        </div>

        <!-- 2. Health Metrics -->
        <div class="jn-stats" id="jn-stats">
          <div class="jn-stat" id="jn-stat-files"><div class="jn-stat-top"><div><div class="jn-stat-val">--</div><div class="jn-stat-label">Total Files</div></div></div></div>
          <div class="jn-stat" id="jn-stat-size"><div class="jn-stat-top"><div><div class="jn-stat-val">--</div><div class="jn-stat-label">Total Size</div></div></div></div>
          <div class="jn-stat" id="jn-stat-dupes"><div class="jn-stat-top"><div><div class="jn-stat-val">--</div><div class="jn-stat-label">Verified SHA256 Groups</div></div></div></div>
          <div class="jn-stat" id="jn-stat-reclaimable"><div class="jn-stat-top"><div><div class="jn-stat-val">--</div><div class="jn-stat-label">Proven Duplicate Savings</div></div></div></div>
          <div class="jn-stat" id="jn-stat-policies"><div class="jn-stat-top"><div><div class="jn-stat-val">--</div><div class="jn-stat-label">Policies Active</div></div></div></div>
        </div>
        <div id="jn-evidence-note" class="jn-panel" style="padding:12px 16px; color:var(--muted); font-size:12px;">
          Verified duplicates and savings are lower bounds. Candidate bytes are not reclaimable-space estimates.
        </div>

        <!-- 3. Storage Breakdown -->
        <div class="jn-panel" id="jn-breakdown-panel">
          <div class="jn-panel-head">
            <div class="jn-panel-title"><i class="fas fa-chart-bar"></i> Storage Breakdown</div>
            <span id="jn-breakdown-info" style="font-size:10px; color:var(--muted);"></span>
          </div>
          <div class="jn-bar" id="jn-bar"></div>
          <table class="jn-table">
            <thead><tr><th></th><th>Path</th><th>Files</th><th>Size</th><th>Dupes</th><th>Usage</th></tr></thead>
            <tbody id="jn-breakdown-tbody"><tr><td colspan="6" style="text-align:center; color:var(--muted); padding:20px;">Loading...</td></tr></tbody>
          </table>
        </div>

        <!-- 4. Duplicate Groups -->
        <div class="jn-panel" id="jn-dupes-panel">
          <div class="jn-panel-head">
            <div class="jn-panel-title"><i class="fas fa-clone"></i> Duplicate Groups <span class="jn-panel-sub" id="jn-dupes-sub"></span></div>
            <span style="font-size:10px; color:var(--muted);">Read-only analysis · stage deletes in Cleanup Suggestions</span>
          </div>
          <table class="jn-table">
            <thead><tr><th>Sample Path</th><th>Copies</th><th>Each</th><th>Wasted</th><th>Actions</th></tr></thead>
            <tbody id="jn-dupes-tbody"><tr><td colspan="5" style="text-align:center; color:var(--muted); padding:20px;">Loading...</td></tr></tbody>
          </table>
          <div id="jn-dupes-more" style="text-align:center; padding:10px; display:none;">
            <button class="jn-btn jn-btn-ghost" id="jn-load-more-dupes">Load more...</button>
          </div>
        </div>

        <!-- 5. Cleanup Suggestions -->
        <div class="jn-panel" id="jn-cleanup-panel">
          <div class="jn-panel-head">
            <div class="jn-panel-title"><i class="fas fa-broom"></i> Cleanup Suggestions <span class="jn-panel-sub" id="jn-cleanup-sub"></span></div>
            <div class="jn-panel-actions">
              <button class="jn-btn jn-btn-warn" id="jn-preview-cleanup"><i class="fas fa-eye"></i> Preview (Dry Run)</button>
              <button class="jn-btn jn-btn-success" id="jn-apply-cleanup"><i class="fas fa-check"></i> Apply Selected</button>
            </div>
          </div>
          <div id="jn-cleanup-list"><div style="text-align:center; color:var(--muted); padding:20px;">Loading...</div></div>
        </div>

        <!-- 6. AI Triage -->
        <div class="jn-panel jn-panel-ai" id="jn-triage-panel">
          <div class="jn-panel-head">
            <div class="jn-panel-title"><i class="fas fa-sparkles" style="color:#a78bfa;"></i> AI Triage <span class="jn-panel-sub" id="jn-triage-sub"></span></div>
            <button class="jn-btn jn-btn-ai" id="jn-run-triage"><i class="fas fa-sparkles"></i> Run Triage</button>
          </div>
          <div class="jn-triage-grid" id="jn-triage-grid">
            <div style="grid-column: 1/-1; text-align:center; color:var(--muted); padding:20px;">Click "Run Triage" to analyze your storage with AI</div>
          </div>
        </div>

      </div>

      <!-- 7. AI Chat Panel -->
      <div class="jn-ai-panel" id="jn-ai-panel">
        <div class="jn-ai-header" id="jn-ai-toggle">
          <i class="fas fa-sparkles" style="color:#a78bfa; font-size:16px;"></i>
          <span style="color:#fff; font-weight:600; font-size:13px;">Janitor AI</span>
          <span class="jn-ai-model" title="Triage and chat route through the core model router; the specific model is selected at request time.">Router-selected</span>
        </div>
        <div class="jn-ai-body" id="jn-ai-body">
          <div class="jn-ai-msg assistant">Welcome! I can help you analyze storage, resolve duplicates, and plan cleanups. Ask me anything about your filesystem.</div>
        </div>
        <div class="jn-ai-input">
          <input type="text" id="jn-ai-input" placeholder="Ask the janitor..." />
          <button class="jn-ai-send" id="jn-ai-send">&#10148;</button>
        </div>
      </div>

    </div>

    <!-- Confirm modal -->
    <div class="jn-modal-overlay" id="jn-modal">
      <div class="jn-modal" id="jn-modal-content"></div>
    </div>
    </div> <!-- /jn-subtab-tools -->

    <!-- ===== Shared Drives sub-tab ===== -->
    <div id="jn-subtab-shared-drives" class="jn-subtab-panel" style="display:none; padding:16px;">
      <div class="jn-header">
        <div>
          <h1><i class="fas fa-hard-drive"></i> Shared Drives</h1>
          <p>Policy-gated review of Media and Datalake. This surface cannot approve or execute filesystem changes.</p>
        </div>
        <div class="jn-header-actions">
          <span id="jnsd-report-time" style="font-size:11px; color:var(--muted);"></span>
          <button class="jn-btn jn-btn-ghost" id="jnsd-refresh-btn"><i class="fas fa-sync"></i> Reload</button>
          <button class="jn-btn jn-btn-primary" id="jnsd-generate-btn"><i class="fas fa-chart-line"></i> Refresh Evidence</button>
        </div>
      </div>

      <div class="jn-panel" style="padding:14px 16px; border-left:3px solid #38bdf8;">
        <div class="jn-panel-title"><i class="fas fa-diagram-project"></i> Canonical scope</div>
        <div style="margin-top:8px; font-size:12px; line-height:1.6;">
          The <strong>Media</strong> share physically contains its <strong>Datalake</strong> folder. AgentX indexes
          <code>/mnt/media</code> with that nested child excluded, then indexes <code>/mnt/datalake</code>
          independently. Datalake is therefore counted exactly once in portfolio totals.
        </div>
      </div>

      <div class="jn-panel" style="margin-top:12px; border-left:3px solid #22c55e;">
        <div class="jn-panel-head">
          <div class="jn-panel-title"><i class="fas fa-robot"></i> OpenClaw automation</div>
          <span id="jnsd-automation-state" class="jn-panel-sub">Loading live schedule...</span>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; padding:12px 16px; font-size:12px;">
          <div><strong>Owner</strong><br><span id="jnsd-automation-owner">--</span></div>
          <div><strong>Cadence</strong><br><code id="jnsd-automation-schedule">--</code></div>
          <div><strong>Last run</strong><br><span id="jnsd-automation-last">--</span></div>
