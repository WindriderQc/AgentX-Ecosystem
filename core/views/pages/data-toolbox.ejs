            </select>
            <span style="display:block; color:var(--muted); font-size:11px; margin-top:5px;">Archive and disaster-recovery choices keep duplicate groups containing backup copies out of proposals.</span>
            <span id="jnsd-impact-backup" style="display:block; color:#7cf0ff; font-size:11px; margin-top:7px; line-height:1.5;">Loading verified-group impact...</span>
          </label>
          <label>
            <strong>Generated caches</strong><br>
