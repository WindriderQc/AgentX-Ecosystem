<main class="pipeline-page">
  <header class="pipeline-hero">
    <div class="pipeline-hero-copy">
      <div class="pipeline-eyebrow"><i class="fas fa-list-check"></i> Delivery cockpit</div>
      <h1>Work in progress</h1>
      <p>
        The product-owned task queue behind Agent X delivery. See what is queued, who is
        working, what waits for review, and where work is stuck &mdash; then act with the
        same audited contract the agents use.
      </p>
      <div class="pipeline-hero-actions">
        <button id="pipelineRefreshBtn" class="pipeline-btn primary" type="button">
          <i class="fas fa-rotate"></i><span>Refresh</span>
        </button>
        <button id="pipelineAutoBtn" class="pipeline-btn" type="button" aria-pressed="false"
          title="Automatically refresh the queue every 60 seconds">
          <i class="fas fa-clock-rotate-left"></i><span>Auto-refresh</span>
        </button>
        <a class="pipeline-btn" href="/agent-ops">
          <i class="fas fa-circle-nodes"></i><span>Agent Ops</span>
        </a>
        <button class="cockpit-help-button" type="button" data-cockpit-guide-open="pipelineGuide">
          <i class="fas fa-circle-question"></i><span>Page guide</span>
        </button>
      </div>
    </div>
    <aside class="pipeline-lifecycle" aria-label="Task lifecycle">
      <div class="pipeline-lifecycle-title"><i class="fas fa-route"></i> One task contract</div>
      <ol class="pipeline-lifecycle-flow">
        <li class="stage-queued" data-cockpit-tip-title="Queued" data-cockpit-tip="Ready for any worker to claim atomically. Re-queueing a task releases its worker and heartbeat." tabindex="0"><i class="fas fa-inbox"></i><span>Queued</span></li>
        <li class="stage-progress" data-cockpit-tip-title="In progress" data-cockpit-tip="Claimed by a worker. Healthy work heartbeats regularly; a silent hour marks it stale." tabindex="0"><i class="fas fa-bolt"></i><span>In progress</span></li>
        <li class="stage-review" data-cockpit-tip-title="Review" data-cockpit-tip="The worker reported done. A different overseer must confirm it — workers never self-certify." tabindex="0"><i class="fas fa-magnifying-glass"></i><span>Review</span></li>
        <li class="stage-done" data-cockpit-tip-title="Done" data-cockpit-tip="Confirmed by an overseer distinct from the worker. Every confirmation lands in the audit trail." tabindex="0"><i class="fas fa-check"></i><span>Done</span></li>
      </ol>
      <div class="pipeline-lifecycle-branch" data-cockpit-tip-title="Blocked" data-cockpit-tip="Any stage can report blocked. Blocked work needs an operator or upstream action before it can move." tabindex="0">
        <i class="fas fa-hand"></i><span>Blocked &mdash; needs intervention</span>
      </div>
      <code class="pipeline-lifecycle-api" title="Bounded HTTP contract consumed by external boards and agents">/api/pipeline/tasks</code>
    </aside>
  </header>

  <section id="pipelineHandoffContext" class="pipeline-context" aria-live="polite" hidden>
    <span class="pipeline-context-icon"><i class="fas fa-crosshairs"></i></span>
    <div>
      <strong id="pipelineContextTitle">Context from Agent Ops</strong>
      <span id="pipelineContextDetail">The task list is focused without changing pipeline truth.</span>
    </div>
    <a href="/pipeline" title="Remove the Agent Ops context and show the full pipeline"><i class="fas fa-xmark"></i> Clear context</a>
  </section>

  <section class="pipeline-state" id="pipelineState" data-tone="loading" aria-live="polite">
    <div>
      <i class="fas fa-spinner fa-spin" id="pipelineStateIcon" aria-hidden="true"></i>
      <strong id="pipelineStateTitle">Loading the pipeline&hellip;</strong>
      <span id="pipelineStateDetail">Reading the product-owned task queue.</span>
    </div>
    <time id="pipelineStateUpdated"></time>
  </section>

  <section class="pipeline-metrics" aria-label="Task counts by status — select one to filter the work table">
    <button class="pipeline-metric metric-queued" type="button" data-status-filter="queued" aria-pressed="false">
      <span><i class="fas fa-inbox" aria-hidden="true"></i> Queued</span>
      <strong id="pipelineCountQueued">--</strong>
      <small>Ready for a worker to claim</small>
    </button>
    <button class="pipeline-metric metric-progress" type="button" data-status-filter="in_progress" aria-pressed="false">
      <span><i class="fas fa-bolt" aria-hidden="true"></i> In progress</span>
      <strong id="pipelineCountProgress">--</strong>
      <small>Claimed and actively moving</small>
    </button>
    <button class="pipeline-metric metric-review" type="button" data-status-filter="review" aria-pressed="false">
      <span><i class="fas fa-magnifying-glass" aria-hidden="true"></i> Review</span>
      <strong id="pipelineCountReview">--</strong>
      <small>Waiting for overseer confirmation</small>
    </button>
    <button class="pipeline-metric metric-blocked" type="button" data-status-filter="blocked" aria-pressed="false">
      <span><i class="fas fa-hand" aria-hidden="true"></i> Blocked</span>
      <strong id="pipelineCountBlocked">--</strong>
      <small>Needs operator or upstream action</small>
    </button>
    <button class="pipeline-metric metric-done" type="button" data-status-filter="done" aria-pressed="false">
      <span><i class="fas fa-check" aria-hidden="true"></i> Done</span>
      <strong id="pipelineCountDone">--</strong>
      <small>Confirmed and closed</small>
    </button>
  </section>

  <p id="pipelineCountEvidence" class="pipeline-count-evidence" aria-live="polite">
    Loading count scope and observation evidence&hellip;
  </p>

  <section class="pipeline-panel pipeline-team" aria-labelledby="pipelineTeamTitle">
    <div class="pipeline-panel-header pipeline-team-header">
      <div>
        <h2 id="pipelineTeamTitle"><i class="fas fa-people-group"></i> Coding Team</h2>
        <p>Autonomous attempt performance from the canonical task history. Missing evidence stays unknown.</p>
      </div>
      <label class="pipeline-select">
        <span>Window</span>
        <select id="pipelineTeamWindow" aria-label="Coding Team performance window">
          <option value="7d">7 days</option>
          <option value="30d" selected>30 days</option>
          <option value="90d">90 days</option>
        </select>
      </label>
    </div>
    <div id="pipelineTeamState" class="pipeline-team-state" data-tone="loading" aria-live="polite">
      <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
      <span>Loading autonomous attempt evidence&hellip;</span>
    </div>
    <div class="pipeline-team-launch" aria-labelledby="pipelineTeamLaunchTitle">
      <div class="pipeline-team-launch-copy">
        <div>
          <strong id="pipelineTeamLaunchTitle"><i class="fas fa-play" aria-hidden="true"></i> Run one task</strong>
          <span id="pipelineTeamLaunchState" data-tone="loading" aria-live="polite">Checking the operator one-shot control&hellip;</span>
        </div>
        <p>Starts one bounded local worker. It stops at review or blocked; scheduling, merge, and deploy stay off.</p>
      </div>
      <form id="pipelineTeamLaunchForm" class="pipeline-team-launch-form">
        <label class="pipeline-team-launch-task">
          <span>Queued candidate</span>
          <select id="pipelineTeamLaunchTask" aria-label="Choose one queued coding candidate" disabled>
            <option value="">No candidate loaded</option>
          </select>
        </label>
        <label class="pipeline-team-launch-confirm">
          <input id="pipelineTeamLaunchConfirm" type="checkbox" disabled>
          <span>I confirm this one local run</span>
        </label>
        <button id="pipelineTeamLaunchButton" class="pipeline-btn primary compact" type="submit" disabled>
          <i class="fas fa-play" aria-hidden="true"></i><span>Run one task</span>
        </button>
      </form>
      <p id="pipelineTeamLaunchDetail" class="pipeline-team-launch-detail" aria-live="polite">
        AIOps revalidates scope, dependencies, locks, budgets, and the zero-provider-spend policy before claiming anything.
      </p>
    </div>
    <div class="pipeline-team-metrics" aria-label="Coding Team scorecard">
      <article><span>Accepted</span><strong id="pipelineTeamAccepted">--</strong><small id="pipelineTeamAcceptedDetail">Human-confirmed delivery</small></article>
      <article><span>First pass</span><strong id="pipelineTeamFirstPass">--</strong><small id="pipelineTeamFirstPassDetail">Share of accepted attempts</small></article>
      <article><span>Median cycle</span><strong id="pipelineTeamCycle">--</strong><small id="pipelineTeamCycleDetail">Queue to human decision</small></article>
      <article><span>Corrections</span><strong id="pipelineTeamInterventions">--</strong><small id="pipelineTeamInterventionsDetail">Requeues and rejections</small></article>
      <article><span>Cost evidence</span><strong id="pipelineTeamCost">--</strong><small id="pipelineTeamCostDetail">Provider spend and unpriced local compute stay distinct</small></article>
      <article><span>Evidence</span><strong id="pipelineTeamCoverage">--</strong><small id="pipelineTeamCoverageDetail">Structured attempt receipts</small></article>
    </div>
    <div class="pipeline-team-attempts">
      <div class="pipeline-team-attempts-head">
        <strong>Recent attempts</strong>
        <span id="pipelineTeamAttemptMeta">--</span>
      </div>
      <div class="pipeline-table-wrap">
        <table class="pipeline-table pipeline-team-table">
          <thead>
            <tr>
              <th scope="col">Task</th>
              <th scope="col">Worker</th>
              <th scope="col">Outcome</th>
              <th scope="col">Verification</th>
              <th scope="col">Change</th>
              <th scope="col">Execution</th>
              <th scope="col">Cost</th>
            </tr>
          </thead>
          <tbody id="pipelineTeamAttemptRows">
            <tr><td colspan="7" class="pipeline-empty">Loading attempt evidence&hellip;</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="pipeline-panel pipeline-workbench" aria-label="Pipeline work table">
    <div class="pipeline-toolbar">
      <div class="pipeline-search">
        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
        <input id="pipelineSearch" type="search" placeholder="Search id, title, owner, epic, source&hellip;"
          aria-label="Search tasks by id, title, owner, epic, or source" autocomplete="off">
      </div>
      <label class="pipeline-select">
        <span>Service</span>
        <select id="pipelineServiceFilter" aria-label="Filter by service">
          <option value="">All services</option>
        </select>
      </label>
      <label class="pipeline-select">
        <span>Lane / source</span>
        <select id="pipelineLaneFilter" aria-label="Filter by lane or source">
          <option value="">All lanes / sources</option>
        </select>
      </label>
      <label class="pipeline-select">
        <span>Sort</span>
        <select id="pipelineSort" aria-label="Sort the work table">
          <option value="urgency">Urgency</option>
          <option value="priority">Priority</option>
          <option value="recent">Recently updated</option>
          <option value="id">Task id</option>
        </select>
      </label>
      <button id="pipelineClearFilters" class="pipeline-btn compact" type="button" hidden>
        <i class="fas fa-filter-circle-xmark"></i><span>Clear filters</span>
      </button>
      <p class="pipeline-toolbar-meta" id="pipelineOpenMeta" aria-live="polite">Loading task status&hellip;</p>
    </div>
    <div class="pipeline-table-wrap">
      <table class="pipeline-table">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Task</th>
            <th scope="col">Priority</th>
            <th scope="col">Status</th>
            <th scope="col">Owner</th>
            <th scope="col">Service</th>
            <th scope="col">Due</th>
            <th scope="col">Activity</th>
          </tr>
        </thead>
        <tbody id="pipelineOpenRows">
          <tr><td colspan="8" class="pipeline-empty">Loading tasks&hellip;</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="pipeline-lower-grid">
    <section class="pipeline-panel">
      <div class="pipeline-panel-header">
        <div>
          <h2><i class="fas fa-triangle-exclamation"></i> Needs attention</h2>
          <p id="pipelineAttentionMeta">--</p>
        </div>
      </div>
      <div id="pipelineAttentionList" class="pipeline-attention-list">
        <div class="pipeline-empty">Loading attention items&hellip;</div>
      </div>
    </section>

    <section class="pipeline-panel">
      <div class="pipeline-panel-header">
        <div>
          <h2><i class="fas fa-flag-checkered"></i> Recently done</h2>
          <p id="pipelineDoneMeta">--</p>
        </div>
      </div>
      <div id="pipelineDoneList" class="pipeline-done-list">
        <div class="pipeline-empty">Loading closed tasks&hellip;</div>
      </div>
    </section>
  </section>

  <%- include('../partials/cockpit-guide', {
    cockpitGuide: {
      id: 'pipelineGuide',
      title: 'Read the queue, then act with the audited contract',
      summary: 'Pipeline is the human view of the product-owned task queue and its privacy-safe autonomous-attempt scorecard. Agents and external boards consume the same bounded HTTP API — nothing here bypasses it.',
      sections: [
        { title: 'Read the counts', body: 'The five status cards are global truth. Select one to focus the work table on that stage; select it again to release the filter.' },
        { title: 'Measure the coding team', body: 'Coding Team joins queue, lease, verifier, change, cost, and human-review evidence. Coverage is always visible and missing metrics stay unknown rather than becoming zero.' },
        { title: 'Find the work', body: 'Search matches id, title, owner, epic, and source. Service and lane/source filters narrow the loaded rows; urgency sort surfaces blocked and overdue work first.' },
        { title: 'Open the dossier', body: 'Select any row for the full task: specification, priority, risk, dependencies, and the complete feedback audit trail.' },
        { title: 'Confirm like an overseer', body: 'A task in review can be confirmed done from its dossier — but only by an identity different from the worker. The gate is enforced server-side and every confirmation is audited.' },
        { title: 'Unstick what is stuck', body: 'Re-queue releases a task back to the queue (clearing its worker and heartbeat), and notes land in the same audit trail agents read.' },
        { title: 'Trust the heartbeat', body: 'In-progress work should heartbeat regularly. A silent hour marks it stale in Activity and raises it under Needs attention.' }
      ],
      note: { title: 'One bounded contract', body: 'This page reads and writes /api/pipeline/tasks and reads its aggregate /api/pipeline/performance projection — the same audited Mongo authority used by workers, overseers, and separately deployed boards. There is no privileged side channel.' },
      links: [
        { href: '/agent-ops', icon: 'fa-circle-nodes', label: 'Agent Ops', detail: 'Who does what, and is it running' },
        { href: '/planning', icon: 'fa-diagram-project', label: 'Planning', detail: 'Workstreams and outcomes' },
        { href: '/nerve-center', icon: 'fa-brain', label: 'Nerve Center', detail: 'Fleet and routing health' }
      ]
    }
  }) %>

  <div class="pipeline-drawer-shell" id="pipelineDrawerShell" hidden>
    <button class="pipeline-drawer-scrim" type="button" data-close-pipeline-drawer aria-label="Close task details"></button>
    <aside class="pipeline-drawer" role="dialog" aria-modal="true" aria-labelledby="pipelineDrawerTitle">
      <header class="pipeline-drawer-head">
        <div>
          <span class="pipeline-drawer-eyebrow">Task dossier</span>
          <h2 id="pipelineDrawerTitle">Task</h2>
          <code id="pipelineDrawerId"></code>
        </div>
        <button class="pipeline-drawer-close" type="button" data-close-pipeline-drawer aria-label="Close task details">
          <i class="fas fa-xmark"></i>
        </button>
      </header>
      <div class="pipeline-drawer-body" id="pipelineDrawerBody"></div>
    </aside>
  </div>
</main>
