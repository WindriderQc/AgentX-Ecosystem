    <div class="bg-grid"></div>

    <div class="voice-page" style="max-width: 1200px; margin: 0 auto; padding: 24px;">

        <header style="margin-bottom: 24px;">
            <div class="eyebrow">OPERATIONS</div>
            <h1><i class="fas fa-microphone"></i> Voice</h1>
            <p class="lede">Configure the voice stack in one place: STT, TTS, and ConvoMode defaults. Change the provider host at runtime; inspect live devices, metrics, and models; run diagnostic smoke tests.</p>
        </header>

        <div id="toast" style="display:none; position:fixed; top:80px; right:24px; padding:12px 20px; border-radius:6px; color:#fff; z-index:1000; font-weight:500;"></div>

        <!-- Status banner -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:16px 20px; margin-bottom:24px; display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
            <div id="voiceStatusDot" style="width:14px; height:14px; border-radius:50%; background:#6c757d; flex-shrink:0;"></div>
            <div style="flex:1;">
                <div id="voiceStatusText" style="font-size:16px; font-weight:600;">Probing Voix…</div>
                <div id="voiceStatusMeta" style="font-size:12px; color:#888; margin-top:4px;">—</div>
            </div>
            <a id="voixConsoleLink" class="btn-sm" target="_blank" rel="noopener noreferrer" aria-disabled="true" title="Waiting for the configured VoiX URL" style="padding:8px 14px; text-decoration:none; white-space:nowrap;">
                <i class="fas fa-external-link-alt"></i> Open VoiX console
            </a>
            <button id="voiceRefreshBtn" class="btn" style="padding:8px 14px;">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </section>

        <!-- Settings -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px; margin-bottom:24px;">
            <h2 style="margin:0 0 12px 0;"><i class="fas fa-gear" style="color:#7cf0ff;"></i> Provider</h2>
            <div style="font-size:12px; color:#888; margin-bottom:16px;">
                Runtime edits persist to <code id="voiceConfigFile">—</code>. Env values win on boot unless overridden at runtime. Clearing a field reverts to env/default.
            </div>

            <div style="display:grid; grid-template-columns:auto 1fr auto; gap:12px 16px; align-items:center;">
                <label style="color:#cbd5e1;">Voix base URL</label>
                <input id="cfgBaseUrl" type="text" placeholder="http://host:port" style="padding:6px 10px; background:#0f1629; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                <span id="cfgBaseUrlSrc" style="font-size:11px; color:#888;">—</span>

                <label style="color:#cbd5e1;">Timeout (ms)</label>
                <input id="cfgTimeoutMs" type="number" min="500" step="100" style="width:160px; padding:6px 10px; background:#0f1629; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                <span id="cfgTimeoutSrc" style="font-size:11px; color:#888;">—</span>

                <label style="color:#cbd5e1;">Long timeout (ms)</label>
                <input id="cfgLongTimeoutMs" type="number" min="1000" step="500" style="width:160px; padding:6px 10px; background:#0f1629; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                <span id="cfgLongTimeoutSrc" style="font-size:11px; color:#888;">—</span>
            </div>

            <div style="margin-top:16px; display:flex; gap:12px;">
                <button id="cfgSaveBtn" class="btn btn-primary" style="padding:8px 16px;">Save settings</button>
                <button id="cfgClearBtn" class="btn" style="padding:8px 16px;" title="Remove runtime overrides (revert to env/defaults)">Clear overrides</button>
            </div>
        </section>

        <!-- Voice mode -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px; margin-bottom:24px;">
            <h2 style="margin:0 0 12px 0;"><i class="fas fa-route" style="color:#7cf0ff;"></i> Voice Mode</h2>
            <div style="font-size:12px; color:#888; margin-bottom:16px;">
                Choose the default path Chat should use for speech capture, reply audio, and ConvoMode.
            </div>
            <div style="display:grid; grid-template-columns:minmax(220px, 320px) 1fr auto; gap:12px 16px; align-items:center;">
                <label for="voiceMode" style="color:#cbd5e1;">Mode <span id="voiceModeSrc" style="font-size:11px; color:#888;">—</span></label>
                <select id="voiceMode" style="width:100%; padding:7px 10px; background:#0a0f1d; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                    <option value="browser">Browser</option>
                    <option value="hybrid">Hybrid</option>
                    <option value="native">Native VoiX</option>
                </select>
                <button id="voiceModeApplyBtn" class="btn btn-primary" style="padding:8px 16px;">Apply mode</button>
                <div></div>
                <div id="voiceModeMeta" style="font-size:12px; color:#94a3b8; line-height:1.5;">—</div>
            </div>
        </section>

        <!-- Feature defaults -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px; margin-bottom:24px;">
            <h2 style="margin:0 0 12px 0;"><i class="fas fa-sliders" style="color:#4db33d;"></i> Feature Defaults</h2>
            <div style="font-size:12px; color:#888; margin-bottom:16px;">
                Chat reads these defaults on load. Runtime overrides win over env; clearing overrides falls back to env/default.
            </div>

            <div style="display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:16px;">
                <section style="background:#0f1629; border:1px solid #2a3145; border-radius:6px; padding:16px;">
                    <h3 style="margin:0 0 12px 0; font-size:16px;"><i class="fas fa-microphone" style="color:#dc3545;"></i> STT</h3>
                    <label style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                        <input id="voiceSttEnabled" type="checkbox">
                        <span>Enabled by default</span>
                        <span id="voiceSttEnabledSrc" style="font-size:11px; color:#888; margin-left:auto;">—</span>
                    </label>
                    <label style="display:block; color:#cbd5e1; margin-bottom:6px;">Provider <span id="voiceSttProviderSrc" style="font-size:11px; color:#888;">—</span></label>
                    <select id="voiceSttProvider" style="width:100%; margin-bottom:12px; padding:7px 10px; background:#0a0f1d; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                        <option value="browser">Browser</option>
                        <option value="voix">VoiX</option>
                    </select>
                    <label style="display:block; color:#cbd5e1; margin-bottom:6px;">Language <span id="voiceSttLanguageSrc" style="font-size:11px; color:#888;">—</span></label>
                    <input id="voiceSttLanguage" type="text" placeholder="en" style="width:100%; margin-bottom:12px; padding:7px 10px; background:#0a0f1d; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                    <label style="display:block; color:#cbd5e1; margin-bottom:6px;">Whisper model <span id="voiceSttModelSrc" style="font-size:11px; color:#888;">—</span></label>
                    <input id="voiceSttModel" type="text" placeholder="blank = Voix default" style="width:100%; padding:7px 10px; background:#0a0f1d; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                </section>

                <section style="background:#0f1629; border:1px solid #2a3145; border-radius:6px; padding:16px;">
                    <h3 style="margin:0 0 12px 0; font-size:16px;"><i class="fas fa-volume-high" style="color:#7cf0ff;"></i> TTS</h3>
                    <label style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                        <input id="voiceTtsEnabled" type="checkbox">
                        <span>Read replies by default</span>
                        <span id="voiceTtsEnabledSrc" style="font-size:11px; color:#888; margin-left:auto;">—</span>
                    </label>
                    <label style="display:block; color:#cbd5e1; margin-bottom:6px;">Provider <span id="voiceTtsProviderSrc" style="font-size:11px; color:#888;">—</span></label>
                    <select id="voiceTtsProvider" style="width:100%; margin-bottom:12px; padding:7px 10px; background:#0a0f1d; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                        <option value="browser">Browser</option>
                        <option value="voix">VoiX</option>
                    </select>
                    <label style="display:block; color:#cbd5e1; margin-bottom:6px;">Voice <span id="voiceTtsVoiceSrc" style="font-size:11px; color:#888;">—</span></label>
                    <input id="voiceTtsVoice" type="text" placeholder="blank = provider default" style="width:100%; margin-bottom:12px; padding:7px 10px; background:#0a0f1d; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                    <label style="display:block; color:#cbd5e1; margin-bottom:6px;">Format <span id="voiceTtsFormatSrc" style="font-size:11px; color:#888;">—</span></label>
                    <select id="voiceTtsFormat" style="width:100%; padding:7px 10px; background:#0a0f1d; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                        <option value="mp3">mp3</option>
                        <option value="wav">wav</option>
                        <option value="opus">opus</option>
                        <option value="flac">flac</option>
                    </select>
                </section>

                <section style="background:#0f1629; border:1px solid #2a3145; border-radius:6px; padding:16px;">
                    <h3 style="margin:0 0 12px 0; font-size:16px;"><i class="fas fa-comments" style="color:#f59e0b;"></i> ConvoMode</h3>
                    <label style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                        <input id="voiceConvoEnabled" type="checkbox">
                        <span>Available in chat</span>
                        <span id="voiceConvoEnabledSrc" style="font-size:11px; color:#888; margin-left:auto;">—</span>
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                        <input id="voiceConvoAutoSpeak" type="checkbox">
                        <span>Speak replies</span>
                        <span id="voiceConvoAutoSpeakSrc" style="font-size:11px; color:#888; margin-left:auto;">—</span>
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                        <input id="voiceConvoKeepSession" type="checkbox">
                        <span>Keep session</span>
                        <span id="voiceConvoKeepSessionSrc" style="font-size:11px; color:#888; margin-left:auto;">—</span>
                    </label>
                    <div style="font-size:12px; color:#94a3b8; line-height:1.5; margin-top:16px;">
                        Provider: <code>VoiX</code>. Chat uses one active VoiX session for push-to-talk turns.
                    </div>
                </section>
            </div>
        </section>

        <!-- Voice bake-off -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px; margin-bottom:24px;">
            <h2 style="margin:0 0 12px 0;"><i class="fas fa-gauge-high" style="color:#7cf0ff;"></i> Voice Bake-Off</h2>
            <div style="font-size:12px; color:#888; margin-bottom:16px;">
                Quick check of the three voice paths: browser capabilities, Core→VoiX proxy TTS, and native VoiX session control.
            </div>
            <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
                <button id="voiceBakeoffBtn" class="btn btn-primary" style="padding:8px 16px;">
                    <i class="fas fa-play"></i> Run quick bake-off
                </button>
                <span id="voiceBakeoffMeta" style="font-size:12px; color:#888; align-self:center;">No run yet.</span>
            </div>
            <div id="voiceBakeoffResult" style="display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:12px;"></div>
        </section>

        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px; margin-bottom:24px;">
            <h3 style="margin:0 0 12px 0;"><i class="fas fa-terminal" style="color:#94a3b8;"></i> Env Contract</h3>
            <div id="voiceEnvPanel" style="display:grid; grid-template-columns:auto auto 1fr; gap:6px 12px; font-size:12px; color:#94a3b8;">Loading…</div>
        </section>

        <!-- Provider info -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:24px; margin-bottom:24px;">
            <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px;">
                <h3 style="margin:0 0 12px 0;"><i class="fas fa-cog" style="color:#f59e0b;"></i> Voix configuration</h3>
                <div style="display:grid; grid-template-columns: auto minmax(180px, 1fr) auto; gap:10px 12px; align-items:center; margin-bottom:16px; padding:12px; background:#0f1629; border:1px solid #2a3145; border-radius:6px;">
                    <label for="voixTtsProvider" style="color:#cbd5e1;">TTS engine</label>
                    <select id="voixTtsProvider" style="width:100%; padding:7px 10px; background:#0a0f1d; border:1px solid #2a3145; color:#fff; border-radius:4px;">
                        <option value="kokoro">Kokoro (quality)</option>
                        <option value="windows_sapi">Windows SAPI (low latency)</option>
                    </select>
                    <button id="voixTtsProviderSave" class="btn" style="padding:7px 12px;">Apply</button>
                    <div id="voixTtsProviderMeta" style="grid-column:2 / 4; font-size:11px; color:#888;">—</div>
                </div>
                <div id="voixConfigPanel" style="font-size:13px; color:#888;">Loading…</div>
            </section>

            <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px;">
                <h3 style="margin:0 0 12px 0;"><i class="fas fa-chart-line" style="color:#4db33d;"></i> Metrics</h3>
                <dl id="voixMetricsPanel" style="margin:0; display:grid; grid-template-columns: auto 1fr; gap:8px 12px; font-size:13px;">
                    <dt style="color:#888;">Loading…</dt><dd></dd>
                </dl>
            </section>
        </div>

        <!-- Devices -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px; margin-bottom:24px;">
            <h3 style="margin:0 0 12px 0;"><i class="fas fa-headphones" style="color:#dc3545;"></i> Audio devices</h3>
            <div id="voixDevicesPanel" style="font-size:13px; color:#888;">Loading…</div>
        </section>

        <!-- Whisper models -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px; margin-bottom:24px;">
            <h3 style="margin:0 0 12px 0;"><i class="fas fa-brain" style="color:#a855f7;"></i> Whisper models</h3>
            <div id="voixModelsPanel" style="font-size:13px; color:#888;">Loading…</div>
        </section>

        <!-- Try synthesis — interactive TTS test -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px; margin-bottom:24px;">
            <h3 style="margin:0 0 12px 0;"><i class="fas fa-play-circle" style="color:#4db33d;"></i> Try synthesis (TTS)</h3>
            <div style="font-size:12px; color:#888; margin-bottom:16px;">Type text, choose a voice, hear it spoken. Tests TTS end-to-end with real audio playback in the browser.</div>
            <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-bottom:12px;">
                <input id="trySynthText" type="text" value="Bonjour, ceci est un test de synthese locale." placeholder="Text to synthesize" style="flex:1; min-width:300px; padding:8px 10px; background:#0f1629; border:1px solid #2a3145; color:#fff; border-radius:4px; font-size:14px;">
                <input id="trySynthVoice" type="text" value="" placeholder="voice (e.g. af_sara)" style="width:180px; padding:8px 10px; background:#0f1629; border:1px solid #2a3145; color:#fff; border-radius:4px; font-size:14px;">
                <button id="trySynthBtn" class="btn btn-primary" style="padding:8px 16px;">
                    <i class="fas fa-volume-high"></i> Speak
                </button>
            </div>
            <div id="trySynthResult" style="display:none; padding:12px; background:#0f1629; border:1px solid #2a3145; border-radius:4px;">
                <audio id="trySynthAudio" controls style="width:100%; margin-bottom:8px;"></audio>
                <div id="trySynthMeta" style="font-size:12px; color:#94a3b8;">—</div>
            </div>
        </section>

        <!-- Try transcription — interactive STT test -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px; margin-bottom:24px;">
            <h3 style="margin:0 0 12px 0;"><i class="fas fa-microphone" style="color:#dc3545;"></i> Try transcription (STT)</h3>
            <div style="font-size:12px; color:#888; margin-bottom:16px;">Record from your browser mic, then send the audio to Voix (faster-whisper) for transcription. Tests the full capture → upload → Whisper path. Requires HTTPS or localhost for mic access.</div>
            <div id="browserMicSecurityNotice" role="status" style="display:none; margin-bottom:16px; padding:12px 14px; background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.45); border-radius:6px; color:#fcd34d; font-size:13px; line-height:1.5;">
                <i class="fas fa-triangle-exclamation"></i>
                Browser microphone is unavailable on this HTTP address.
                <a id="voixMicConsoleLink" target="_blank" rel="noopener noreferrer" aria-disabled="true" style="color:#7cf0ff; font-weight:600;">Open the native VoiX console</a>
                to use the Windows microphone and speaker directly.
            </div>
            <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-bottom:12px;">
                <button id="tryRecordBtn" class="btn btn-primary" style="padding:8px 16px;">
                    <i class="fas fa-circle"></i> Start recording
                </button>
                <span id="tryRecordTimer" style="font-family:monospace; font-size:14px; color:#888; min-width:60px;">—</span>
                <input id="tryRecLang" type="text" value="" placeholder="language (e.g. fr, en) — blank = auto" style="width:240px; padding:8px 10px; background:#0f1629; border:1px solid #2a3145; color:#fff; border-radius:4px; font-size:14px;">
                <label style="display:flex; flex:0 0 auto; align-items:center; gap:6px; white-space:nowrap; font-size:13px; color:#cbd5e1; cursor:pointer;">
                    <input id="tryAskNestor" type="checkbox" checked style="accent-color:#7cf0ff;">
                    <i class="fas fa-brain" style="color:#7cf0ff;"></i> Ask Nestor &amp; speak the reply
                </label>
                <label for="tryNestorLane" title="Auto keeps simple answers local and sends actions, live platform questions, memory, and deep work to Nestor Complete." style="display:flex; flex:0 0 auto; align-items:center; gap:6px; white-space:nowrap; font-size:13px; color:#cbd5e1;">
                    <i class="fas fa-route" style="color:#4db33d;"></i> Nestor route
                </label>
                <select id="tryNestorLane" style="padding:8px 10px; background:#0f1629; border:1px solid #2a3145; color:#fff; border-radius:4px; font-size:13px;">
                    <option value="auto" selected>Auto — recommended</option>
                    <option value="answer_light">Fast local</option>
                    <option value="front_door">Complete</option>
                </select>
            </div>
            <div id="tryRecResult" style="display:none; padding:12px; background:#0f1629; border:1px solid #2a3145; border-radius:4px;">
                <audio id="tryRecAudio" controls style="width:100%; margin-bottom:8px;"></audio>
                <div style="font-size:11px; color:#888; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:4px;">Transcript</div>
                <div id="tryRecTranscript" style="padding:8px 10px; background:#0a0f1d; border:1px solid #2a3145; border-radius:4px; color:#cbd5e1; min-height:32px; font-size:14px;">—</div>
                <div id="tryRecMeta" style="font-size:12px; color:#94a3b8; margin-top:8px;">—</div>
                <div id="tryNestorBlock" style="display:none; margin-top:12px;">
                    <div style="font-size:11px; color:#888; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:4px;">
                        <i class="fas fa-brain" style="color:#7cf0ff;"></i> Nestor <span id="tryNestorBrainBadge"></span>
                    </div>
                    <div id="tryNestorReply" role="status" aria-live="polite" aria-atomic="true" style="padding:8px 10px; background:#0a0f1d; border:1px solid #2a3145; border-radius:4px; color:#e2e8f0; min-height:32px; font-size:14px;">—</div>
                    <audio id="tryNestorAudio" controls style="width:100%; margin-top:8px; display:none;"></audio>
                    <div id="tryNestorMeta" style="font-size:12px; color:#94a3b8; margin-top:8px;">—</div>
                </div>
            </div>
        </section>

        <!-- Diagnostics — structured result cards -->
        <section style="background: var(--panel-bg, #1a1f2e); border:1px solid var(--border, #2a3145); border-radius:8px; padding:20px;">
            <h3 style="margin:0 0 12px 0;"><i class="fas fa-stethoscope" style="color:#7cf0ff;"></i> Diagnostics</h3>
            <div style="font-size:12px; color:#888; margin-bottom:16px;">
                <strong>Full smoke</strong> synthesizes text, runs STT on the result, and compares input vs transcript (round-trip quality + full pipeline). <strong>TTS-only</strong> skips STT for a lightweight latency check. Both run server-side and do not play audio in the browser.
            </div>
            <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
                <button id="smokeBtn" class="btn btn-primary" style="padding:8px 16px;">
                    <i class="fas fa-vial"></i> Run full smoke test
                </button>
                <button id="ttsSmokeBtn" class="btn" style="padding:8px 16px;">
                    <i class="fas fa-volume-high"></i> TTS-only smoke test
                </button>
            </div>
            <div id="smokeResult" style="display:none; margin-top:12px;"></div>
            <details style="margin-top:12px;">
                <summary style="cursor:pointer; font-size:12px; color:#888;">Raw JSON result</summary>
                <pre id="diagRaw" style="margin:8px 0 0 0; padding:12px; background:#0f1629; border:1px solid #2a3145; border-radius:4px; color:#94a3b8; font-size:11px; max-height:240px; overflow:auto; white-space:pre-wrap;"></pre>
            </details>
        </section>
    </div>
