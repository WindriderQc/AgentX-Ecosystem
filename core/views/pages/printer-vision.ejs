<section class="printer-vision-page" aria-live="polite">
  <header class="printer-vision-header">
    <div>
      <p class="printer-vision-eyebrow">ANET · supervision IA locale</p>
      <h1>Vision imprimante</h1>
    </div>
    <span id="printerVisionMonitor" class="printer-vision-badge">Connexion…</span>
  </header>

  <div class="printer-vision-grid">
    <figure class="printer-vision-camera">
      <img id="printerVisionImage" alt="Dernière image analysée par la supervision IA">
      <figcaption id="printerVisionCaption">En attente de la première analyse.</figcaption>
    </figure>

    <section class="printer-vision-summary">
      <div class="printer-vision-verdict"><span>Verdict</span><strong id="printerVisionVerdict">—</strong></div>
      <p id="printerVisionObservations">En attente de la première analyse.</p>
      <dl>
        <div><dt>Confiance</dt><dd id="printerVisionConfidence">—</dd></div>
        <div><dt>Première analyse</dt><dd id="printerVisionFirst">—</dd></div>
        <div><dt>Dernière analyse</dt><dd id="printerVisionLast">—</dd></div>
        <div><dt>Cadence</dt><dd id="printerVisionInterval">—</dd></div>
      </dl>
      <p class="printer-vision-safety">Mode alerte seulement · aucune commande à l’imprimante</p>
    </section>
  </div>

  <section class="printer-bed-map" aria-labelledby="bedMapTitle">
    <header>
      <div><p class="printer-vision-eyebrow">Cartographie manuelle · aucune commande envoyée</p><h2 id="bedMapTitle">Relief du plateau</h2></div>
      <span id="bedMapStatus" class="printer-vision-badge">Nouvelle carte</span>
    </header>
    <div class="printer-bed-map-grid">
      <figure><svg id="bedMapSurface" viewBox="0 0 640 380" role="img" aria-label="Projection 3D du plateau"></svg><figcaption>Écart Z en mm relatif au centre : positif = plateau plus haut, donc plus près de la buse.</figcaption></figure>
      <form id="bedMapForm">
        <p>Entre les neuf écarts Z mesurés. Le centre est la référence à 0,00 mm.</p>
        <div id="bedMapInputs" class="bed-map-inputs"></div>
        <label>Note <input id="bedMapNote" maxlength="500" placeholder="PLA, bed à 60 °C, méthode…"></label>
        <button type="submit" class="btn btn-primary">Enregistrer la carte</button>
        <label>Historique <select id="bedMapHistory"><option value="">Aucune carte enregistrée</option></select></label>
      </form>
    </div>
  </section>
</section>
