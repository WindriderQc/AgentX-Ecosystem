{
  "name": "agentx-core",
  "version": "0.1.1",
  "description": "Agent X Core — local inference, routing, telemetry, and product APIs",
  "main": "server.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "predev": "node esbuild.config.mjs",
    "prestart": "node esbuild.config.mjs",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/run-jest.js --silent",
    "test:unit": "npx jest tests/unit --coverage",
    "test:integration": "npx jest tests/integration --runInBand",
    "db:indexes": "node scripts/create-indexes.js",
    "seed:personas": "node scripts/seed-persona.js",
    "overseer:check-flag": "node scripts/overseer/check-flag.js",
    "overseer:ack-flag": "node scripts/overseer/ack-flag.js",
    "overseer:scan-prework": "node scripts/overseer/scan-prework.js",
    "overseer:ttl-sweep": "node scripts/overseer/ttl-sweep.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fortawesome/fontawesome-free": "6.4.0",
    "chart.js": "4.4.4",
    "chartjs-4-5-1": "npm:chart.js@4.5.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "dompurify": "3.4.14",
    "dotenv": "^17.2.3",
    "ejs": "^5.0.1",
    "esbuild": "^0.28.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "js-yaml": "^5.3.0",
    "marked": "18.0.11",
    "mongoose": "^8.9.5",
    "node-fetch": "^2.7.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "mongodb": "^6.5.0",
    "bson": "^6.5.0",
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.1"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
