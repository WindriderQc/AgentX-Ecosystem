{
  "name": "agentx-core",
  "version": "1.2.0",
  "description": "AgentX Core — API toolbox for GPU cluster, models, and operational data",
  "main": "server.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "predev": "node esbuild.config.mjs",
    "prestart": "node esbuild.config.mjs",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/run-jest.js --silent",
    "test:unit": "npx jest tests/unit --coverage",
    "test:integration": "npx jest tests/integration --runInBand",
    "db:indexes": "node scripts/create-indexes.js",
    "docs-steward:audit": "node scripts/docs-steward/run-audit.js",
    "seed:personas": "node scripts/seed-persona.js",
    "lexicon:build": "node scripts/build-kidx-lexicon.js",
    "overseer:check-flag": "node scripts/overseer/check-flag.js",
    "overseer:ack-flag": "node scripts/overseer/ack-flag.js",
    "overseer:scan-prework": "node scripts/overseer/scan-prework.js",
    "overseer:ttl-sweep": "node scripts/overseer/ttl-sweep.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.2.3",
    "ejs": "^5.0.1",
    "esbuild": "^0.28.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "winston": "^3.19.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "mongodb": "^6.5.0",
    "bson": "^6.5.0"
  },
  "engines": {
    "node": ">=18.14.0 || ^20.0.0 || ^21.0.0 || ^22.0.0 || >=23.0.0"
  }
}
