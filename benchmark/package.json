{
  "name": "agentx-benchmark",
  "version": "1.1.0",
  "description": "AgentX Benchmark — Model evaluation, scoring, and leaderboard",
  "main": "server.js",
  "scripts": {
    "qualify:product-lanes": "node scripts/product-lane-qualification.js",
    "qualify:toolcalls": "node scripts/toolcall-qualification.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --forceExit --detectOpenHandles --testPathIgnorePatterns=tests/e2e",
    "test:unit": "jest --config jest.unit.config.js --forceExit",
    "test:e2e": "npx playwright test tests/e2e",
    "audit:judge-interactions": "node scripts/analyze-judge-interactions.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "node-fetch": "^2.7.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "supertest": "^7.2.2"
  }
}
