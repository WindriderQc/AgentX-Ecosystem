{
  "name": "agentx-benchmark",
  "version": "0.1.1",
  "description": "AgentX Benchmark — Model evaluation, scoring, and leaderboard",
  "main": "server.js",
  "license": "MIT",
  "scripts": {
    "qualify:toolcalls": "node scripts/toolcall-qualification.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --forceExit --detectOpenHandles --testPathIgnorePatterns=tests/e2e",
    "test:unit": "jest --config jest.unit.config.js --forceExit",
    "test:e2e": "npx playwright test tests/e2e",
    "migrate:exact-artifacts": "node scripts/migrate-exact-artifact-profile-indexes.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "node-fetch": "^2.7.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.0.1",
    "playwright": "^1.58.2",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.1"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
