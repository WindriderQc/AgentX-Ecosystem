<main class="model-evidence-shell" aria-labelledby="benchmark-page-title">
  <h1 id="benchmark-page-title" class="r-sr-only">Compare models</h1>

  <section class="evaluation-hero">
    <div class="evaluation-hero-copy">
      <div class="evaluation-eyebrow">Agent X Evaluation</div>
      <h2>Find the best model for the job.</h2>
      <p>Compare quality, speed and reliability with a guided run. Open the full laboratory only when you need judge policy, prompt depth or execution controls.</p>
    </div>
    <div id="evaluation-readiness" class="evaluation-readiness is-loading" role="status" aria-live="polite">
      <span class="evaluation-readiness-icon" aria-hidden="true"><i class="fas fa-circle-notch fa-spin"></i></span>
      <span><strong id="evaluation-readiness-label">Checking evaluation…</strong><small id="evaluation-readiness-detail">Confirming models, host profile and history</small></span>
      <button id="evaluation-refresh" class="evaluation-icon-button" type="button" aria-label="Refresh evaluation status" title="Refresh status"><i class="fas fa-rotate-right" aria-hidden="true"></i></button>
    </div>
  </section>

  <section class="evaluation-actions" aria-label="Evaluation actions">
    <a id="evaluation-primary-action" class="evaluation-action-card is-primary" href="#benchmark-cockpit">
      <span class="evaluation-action-icon" aria-hidden="true"><i class="fas fa-scale-balanced"></i></span>
      <span><strong id="evaluation-primary-label">Set up a comparison</strong><small id="evaluation-primary-detail">Choose contenders and run a focused evaluation</small></span>
      <i class="fas fa-arrow-right" aria-hidden="true"></i>
    </a>
    <a class="evaluation-action-card" href="/leaderboard">
      <span class="evaluation-action-icon" aria-hidden="true"><i class="fas fa-trophy"></i></span>
      <span><strong>See ranked models</strong><small id="evaluation-history-detail">No completed comparisons yet</small></span>
      <i class="fas fa-arrow-right" aria-hidden="true"></i>
    </a>
    <a class="evaluation-action-card" href="/results-explorer">
      <span class="evaluation-action-icon" aria-hidden="true"><i class="fas fa-magnifying-glass-chart"></i></span>
      <span><strong>Inspect evidence</strong><small>Prompts, responses, scores and performance</small></span>
      <i class="fas fa-arrow-right" aria-hidden="true"></i>
    </a>
  </section>

  <details id="benchmark-cockpit" class="evaluation-cockpit">
    <summary id="evaluation-open-controls">
      <span class="evaluation-action-icon" aria-hidden="true"><i class="fas fa-sliders"></i></span>
      <span><strong>Take the controls</strong><small>Execution host, contenders, judge, test depth and live diagnostics</small></span>
      <span class="evaluation-expert-badge">Expert lab</span>
    </summary>

    <div class="evaluation-cockpit-surface">
      <header id="action-zone" class="r-action-zone">
        <div id="az-idle" class="az-row">
          <div class="status-dot idle"></div>
          <div class="status-label idle-label">IDLE — Configure a comparison</div>
          <div id="host-pills" class="az-host-pills"></div>
          <div class="az-actions"><button id="btn-history" class="r-nav-btn" type="button">History</button></div>
        </div>

        <div id="az-live" class="az-row" style="display:none;">
          <div class="status-dot executing"></div>
          <div class="status-label live-label">EXECUTING</div>
          <div class="header-meta">
            <span id="prompt-counter">0 / 0 prompts</span>
            <span id="elapsed" class="elapsed">0:00</span>
            <span id="eta" class="eta"></span>
            <span id="stop-status" class="stop-status" role="status" aria-live="polite" hidden></span>
            <button id="btn-stop" class="stop-btn" type="button" data-stop-state="ready"><i class="fas fa-stop" aria-hidden="true"></i> Stop</button>
          </div>
        </div>

        <div id="pipeline-bar-wrap" style="display:none;">
          <div class="pipeline-bar">
            <div class="pipe-seg s-prep"><div class="pf" id="pf-prep"></div></div>
            <div class="pipe-seg s-warm"><div class="pf" id="pf-warm"></div></div>
            <div class="pipe-seg s-exec"><div class="pf" id="pf-exec"></div></div>
            <div class="pipe-seg s-jdg"><div class="pf" id="pf-jdg"></div></div>
          </div>
          <div class="pipe-labels"><span id="pl-prep">prep</span><span id="pl-warm">warmup</span><span id="pl-exec">generating</span><span id="pl-jdg">judging</span></div>
          <div id="pipe-status" class="pipe-status" style="display:none;"></div>
        </div>
      </header>

      <div class="benchmark-engine">
        <div id="idle-sections">
          <section id="workflow-guide" class="workflow-guide" aria-label="Comparison setup progress">
            <a class="wf-step wf-current" href="#infrastructure" data-wf-step="host"><span class="wf-index">1</span><span class="wf-copy"><span class="wf-title">Where to run</span><span class="wf-meta" id="wf-host-meta">Select an execution target</span></span></a>
            <a class="wf-step wf-locked" href="#batch-config" data-wf-step="models"><span class="wf-index">2</span><span class="wf-copy"><span class="wf-title">Models</span><span class="wf-meta" id="wf-models-meta">Pick contenders</span></span></a>
            <a class="wf-step wf-locked" href="#batch-config" data-wf-step="tests"><span class="wf-index">3</span><span class="wf-copy"><span class="wf-title">Evidence</span><span class="wf-meta" id="wf-tests-meta">Choose judge and test depth</span></span></a>
            <a class="wf-step wf-locked" href="#launch-summary" data-wf-step="launch"><span class="wf-index">4</span><span class="wf-copy"><span class="wf-title">Review & run</span><span class="wf-meta" id="wf-launch-meta">Confirm the evaluation</span></span></a>
          </section>

          <section id="infrastructure" class="r-section" data-workflow-section="host" tabindex="-1">
            <div class="r-sec-head"><span class="r-sec-icon bf-section-num">①</span><span class="r-sec-title r-t-green">Execution host</span><span id="infra-count" class="r-sec-count"></span></div>
            <div id="host-cards" class="hs-grid-wrap"><div class="r-loading">Loading hosts…</div></div>
          </section>

          <section id="batch-config" class="r-section" data-workflow-section="config" tabindex="-1">
            <div id="config-body"><div class="r-loading">Loading configuration…</div></div>
          </section>

          <section id="launch-summary" class="r-section" data-workflow-section="launch" tabindex="-1"><div class="r-loading">Waiting for configuration…</div></section>

          <div id="launch-dock" class="launch-dock" aria-live="polite">
            <div class="ldock-state"><span class="ldock-kicker">Comparison readiness</span><span id="ldock-title" class="ldock-title">Blocked</span><span id="ldock-meta" class="ldock-meta">Select an execution host</span></div>
            <button id="ldock-launch-btn" class="ldock-button" type="button" disabled>Run comparison</button>
          </div>
        </div>

        <div id="live-sections" style="display:none;">
          <div id="batch-card" class="batch-card"><div id="bc-row" class="bc-row"></div><div id="bc-counters" class="bc-counters"></div></div>
          <div id="live-detail" class="live-detail"><div class="ld-header" id="ld-header"></div><div class="resp-grid" id="resp-grid"></div></div>
          <div id="model-arena" class="model-arena"><div class="r-sec-head arena-head"><span class="r-sec-icon">▶</span><span class="r-sec-title r-t-cyan">Live rankings</span><span id="arena-count" class="r-sec-count"></span></div><div id="arena-rows"></div></div>
          <div id="anomalies" class="anomalies" style="display:none;"><div class="an-header"><span class="an-icon">⚠</span><span class="an-title">Anomalies</span><span id="an-count" class="an-count"></span><a id="an-courthouse-link" href="/courthouse" class="an-link">Open all in Courthouse →</a></div><div id="an-list"></div></div>
          <div id="event-log" class="event-log"><div class="el-t">Event log</div><div id="ev-list"></div></div>
        </div>
      </div>
    </div>
  </details>
</main>
