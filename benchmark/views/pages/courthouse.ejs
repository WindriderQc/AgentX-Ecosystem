<main>
  <section id="the-bench" class="ch-bench"></section>

  <nav class="ch-tabs" role="tablist" aria-label="Courthouse sections">
    <button id="ch-tab-review" class="ch-tab is-active" data-tab="review" role="tab" aria-selected="true" aria-controls="ch-panel-review" tabindex="0">Review <span class="ch-tab-badge" id="ch-tab-review-badge"></span></button>
    <button id="ch-tab-calibration" class="ch-tab" data-tab="calibration" role="tab" aria-selected="false" aria-controls="ch-panel-calibration" tabindex="-1">Calibration</button>
    <button id="ch-tab-tests" class="ch-tab" data-tab="tests" role="tab" aria-selected="false" aria-controls="ch-panel-tests" tabindex="-1">Tests</button>
    <button id="ch-tab-ledger" class="ch-tab" data-tab="ledger" role="tab" aria-selected="false" aria-controls="ch-panel-ledger" tabindex="-1">Ledger</button>
    <button id="ch-tab-config" class="ch-tab" data-tab="config" role="tab" aria-selected="false" aria-controls="ch-panel-config" tabindex="-1">Config</button>
  </nav>

  <section id="ch-panel-review" class="ch-tab-panel is-active" data-panel="review" role="tabpanel" aria-labelledby="ch-tab-review" tabindex="0">
    <div id="review-queue"          class="r-section"></div>
    <div id="detail-panel-container"></div>
  </section>

  <section id="ch-panel-calibration" class="ch-tab-panel" data-panel="calibration" role="tabpanel" aria-labelledby="ch-tab-calibration" tabindex="0" hidden>
    <div id="calibration"           class="r-section"></div>
    <div id="gap-analysis"          class="r-section"></div>
    <div id="discrimination"        class="r-section"></div>
  </section>

  <section id="ch-panel-tests" class="ch-tab-panel" data-panel="tests" role="tabpanel" aria-labelledby="ch-tab-tests" tabindex="0" hidden>
    <div id="test-library"          class="r-section"></div>
  </section>

  <section id="ch-panel-ledger" class="ch-tab-panel" data-panel="ledger" role="tabpanel" aria-labelledby="ch-tab-ledger" tabindex="0" hidden>
    <p class="ch-tab-intro">Every scored result, in review context &mdash; pick a row to open its judgement and approve, override, or reject. For bulk filtering, export, or side-by-side compare, use the <a href="/results-explorer">Results Explorer <i class="fas fa-arrow-up-right-from-square" style="font-size:0.8em;"></i></a>.</p>
    <div id="results-ledger"        class="r-section"></div>
  </section>

  <section id="ch-panel-config" class="ch-tab-panel" data-panel="config" role="tabpanel" aria-labelledby="ch-tab-config" tabindex="0" hidden>
    <div id="judging-config"        class="r-section"></div>
    <div id="data-management"       class="r-section"></div>
  </section>

  <div id="judge-roster" hidden></div>
</main>
