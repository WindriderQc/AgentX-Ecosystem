<div class="container">
  <h1 class="page-title">Maintenance</h1>

  <%- include('../partials/workflow-map') %>

  <div class="panel-grid">

    <!-- Panel 1: Drift & Cleanup -->
    <div class="card">
      <div class="card-title">Drift &amp; Cleanup</div>

      <!-- Source input -->
      <div class="filter-bar">
        <label for="drift-source">Source</label>
        <input id="drift-source" class="input-field" type="text" placeholder="e.g., nas-docs">
        <button id="btn-check-manifest" class="btn btn-primary" type="button">Check</button>
      </div>

      <!-- Manifest summary -->
      <div id="manifest-summary" style="display:none;"></div>

      <!-- Check drift button -->
      <div id="drift-actions" style="display:none;">
        <button id="btn-check-drift" class="btn btn-secondary" type="button" style="margin-bottom:12px;">Check Drift</button>
      </div>

      <!-- Drift results -->
      <div id="drift-results"></div>

      <!-- Cleanup button -->
      <div id="cleanup-actions" style="display:none;">
        <button id="btn-cleanup" class="btn btn-danger" type="button">Clean Up Stale</button>
      </div>

      <!-- Cleanup result -->
      <div id="cleanup-result"></div>
    </div>

    <!-- Panel 2: Embedding Migration Status -->
    <div class="card">
      <div class="card-title">Embedding Migration Status</div>

      <div id="migration-status">
        <p class="loading">Loading migration status...</p>
      </div>

      <!-- Reindex button -->
      <div id="reindex-actions" style="display:none; margin-top:16px;">
        <button id="btn-reindex" class="btn btn-danger" type="button" disabled>Reindex All</button>
      </div>

      <!-- Reindex result -->
      <div id="reindex-result"></div>

      <div class="banner-info" style="margin-top:16px;">
        Changing the embedding model requires reindexing all documents. This can take significant time for large collections.
      </div>
    </div>

  </div>

  <dialog id="maintenance-confirm-dialog" class="delete-confirm-dialog" aria-labelledby="maintenance-confirm-title" aria-describedby="maintenance-confirm-description">
    <form id="maintenance-confirm-form" class="delete-confirm-form">
      <h2 id="maintenance-confirm-title">Confirm maintenance action</h2>
      <p id="maintenance-confirm-description"></p>
      <dl class="delete-confirm-context">
        <div><dt>Scope</dt><dd id="maintenance-confirm-scope"></dd></div>
      </dl>
      <label for="maintenance-confirm-input">Type <code id="maintenance-confirm-expected"></code> exactly to confirm.</label>
      <input id="maintenance-confirm-input" class="input-field" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="maintenance-confirm-error">
      <div id="maintenance-confirm-error" class="delete-confirm-error" role="status" aria-live="polite"></div>
      <div class="delete-confirm-actions">
        <button id="maintenance-confirm-cancel" class="btn btn-secondary" type="button">Cancel</button>
        <button id="maintenance-confirm-submit" class="btn btn-danger" type="submit" disabled>Confirm action</button>
      </div>
    </form>
  </dialog>

  <div class="footer">AgentX RAG Maintenance</div>
</div>
