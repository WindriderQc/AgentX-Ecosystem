<main class="container knowledge-shell">
  <header class="page-heading">
    <div>
      <div class="dashboard-eyebrow">Agent X Knowledge</div>
      <h1 class="page-title">Indexed documents</h1>
      <p>Inspect each indexed document and its passages. Source is the provenance label recorded when the document was ingested.</p>
    </div>
    <a class="btn btn-primary" href="/upload"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add knowledge</a>
  </header>

  <%- include('../partials/workflow-map') %>
  <%- include('../partials/empty-index-banner') %>

  <div class="doc-summary" aria-live="polite"><span><strong id="doc-count">--</strong> documents shown</span><span class="sep">·</span><span><strong id="chunk-count">--</strong> passages shown</span></div>
  <div id="documents-status" class="flow-status is-loading" role="status" aria-live="polite"><i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i><span><strong>Loading documents</strong><span class="flow-status-detail">Reading document identifiers, source provenance and passage counts.</span></span></div>

  <details class="filter-panel">
    <summary><i class="fa-solid fa-filter" aria-hidden="true"></i> Filter indexed documents</summary>
    <div class="filter-bar">
      <div class="control-group"><label for="filter-source">Source provenance</label><select id="filter-source" class="input-field"><option value="">All sources</option></select></div>
      <div class="control-group"><label for="filter-tags">Tags</label><input id="filter-tags" class="input-field" type="text" placeholder="tag1, tag2"></div>
      <button id="btn-apply" class="btn btn-primary" type="button">Apply filters</button>
      <button id="btn-clear" class="btn btn-secondary" type="button">Clear</button>
    </div>
  </details>

  <div id="doc-table-wrap" class="table-scroll">
    <table class="data-table" id="doc-table"><thead><tr><th>Document ID</th><th>Source provenance</th><th>Passages</th><th>Tags</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody id="doc-tbody"></tbody></table>
    <div id="empty-state" class="empty-state actionable-empty" hidden><i class="fa-solid fa-book-open" aria-hidden="true"></i><strong>No indexed documents found</strong><span>Add knowledge or clear the active filters.</span><a class="btn btn-primary" href="/upload">Add knowledge</a></div>
    <div id="context-not-found" class="empty-state actionable-empty" role="status" tabindex="-1" hidden>
      <i class="fa-solid fa-file-circle-question" aria-hidden="true"></i>
      <strong id="context-not-found-title">Source not found</strong>
      <span id="context-not-found-detail">The requested source is not in the active index.</span>
      <div class="context-recovery-actions">
        <a class="btn btn-primary" href="/documents">Browse all indexed documents</a>
        <a class="btn btn-secondary" href="/upload">Add knowledge</a>
      </div>
    </div>
    <div id="loading-state" class="loading">Loading documents…</div>
    <div id="error-state" class="error-state" role="alert" hidden></div>
  </div>

  <dialog id="delete-document-dialog" class="delete-confirm-dialog" aria-labelledby="delete-document-title" aria-describedby="delete-document-description">
    <form id="delete-document-form" class="delete-confirm-form">
      <h2 id="delete-document-title">Delete indexed document?</h2>
      <p id="delete-document-description">This permanently removes the document and all of its indexed passages. This cannot be undone.</p>
      <dl class="delete-confirm-context">
        <div><dt>Document ID</dt><dd><code id="delete-document-id"></code></dd></div>
        <div><dt>Source provenance</dt><dd id="delete-document-source"></dd></div>
      </dl>
      <label for="delete-document-input">Type <code id="delete-document-expected"></code> exactly to confirm.</label>
      <input id="delete-document-input" class="input-field" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="delete-document-error">
      <div id="delete-document-error" class="delete-confirm-error" role="status" aria-live="polite"></div>
      <div class="delete-confirm-actions">
        <button id="delete-document-cancel" class="btn btn-secondary" type="button">Cancel</button>
        <button id="delete-document-submit" class="btn btn-danger" type="submit" disabled>Delete document</button>
      </div>
    </form>
  </dialog>
</main>
