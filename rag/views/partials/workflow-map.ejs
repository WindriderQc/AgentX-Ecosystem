<%
  const currentStep = typeof ragWorkflowStep === 'string' ? ragWorkflowStep : 'dashboard';
  const workflowSteps = [
    {
      key: 'dashboard',
      href: '/',
      index: '1',
      title: 'Readiness',
      detail: 'Service, corpus, embeddings, query health'
    },
    {
      key: 'upload',
      href: '/upload',
      index: '2',
      title: 'Ingest',
      detail: 'Validate text, chunk, embed, index'
    },
    {
      key: 'search',
      href: '/search',
      index: '3',
      title: 'Retrieve',
      detail: 'Embed query, search chunks, inspect matches'
    },
    {
      key: 'documents',
      href: '/documents',
      index: '4',
      title: 'Corpus',
      detail: 'Filter documents and expand indexed chunks'
    },
    {
      key: 'maintenance',
      href: '/maintenance',
      index: '5',
      title: 'Maintain',
      detail: 'Reindex, snapshots, cleanup, migrations'
    }
  ];
%>
<section class="rag-workflow-map" aria-label="RAG workflow map" data-rag-workflow-map>
  <% workflowSteps.forEach((step) => { %>
    <a
      class="rag-flow-step <%= currentStep === step.key ? 'is-current' : '' %>"
      href="<%= step.href %>"
      aria-current="<%= currentStep === step.key ? 'page' : 'false' %>"
      data-rag-flow-step="<%= step.key %>"
    >
      <span class="rag-flow-index"><%= step.index %></span>
      <span class="rag-flow-copy">
        <strong><%= step.title %></strong>
        <span><%= step.detail %></span>
      </span>
    </a>
  <% }) %>
</section>
