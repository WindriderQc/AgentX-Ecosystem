#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

ENV_FILE="$ROOT/config/agentx.env"
COMPOSE=(--project-name agentx-ecosystem --env-file "$ENV_FILE" -f docker-compose.yml)
OLLAMA_COMPOSE=("${COMPOSE[@]}" -f docker-compose.ollama.yml)

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker was not found on PATH. Install Docker Engine or Docker Desktop, then reopen the terminal." >&2
    exit 3
  fi
  if ! docker compose version >/dev/null 2>&1; then
    echo "Docker Compose v2 is unavailable. Install or update the Docker Compose plugin." >&2
    exit 3
  fi
  compose_up_help="$(docker compose up --help 2>&1 || true)"
  if [[ "$compose_up_help" != *"--wait"* || "$compose_up_help" != *"--wait-timeout"* ]]; then
    echo "Docker Compose is too old for health-aware startup. Update Docker Desktop or the Compose v2 plugin." >&2
    exit 3
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "Docker is installed, but its engine is not reachable. Start Docker Engine or Docker Desktop and retry." >&2
    exit 3
  fi
}

ensure_benchmark_token() {
  if [[ -n "${AGENTX_BENCHMARK_TOKEN:-}" ]]; then
    return
  fi
  local container line current=""
  for container in agentx-ecosystem-core agentx-ecosystem-benchmark; do
    while IFS= read -r line; do
      if [[ "$line" == AGENTX_BENCHMARK_TOKEN=* ]]; then
        current="${line#AGENTX_BENCHMARK_TOKEN=}"
        break
      fi
    done < <(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$container" 2>/dev/null || true)
    if [[ -n "$current" ]]; then
      AGENTX_BENCHMARK_TOKEN="$current"
      export AGENTX_BENCHMARK_TOKEN
      return
    fi
  done
  if [[ ! -r /dev/urandom ]] || ! command -v od >/dev/null 2>&1 || ! command -v tr >/dev/null 2>&1; then
    echo "Cannot generate the ephemeral Benchmark service credential. Set AGENTX_BENCHMARK_TOKEN explicitly." >&2
    exit 3
  fi
  AGENTX_BENCHMARK_TOKEN="$(od -An -N32 -tx1 /dev/urandom | tr -d '[:space:]')"
  if [[ ${#AGENTX_BENCHMARK_TOKEN} -ne 64 ]]; then
    echo "Failed to generate the ephemeral Benchmark service credential." >&2
    exit 3
  fi
  export AGENTX_BENCHMARK_TOKEN
}

ensure_recovery_token() {
  if [[ -n "${AGENTX_RECOVERY_TOKEN:-}" ]]; then
    return
  fi
  local container line current=""
  for container in agentx-ecosystem-core agentx-ecosystem-rag; do
    while IFS= read -r line; do
      if [[ "$line" == AGENTX_RECOVERY_TOKEN=* ]]; then
        current="${line#AGENTX_RECOVERY_TOKEN=}"
        break
      fi
    done < <(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$container" 2>/dev/null || true)
    if [[ -n "$current" ]]; then
      AGENTX_RECOVERY_TOKEN="$current"
      export AGENTX_RECOVERY_TOKEN
      return
    fi
  done
  if [[ ! -r /dev/urandom ]] || ! command -v od >/dev/null 2>&1 || ! command -v tr >/dev/null 2>&1; then
    echo "Cannot generate the ephemeral recovery credential. Set AGENTX_RECOVERY_TOKEN explicitly." >&2
    exit 3
  fi
  AGENTX_RECOVERY_TOKEN="$(od -An -N32 -tx1 /dev/urandom | tr -d '[:space:]')"
  if [[ ${#AGENTX_RECOVERY_TOKEN} -ne 64 ]]; then
    echo "Failed to generate the ephemeral recovery credential." >&2
    exit 3
  fi
  export AGENTX_RECOVERY_TOKEN
}

show_product_health() {
  local failed=0
  local spec label container needs_health state runtime health display
  for spec in \
    "MongoDB|agentx-ecosystem-mongo|yes" \
    "Qdrant|agentx-ecosystem-qdrant|no" \
    "Core|agentx-ecosystem-core|yes" \
    "Benchmark|agentx-ecosystem-benchmark|yes" \
    "RAG|agentx-ecosystem-rag|yes"; do
    IFS='|' read -r label container needs_health <<<"$spec"
    state="$(docker inspect --format '{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$container" 2>/dev/null || true)"
    if [[ -z "$state" ]]; then
      echo "$label: not created"
      failed=1
      continue
    fi
    IFS='|' read -r runtime health <<<"$state"
    display="$runtime"
    [[ -n "$health" ]] && display="$runtime/$health"
    echo "$label: $display"
    if [[ "$runtime" != "running" || ("$needs_health" == "yes" && "$health" != "healthy") ]]; then
      failed=1
    fi
  done

  if [[ $failed -ne 0 ]]; then
    echo "Agent X is not healthy yet. Run './agentx status' and './agentx logs core' for details." >&2
    return 1
  fi
  echo "Product services are healthy. Ollama and models remain optional."
}

wait_published_product_endpoints() {
  local deadline=$((SECONDS + 30))
  local ready port
  local ports=("${CORE_PORT:-3180}" "${BENCHMARK_PORT:-3181}" "${RAG_PORT:-3182}")

  while (( SECONDS < deadline )); do
    ready=1
    for port in "${ports[@]}"; do
      if command -v curl >/dev/null 2>&1; then
        curl --fail --silent --max-time 2 "http://127.0.0.1:${port}/health" >/dev/null || ready=0
      else
        (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null || ready=0
      fi
    done
    if [[ $ready -eq 1 ]]; then
      return 0
    fi
    sleep 1
  done

  echo "Containers are healthy, but the loopback-published product endpoints did not become reachable within 30 seconds." >&2
  return 1
}

usage() {
  cat <<'EOF'
Agent X Ecosystem

Usage: ./agentx <command> [args...]

Commands:
  doctor                Check Docker CLI, Compose, and engine availability
  up                    Start the selected product profile (demo by default) and wait for health
  health                Verify the five required product containers
  down                  Stop product and Docker Ollama; preserve volumes
  status                Show product service status
  logs [service]        Follow logs; defaults to core
  rebuild [service]     Rebuild images, then start the requested services
  ollama-doctor         Detect native Ollama; never install or download
  ollama-up             Start the opt-in isolated Docker Ollama stack
  ollama-status         Show Docker Ollama status and installed models
  ollama-pull <model>   Explicitly download one model into its named volume
  ollama-down           Stop the Ollama-backed stack; preserve volumes
  reset                 Delete containers, data volumes, and recovery archives

Open http://127.0.0.1:3180/ after startup.
EOF
}

cmd="${1:-}"
shift || true

case "$cmd" in
  doctor)
    require_docker
    echo "Docker CLI, Compose, and engine are ready."
    ;;
  up)
    require_docker
    ensure_benchmark_token
    ensure_recovery_token
    if ! docker compose "${COMPOSE[@]}" up -d --wait --wait-timeout 180 "$@" mongo qdrant core benchmark rag; then
      echo "Startup did not become healthy within 180 seconds. Run './agentx status' and './agentx logs core'." >&2
      exit 1
    fi
    wait_published_product_endpoints || exit 1
    echo "Agent X started: http://127.0.0.1:${CORE_PORT:-3180}/"
    ;;
  health)
    require_docker
    show_product_health
    ;;
  down)
    require_docker
    docker compose "${OLLAMA_COMPOSE[@]}" --profile ollama down "$@"
    ;;
  status|ps)
    require_docker
    docker compose "${OLLAMA_COMPOSE[@]}" --profile ollama ps
    ;;
  logs)
    require_docker
    service="${1:-core}"
    docker compose "${OLLAMA_COMPOSE[@]}" --profile ollama logs -f --tail=200 "$service"
    ;;
  rebuild)
    require_docker
    ensure_benchmark_token
    ensure_recovery_token
    docker compose "${COMPOSE[@]}" build --no-cache "$@"
    docker compose "${COMPOSE[@]}" up -d "$@"
    ;;
  ollama-doctor)
    ollama_cli="$(command -v ollama 2>/dev/null || true)"
    if command -v curl >/dev/null 2>&1 && curl --fail --silent --max-time 3 http://127.0.0.1:11434/api/version >/dev/null; then
      echo "Native Ollama is healthy at http://127.0.0.1:11434."
      [[ -n "$ollama_cli" ]] && echo "CLI: $ollama_cli"
      exit 0
    fi
    if [[ -n "$ollama_cli" ]] && ollama list >/dev/null 2>&1; then
      echo "Native Ollama is healthy through its CLI."
      echo "CLI: $ollama_cli"
      exit 0
    fi
    if [[ -n "$ollama_cli" ]]; then
      echo "Ollama is installed at $ollama_cli, but its API is not responding."
      echo "Start its service or run 'ollama serve' in another terminal."
      exit 1
    fi
    echo "Ollama is not installed or not on PATH."
    echo "Review https://docs.ollama.com/linux; Agent X will not install it automatically."
    exit 1
    ;;
  ollama-up)
    require_docker
    ensure_benchmark_token
    ensure_recovery_token
    if ! docker compose "${OLLAMA_COMPOSE[@]}" --profile ollama up -d --wait --wait-timeout 180 "$@" ollama mongo qdrant core benchmark rag; then
      echo "The Docker Ollama stack did not become healthy within 180 seconds. Run './agentx status' and inspect logs." >&2
      exit 1
    fi
    wait_published_product_endpoints || exit 1
    echo "Agent X started with isolated Docker Ollama. No model was downloaded."
    ;;
  ollama-status)
    require_docker
    docker compose "${OLLAMA_COMPOSE[@]}" --profile ollama ps
    docker compose "${OLLAMA_COMPOSE[@]}" --profile ollama exec ollama ollama list
    ;;
  ollama-pull)
    if [[ $# -ne 1 ]]; then
      echo "Usage: ./agentx ollama-pull <model>" >&2
      exit 2
    fi
    require_docker
    docker compose "${OLLAMA_COMPOSE[@]}" --profile ollama exec ollama ollama pull "$1"
    ;;
  ollama-down)
    require_docker
    docker compose "${OLLAMA_COMPOSE[@]}" --profile ollama down "$@"
    ;;
  reset)
    require_docker
    echo "This deletes only agentx-ecosystem containers, network, named data volumes, and persistent recovery archives."
    read -r -p "Type 'delete agentx-ecosystem data and recovery archives' to continue: " confirm
    if [[ "$confirm" == "delete agentx-ecosystem data and recovery archives" ]]; then
      docker compose "${OLLAMA_COMPOSE[@]}" --profile ollama down --volumes
    else
      echo "Cancelled."
    fi
    ;;
  ''|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 2
    ;;
esac
