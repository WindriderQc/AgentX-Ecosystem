{
  "schemaVersion": 1,
  "classifications": {
    "action-observation": "A non-safe HTTP action used to compute, validate, search, refresh, or probe without an intended durable business-state mutation.",
    "user-mutation": "A user or operator action that creates or changes durable product state.",
    "destructive-mutation": "An action that deletes, resets, restores over, stops, cancels, prunes, or otherwise removes or replaces state.",
    "scoped-machine-call": "A machine-to-machine or worker lifecycle contract admitted only within its declared route and caller boundary."
  },
  "routeRoots": {
    "core": "core/routes",
    "benchmark": "benchmark/routes",
    "rag": "rag/routes"
  },
  "routeEntrypoints": {
    "core": [
      "core/src/app.js",
      "core/server.js"
    ],
    "benchmark": [
      "benchmark/server.js"
    ],
    "rag": [
      "rag/app.js",
      "rag/server.js"
    ]
  },
