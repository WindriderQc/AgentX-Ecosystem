{
  "schemaVersion": 1,
  "source": {
    "hostAuthority": "user-selected",
    "containerRoot": "/data/imports",
    "mountMode": "none"
  },
  "inventory": {
    "maxFiles": 1000,
    "includePathsInResponse": false,
    "readFileContents": false,
    "filesystemMutationAllowed": false
  },
  "ingestion": {
    "approvedRoots": [
      "/data/imports"
    ],
    "allowedExtensions": [
      "md",
      "txt"
    ],
    "maxFileSizeBytes": 1048576,
    "excludedTopLevel": {},
    "excludedDirectoryNames": [
      ".cache",
      ".git",
      ".venv",
      "__pycache__",
      "coverage",
      "credentials",
      "keys",
      "node_modules",
      "secrets",
      "ssh",
      "tokens"
    ],
    "secretBasenames": [
      ".env",
      "id_ed25519",
      "id_rsa"
    ],
    "secretExtensions": [
      "key",
      "p12",
      "pem",
      "pfx"
    ],
    "secretNameFragments": [
      "credential",
      "secret",
      "token"
    ],
    "generatedNameFragments": [
      "generated_",
      "export_"
    ]
  }
}
