# Secret-free Compose inputs. Shell variables may override these values.
AGENTX_OLLAMA_HOST=http://host.docker.internal:11434
# Optional exact HTTP(S) origins for first-time Benchmark setup on a
# nonstandard Ollama port. Comma-separated; never include paths or credentials.
AGENTX_OLLAMA_ALLOWED_TARGETS=
OLLAMA_HOST_NAME=Local Ollama
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DIMENSION=768
CORE_PORT=3180
BENCHMARK_PORT=3181
RAG_PORT=3182
# Optional comma-separated hostnames admitted for remote read/UI routing. This
# is not authentication: remote mutations still require an operator token (or
# a trusted proxy that supplies one). Leave empty for the loopback-only default.
AGENTX_OPERATOR_UI_HOSTS=
AGENTX_TRUSTED_UI_PROXY_ADDRESSES=
